<% content_for :title, "AI 自动话题 - 管理控制台" %>

<h4 class="text-dark fw-bold mb-4">
  <i class="bi bi-cpu me-2 text-primary"></i>AI <%= t('admin.ui.m652') %>
</h4>

<!-- 今日统计 -->
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card card-admin">
      <div class="card-body d-flex align-items-center">
        <div class="stat-icon bg-primary bg-opacity-10 text-primary me-3">
          <i class="bi bi-calendar-day"></i>
        </div>
        <div>
          <div class="text-muted small"><%= t('admin.ui.m206') %></div>
          <div class="fs-5 fw-bold"><%= @today_tasks.count %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card card-admin">
      <div class="card-body d-flex align-items-center">
        <div class="stat-icon bg-warning bg-opacity-10 text-warning me-3">
          <i class="bi bi-hourglass-split"></i>
        </div>
        <div>
          <div class="text-muted small"><%= t('admin.ui.m205') %></div>
          <div class="fs-5 fw-bold"><%= @today_stats[:pending] + @today_stats[:processing] %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card card-admin">
      <div class="card-body d-flex align-items-center">
        <div class="stat-icon bg-success bg-opacity-10 text-success me-3">
          <i class="bi bi-check-circle"></i>
        </div>
        <div>
          <div class="text-muted small"><%= t('admin.completed') %></div>
          <div class="fs-5 fw-bold"><%= @today_stats[:completed] %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card card-admin">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <div class="text-muted small"><%= t('admin.actions') %></div>
        </div>
        <div class="d-flex gap-2">
          <%= button_to admin_auto_topics_trigger_now_path, method: :post, class: "btn btn-primary rounded-pill px-3", form: { data: { turbo_confirm: t('admin.ui.m204') } } do %>
            <i class="bi bi-lightning me-1"></i><%= t('admin.ui.m203') %>
          <% end %>
          <%= button_to admin_auto_topics_dispatch_pending_path, method: :post, class: "btn btn-outline-warning rounded-pill px-3", form: { data: { turbo_confirm: t('admin.ui.m202') } } do %>
            <i class="bi bi-arrow-repeat me-1"></i><%= t('admin.ui.m201') %>
          <% end %>
          <%= link_to admin_settings_path(anchor: "auto-topic-settings"), class: "btn btn-outline-secondary rounded-pill px-3" do %>
            <i class="bi bi-gear me-1"></i><%= t('admin.ui.m200') %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 近7<%= t('admin.ui.m003') %>趋势 -->
<div class="card card-admin mb-4">
  <div class="card-header py-3">
    <h6 class="mb-0 fw-semibold"><i class="bi bi-bar-chart me-2 text-info"></i><%= t('admin.ui.m199') %></h6>
  </div>
  <div class="card-body">
    <div class="d-flex align-items-end gap-2" style="height: 120px;">
      <% max_total = @history_stats.map { |h| h[:total] }.max || 1 %>
      <% @history_stats.each do |stat| %>
        <div class="flex-fill d-flex flex-column align-items-center" style="height: 100%;">
          <div class="w-100 d-flex flex-column align-items-stretch justify-content-end" style="flex:1">
            <% if stat[:completed] > 0 %>
              <div class="bg-success bg-opacity-75 rounded-top" style="height: <%= (stat[:completed].to_f / max_total * 100).ceil %>%; min-height: 2px;" title="<%= t('admin.ui.m198') %> <%= stat[:completed] %>"></div>
            <% end %>
            <% if stat[:failed] > 0 %>
              <div class="bg-danger bg-opacity-75 rounded-top" style="height: <%= (stat[:failed].to_f / max_total * 100).ceil %>%; min-height: 2px;" title="<%= t('admin.ui.m197') %> <%= stat[:failed] %>"></div>
            <% end %>
          </div>
          <div class="text-muted mt-1" style="font-size: 0.7rem;">
            <%= stat[:date] == Date.current ? t('admin.ui.m196') : stat[:date].strftime("%m/%d") %>
          </div>
          <div class="text-muted" style="font-size: 0.65rem;"><%= stat[:total] %></div>
        </div>
      <% end %>
    </div>
    <div class="d-flex gap-3 mt-2">
      <span class="d-flex align-items-center gap-1"><span class="d-inline-block bg-success bg-opacity-75 rounded" style="width:12px;height:12px;"></span><small class="text-muted"><%= t('admin.ui.m018') %></small></span>
      <span class="d-flex align-items-center gap-1"><span class="d-inline-block bg-danger bg-opacity-75 rounded" style="width:12px;height:12px;"></span><small class="text-muted"><%= t('admin.failed') %></small></span>
    </div>
  </div>
</div>

<!-- <%= t('admin.ui.m195') %><%= t('admin.ui.m265') %> -->
<% if @today_tasks.any? %>
<div class="card card-admin mb-4">
  <div class="card-header py-3">
    <span class="fw-semibold"><i class="bi bi-list-check me-2 text-warning"></i><%= t('admin.ui.m195') %></span>
    <span class="badge bg-secondary bg-opacity-10 text-secondary ms-2" style="font-size:0.7rem"><%= @today_tasks.count %> <%= t('admin.ui.m015') %></span>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th><%= t('admin.ui.m014') %></th>
          <th><%= t('admin.title') %></th>
          <th><%= t('admin.ui.m226') %></th>
          <th><%= t('admin.status') %></th>
          <th style="width:80px"><%= t('admin.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% @today_tasks.each do |task| %>
          <tr>
            <td class="text-muted small"><%= task.scheduled_at.strftime("%H:%M") %></td>
            <td>
              <% if task.topic_title.present? %>
                <span class="fw-medium text-dark"><%= task.topic_title.truncate(40) %></span>
              <% else %>
                <span class="text-muted"><%= t('admin.ui.m032') %></span>
              <% end %>
            </td>
            <td>
              <% if task.action == "publish" %>
                <span class="badge bg-success bg-opacity-10 text-success" style="font-size:0.75rem"><i class="bi bi-send me-1"></i><%= t('admin.ui.m225') %></span>
              <% else %>
                <span class="badge bg-warning bg-opacity-10 text-warning" style="font-size:0.75rem"><i class="bi bi-file-earmark me-1"></i><%= t('admin.ui.m224') %></span>
              <% end %>
            </td>
            <td>
              <% case task.status %>
              <% when "pending" %>
                <span class="text-muted"><i class="bi bi-hourglass me-1"></i><%= t('admin.waiting') %></span>
              <% when "processing" %>
                <span class="text-primary"><i class="bi bi-arrow-repeat spin me-1"></i><%= t('admin.running') %></span>
              <% when "completed" %>
                <span class="text-success"><i class="bi bi-check-circle me-1"></i><%= t('admin.completed') %></span>
                <% if task.topic_id %>
                  <%= link_to topic_path(task.topic), target: "_blank", class: "ms-1 text-decoration-none" do %>
                    <i class="bi bi-box-arrow-up-right text-muted"></i>
                  <% end %>
                <% end %>
              <% when "failed" %>
                <span class="text-danger" title="<%= task.error_message %>">
                  <i class="bi bi-exclamation-triangle me-1"></i><%= t('admin.ui.m194') %>
                </span>
              <% end %>
            </td>
            <td>
              <% if task.failed? %>
                <%= button_to admin_auto_topics_retry_task_path(task), method: :post, class: "btn btn-sm btn-outline-primary btn-action", title: t("admin.retry") do %>
                  <i class="bi bi-arrow-clockwise"></i>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<% else %>
<div class="card card-admin mb-4">
  <div class="card-body text-center py-5">
    <i class="bi bi-robot" style="font-size: 2rem;" class="text-muted"></i>
    <div class="text-muted mt-2"><%= t('admin.ui.m653') %></div>
    <div class="text-muted small mt-1"><%= t('admin.ui.m192') %> <a href="<%= admin_settings_path(anchor: 'auto-topic-settings') %>"><%= t('admin.ui.m191') %></a> <%= t('admin.ui.m654') %></div>
  </div>
</div>
<% end %>

<!-- <%= t('admin.ui.m189') %> -->
<div class="card card-admin">
  <div class="card-header py-3">
    <span class="fw-semibold"><i class="bi bi-clock-history me-2 text-secondary"></i><%= t('admin.ui.m189') %></span>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th><%= t('admin.ui.m167') %></th>
          <th><%= t('admin.ui.m014') %></th>
          <th><%= t('admin.title') %></th>
          <th><%= t('admin.ui.m226') %></th>
          <th><%= t('admin.status') %></th>
          <th style="width:80px"><%= t('admin.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% if @all_tasks.any? %>
          <% @all_tasks.each do |task| %>
            <tr>
              <td class="text-muted small"><%= task.scheduled_date.strftime("%m-%d") %></td>
              <td class="text-muted small"><%= task.scheduled_at.strftime("%H:%M") %></td>
              <td>
                <% if task.topic_title.present? %>
                  <span class="fw-medium text-dark"><%= task.topic_title.truncate(40) %></span>
                <% else %>
                  <span class="text-muted">-</span>
                <% end %>
              </td>
              <td>
                <% if task.action == "publish" %>
                  <span class="badge bg-success bg-opacity-10 text-success" style="font-size:0.75rem"><%= t('admin.ui.m225') %></span>
                <% else %>
                  <span class="badge bg-warning bg-opacity-10 text-warning" style="font-size:0.75rem"><%= t('admin.ui.m224') %></span>
                <% end %>
              </td>
              <td>
                <% case task.status %>
                <% when "pending" %>
                  <span class="text-muted"><i class="bi bi-hourglass me-1"></i><%= t('admin.waiting') %></span>
                <% when "processing" %>
                  <span class="text-primary"><i class="bi bi-arrow-repeat spin me-1"></i><%= t('admin.running') %></span>
                <% when "completed" %>
                  <span class="text-success"><i class="bi bi-check-circle me-1"></i><%= t('admin.ui.m018') %></span>
                <% when "failed" %>
                  <span class="text-danger" title="<%= task.error_message %>"><i class="bi bi-exclamation-triangle me-1"></i><%= t('admin.failed') %></span>
                <% end %>
              </td>
              <td>
                <% if task.completed? && task.topic_id %>
                  <%= link_to topic_path(task.topic), target: "_blank", class: "btn btn-sm btn-outline-secondary btn-action", title: t("admin.view") do %>
                    <i class="bi bi-box-arrow-up-right"></i>
                  <% end %>
                <% elsif task.completed? && task.draft_id %>
                  <%= link_to admin_topic_operations_path, class: "btn btn-sm btn-outline-secondary btn-action", title: t('admin.ui.m655') do %>
                    <i class="bi bi-arrow-right"></i>
                  <% end %>
                <% elsif task.failed? %>
                  <%= button_to admin_auto_topics_retry_task_path(task), method: :post, class: "btn btn-sm btn-outline-primary btn-action", title: t("admin.retry") do %>
                    <i class="bi bi-arrow-clockwise"></i>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="text-center text-muted py-4"><%= t('admin.ui.m228') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<!-- 分页 -->
<% if @pagy.pages > 1 %>
  <div class="mt-3 d-flex justify-content-center">
    <%== @pagy.series_nav(:bootstrap) %>
  </div>
<% end %>
