<h4 class="text-dark fw-bold mb-4"><%= t('admin.ui.m656') %></h4>

<div class="card card-admin" style="max-width:640px">
  <div class="card-body p-4">
    <%= form_with model: [:admin, @chat_group], local: true do |f| %>
      <% if @chat_group.errors.any? %>
        <div class="alert alert-danger rounded-3 py-2">
          <i class="bi bi-exclamation-circle me-1"></i>
          <ul class="mb-0 ms-3">
            <% @chat_group.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :name, t('admin.ui.m219'), class: "form-label fw-semibold small text-muted" %>
        <%= f.text_field :name, class: "form-control form-control-lg rounded-3", placeholder: t('admin.ui.m218') %>
      </div>

      <div class="mb-3">
        <%= f.label :category, t("admin.category"), class: "form-label fw-semibold small text-muted" %>
        <%= f.select :category, ChatGroup::CATEGORIES.map { |k, v| [v, k] }, { prompt: t("admin.select_category") }, class: "form-select form-select-lg rounded-3" %>
      </div>

      <div class="mb-3">
        <%= f.label :members_count, t('admin.ui.m217'), class: "form-label fw-semibold small text-muted" %>
        <%= f.number_field :members_count, class: "form-control form-control-lg rounded-3", placeholder: t('admin.ui.m216'), min: 0 %>
        <div class="form-text"><%= t('admin.ui.m215') %></div>
      </div>

      <div class="mb-3">
        <%= f.label :logo, t('admin.ui.m214'), class: "form-label fw-semibold small text-muted" %>
        <% if @chat_group.logo.attached? %>
          <div class="d-flex align-items-center gap-3 mb-2">
            <div class="rounded-2 overflow-hidden" style="width:64px;height:64px">
              <img src="<%= url_for(@chat_group.logo.variant(resize_to_fill: [128, 128])) %>" class="w-100 h-100" style="object-fit:cover" alt="">
            </div>
            <label class="form-check">
              <input type="checkbox" name="chat_group[remove_logo]" value="1" class="form-check-input">
              <span class="form-check-label" style="font-size:0.85rem"><%= t('admin.ui.m657') %></span>
            </label>
          </div>
        <% end %>
        <%= f.file_field :logo, class: "form-control form-control-lg rounded-3", accept: "image/*" %>
        <div class="form-text"><%= t('admin.ui.m212') %></div>
      </div>

      <div class="mb-3">
        <%= f.label :description, t('admin.ui.m211'), class: "form-label fw-semibold small text-muted" %>
        <%= f.text_area :description, class: "form-control rounded-3", rows: 3, placeholder: t('admin.ui.m210') %>
        <div class="form-text"><%= t('admin.max_500_chars') %></div>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <%= f.label :sort_order, t("admin.sort_order"), class: "form-label fw-semibold small text-muted" %>
          <%= f.number_field :sort_order, class: "form-control form-control-lg rounded-3", min: 0 %>
          <div class="form-text"><%= t('admin.lower_is_first') %></div>
        </div>
        <div class="col-md-6">
          <%= f.label :is_active, t("admin.status"), class: "form-label fw-semibold small text-muted" %>
          <div class="form-check form-switch mt-2">
            <%= f.check_box :is_active, class: "form-check-input", style: "width:2.5em;height:1.5em" %>
            <label class="form-check-label" for="chat_group_is_active"><%= t('admin.show_on_frontend') %></label>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit t("admin.save_changes"), class: "btn btn-primary rounded-pill px-4" %>
        <%= link_to t("admin.cancel"), admin_chat_groups_path, class: "btn btn-outline-secondary rounded-pill px-4" %>
      </div>
    <% end %>
  </div>
</div>
