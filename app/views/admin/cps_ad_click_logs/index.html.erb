<h4 class="mb-4 text-dark fw-bold">CPS <%= t('admin.ui.m615') %></h4>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body d-flex align-items-center">
        <div class="stat-icon bg-primary bg-opacity-10 text-primary me-3">
          <i class="bi bi-cursor-fill"></i>
        </div>
        <div>
          <div class="text-muted small"><%= t('admin.ui.m616') %></div>
          <div class="fs-4 fw-bold mb-0"><%= @total_clicks %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body d-flex align-items-center">
        <div class="stat-icon bg-success bg-opacity-10 text-success me-3">
          <i class="bi bi-calendar-day"></i>
        </div>
        <div>
          <div class="text-muted small"><%= t('admin.ui.m617') %></div>
          <div class="fs-4 fw-bold mb-0"><%= @today_clicks %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body d-flex align-items-center">
        <div class="stat-icon bg-info bg-opacity-10 text-info me-3">
          <i class="bi bi-megaphone-fill"></i>
        </div>
        <div>
          <div class="text-muted small"><%= t('admin.ui.m618') %></div>
          <div class="fs-4 fw-bold mb-0"><%= CpsAd.count %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body d-flex align-items-center">
        <div class="stat-icon bg-warning bg-opacity-10 text-warning me-3">
          <i class="bi bi-check-circle-fill"></i>
        </div>
        <div>
          <div class="text-muted small"><%= t('admin.ui.m567') %></div>
          <div class="fs-4 fw-bold mb-0"><%= CpsAd.active.count %></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card card-admin">
  <div class="card-header d-flex justify-content-between align-items-center py-3">
    <h6 class="mb-0 fw-bold"><i class="bi bi-list-ul me-2 text-info"></i><%= t('admin.ui.m568') %></h6>
    <div class="d-flex align-items-center gap-2">
      <select id="cpsAdFilter" class="form-select form-select-sm" style="width:auto;min-width:180px">
        <option value=""><%= t('admin.ui.m569') %></option>
        <% @cps_ads.each do |ad| %>
          <option value="<%= ad.id %>" <%= "selected" if @selected_ad_id == ad.id.to_s %>><%= ad.title %></option>
        <% end %>
      </select>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th class="ps-3"><%= t('admin.ad') %></th>
            <th><%= t('admin.user') %></th>
            <th>IP<%= t('admin.ui.m012') %></th>
            <th><%= t('admin.location') %></th>
            <th>ISP</th>
            <th><%= t('admin.browser') %></th>
            <th><%= t('admin.os') %></th>
            <th class="pe-3 text-end"><%= t('admin.ui.m570') %></th>
          </tr>
        </thead>
        <tbody>
          <% @click_logs.each do |log| %>
            <tr>
              <td class="ps-3">
                <span class="badge bg-light text-dark"><%= log.cps_ad.title %></span>
              </td>
              <td>
                <div class="d-flex align-items-center">
                  <div class="rounded-3 <%= log.user_id ? 'bg-info bg-opacity-10 text-info' : 'bg-secondary bg-opacity-10 text-secondary' %> d-flex align-items-center justify-content-center me-2" style="width:28px;height:28px;font-size:0.75rem">
                    <i class="bi bi-<%= log.user_id ? 'person-fill' : 'incognito' %>"></i>
                  </div>
                  <span><%= log.user_display_name %></span>
                </div>
              </td>
              <td><code class="small"><%= log.ip_address %></code></td>
              <td><small class="text-muted"><%= log.location_text.presence || "-" %></small></td>
              <td><small class="text-muted"><%= log.isp.presence || "-" %></small></td>
              <td><small class="text-muted"><%= log.browser.presence || "-" %></small></td>
              <td><small class="text-muted"><%= log.os.presence || "-" %></small></td>
              <td class="pe-3 text-end text-muted">
                <small><%= log.created_at.strftime("%Y-%m-%d %H:%M") %></small>
              </td>
            </tr>
          <% end %>
          <% if @click_logs.empty? %>
            <tr><td colspan="8" class="text-center text-muted py-4"><%= t('admin.ui.m571') %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% if @pagy.pages > 1 %>
  <div class="card-footer py-2 d-flex justify-content-center" style="border-radius:0 0 12px 12px">
    <%== @pagy.series_nav(:bootstrap) %>
  </div>
  <% end %>
</div>

<script>
document.getElementById('cpsAdFilter').addEventListener('change', function() {
  var val = this.value;
  var url = new URL(window.location);
  if (val) {
    url.searchParams.set('cps_ad_id', val);
  } else {
    url.searchParams.delete('cps_ad_id');
  }
  window.location = url.toString();
});
</script>
