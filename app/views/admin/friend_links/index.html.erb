<h4 class="mb-4 text-dark fw-bold"><%= t('admin.ui.m858') %></h4>

<div class="row g-4">
  <div class="col-lg-8">
    <!-- 友链<%= t('admin.ui.m732') %> -->
    <div class="card card-admin mb-4">
      <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="bi bi-link-45deg me-2 text-primary"></i>友链<%= t('admin.ui.m732') %></h6>
        <span class="badge bg-primary"><%= @friend_links.size %> <%= t('admin.ui.m830') %></span>
      </div>
      <div class="card-body p-0">
        <% if @friend_links.any? %>
          <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th style="width:5%"><%= t('admin.sort_order') %></th>
                <th style="width:20%"><%= t('admin.name') %></th>
                <th style="width:25%">URL</th>
                <th><%= t('admin.description') %></th>
                <th style="width:8%"><%= t('admin.status') %></th>
                <th style="width:10%"><%= t('admin.actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% @friend_links.each do |link| %>
                <tr id="friend_link_<%= link.id %>">
                  <td class="text-muted small"><%= link.sort_order %></td>
                  <td>
                    <div class="d-flex align-items-center">
                      <% if link.logo.present? %>
                        <img src="<%= link.logo %>" alt="" style="width:24px;height:24px;border-radius:4px;object-fit:cover;margin-right:8px;">
                      <% end %>
                      <span class="fw-semibold"><%= link.name %></span>
                    </div>
                  </td>
                  <td>
                    <a href="<%= link.url %>" target="_blank" class="text-truncate d-block" style="max-width:200px;font-size:0.85rem"><%= link.url %></a>
                  </td>
                  <td class="text-muted small"><%= truncate(link.description, length: 40) if link.description.present? %></td>
                  <td>
                    <% if link.is_active? %>
                      <span class="badge bg-success-subtle text-success"><%= t('admin.enable') %></span>
                    <% else %>
                      <span class="badge bg-secondary-subtle text-secondary"><%= t('admin.disable') %></span>
                    <% end %>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <button type="button" class="btn btn-sm btn-outline-primary btn-action" data-bs-toggle="modal" data-bs-target="#editModal_<%= link.id %>" title="<%= t('admin.edit') %>">
                        <i class="bi bi-pencil"></i>
                      </button>
                      <%= button_to admin_friend_link_path(link), method: :delete, class: "btn btn-sm btn-outline-danger btn-action", title: t("admin.delete"), data: { turbo_confirm: "确定删除「#{link.name}」？" } do %>
                        <i class="bi bi-trash"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          </div>
        <% else %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-link-45deg d-block fs-1 mb-2"></i>
            <p><%= t('admin.ui.m831') %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <!-- <%= t('admin.ui.m834') %> -->
    <div class="card card-admin mb-4">
      <div class="card-header py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2 text-success"></i><%= t('admin.add_friend_link') %></h6>
      </div>
      <div class="card-body">
        <%= form_with model: [:admin, FriendLink.new], url: admin_friend_links_path, class: "needs-validation" do |f| %>
          <div class="mb-3">
            <%= f.label :name, t("admin.site_name"), class: "form-label fw-semibold small" %>
            <%= f.text_field :name, class: "form-control form-control-sm", placeholder: t('admin.ui.m832'), required: true %>
          </div>
          <div class="mb-3">
            <%= f.label :url, t("admin.site_url"), class: "form-label fw-semibold small" %>
            <%= f.url_field :url, class: "form-control form-control-sm", placeholder: "https://example.com", required: true %>
          </div>
          <div class="mb-3">
            <%= f.label :description, t("admin.site_description"), class: "form-label fw-semibold small" %>
            <%= f.text_field :description, class: "form-control form-control-sm", placeholder: t('admin.ui.m833') %>
          </div>
          <div class="mb-3">
            <%= f.label :logo, "Logo 地址", class: "form-label fw-semibold small" %>
            <%= f.url_field :logo, class: "form-control form-control-sm", placeholder: "https://example.com/logo.png（可选）" %>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-6">
              <%= f.label :sort_order, t("admin.sort_order"), class: "form-label fw-semibold small" %>
              <%= f.number_field :sort_order, class: "form-control form-control-sm", value: 0, min: 0 %>
            </div>
            <div class="col-6">
              <%= f.label :is_active, t("admin.status"), class: "form-label fw-semibold small" %>
              <select name="friend_link[is_active]" class="form-select form-select-sm">
                <option value="true" selected><%= t('admin.enable') %></option>
                <option value="false"><%= t('admin.disable') %></option>
              </select>
            </div>
          </div>
          <button type="submit" class="btn btn-primary rounded-pill w-100">
            <i class="bi bi-plus-lg me-1"></i><%= t('admin.ui.m834') %>
          </button>
        <% end %>
      </div>
    </div>

    <!-- 页脚文字配置 -->
    <div class="card card-admin mb-4">
      <div class="card-header py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-type me-2 text-info"></i><%= t('admin.footer_text') %></h6>
      </div>
      <div class="card-body">
        <%= form_with url: settings_admin_friend_links_path, method: :patch, class: "needs-validation" do |f| %>
          <p class="text-muted small mb-3"><%= t('admin.ui.m835') %></p>
          <div class="mb-3">
            <%= label_tag :footer_text, t("admin.footer_text"), class: "form-label fw-semibold small" %>
            <%= text_area_tag :footer_text, SiteSetting.get("footer_text"), class: "form-control form-control-sm", rows: 2, placeholder: "例如：AiBBS 社区 © 2026" %>
            <div class="form-text"><%= t('admin.ui.m837') %> &lt;a&gt; <%= t('admin.ui.m838') %></div>
          </div>
          <div class="mb-3">
            <%= label_tag :friend_links_enabled, t('admin.ui.m839'), class: "form-label fw-semibold small" %>
            <select name="friend_links_enabled" class="form-select form-select-sm">
              <option value="true" <%= "selected" if SiteSetting.get("friend_links_enabled") != "false" %>><%= t('admin.show') %></option>
              <option value="false" <%= "selected" if SiteSetting.get("friend_links_enabled") == "false" %>><%= t('admin.hide') %></option>
            </select>
          </div>
          <button type="submit" class="btn btn-info text-white rounded-pill w-100">
            <i class="bi bi-check-lg me-1"></i><%= t('admin.ui.m840') %>
          </button>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- <%= t('admin.ui.m008') %>弹窗 -->
<% @friend_links.each do |link| %>
  <div class="modal fade" id="editModal_<%= link.id %>" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title fw-bold"><%= t('admin.ui.m841') %></h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <%= form_with model: [:admin, link], url: admin_friend_link_path(link), method: :patch do |f| %>
            <div class="mb-3">
              <%= f.label :name, t("admin.site_name"), class: "form-label fw-semibold small" %>
              <%= f.text_field :name, class: "form-control form-control-sm", required: true %>
            </div>
            <div class="mb-3">
              <%= f.label :url, t("admin.site_url"), class: "form-label fw-semibold small" %>
              <%= f.url_field :url, class: "form-control form-control-sm", required: true %>
            </div>
            <div class="mb-3">
              <%= f.label :description, t("admin.site_description"), class: "form-label fw-semibold small" %>
              <%= f.text_field :description, class: "form-control form-control-sm" %>
            </div>
            <div class="mb-3">
              <%= f.label :logo, "Logo 地址", class: "form-label fw-semibold small" %>
              <%= f.url_field :logo, class: "form-control form-control-sm" %>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-6">
                <%= f.label :sort_order, t("admin.sort_order"), class: "form-label fw-semibold small" %>
                <%= f.number_field :sort_order, class: "form-control form-control-sm", min: 0 %>
              </div>
              <div class="col-6">
                <%= f.label :is_active, t("admin.status"), class: "form-label fw-semibold small" %>
                <select name="friend_link[is_active]" class="form-select form-select-sm">
                  <option value="true" <%= "selected" if link.is_active? %>><%= t('admin.enable') %></option>
                  <option value="false" <%= "selected" unless link.is_active? %>><%= t('admin.disable') %></option>
                </select>
              </div>
            </div>
            <div class="d-flex justify-content-end gap-2">
              <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal"><%= t('admin.cancel') %></button>
              <button type="submit" class="btn btn-primary rounded-pill">
                <i class="bi bi-check-lg me-1"></i><%= t('admin.ui.m002') %>
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
