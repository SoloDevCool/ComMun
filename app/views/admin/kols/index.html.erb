                  <button type="button" class="btn btn-outline-success btn-sm rounded-pill" onclick="addPlatformField('platformFields_<%= kol.id %>','<%= t('admin.ui.m021') %>')"><%= t('admin.ui.m021') %></button>
                  <button type="button" class="btn btn-outline-success btn-sm rounded-pill" onclick="addPlatformField('platformFields_<%= kol.id %>','<%= t('admin.ui.m020') %>')"><%= t('admin.ui.m020') %></button>
                  <button type="button" class="btn btn-outline-success btn-sm rounded-pill" onclick="addPlatformField('platformFields_<%= kol.id %>','<%= t('admin.ui.m017') %>')"><%= t('admin.ui.m017') %></button>
                  <button type="button" class="btn btn-outline-success btn-sm rounded-pill" onclick="addPlatformField('platformFields_<%= kol.id %>','<%= t('admin.ui.m019') %>')"><%= t('admin.ui.m019') %></button>
