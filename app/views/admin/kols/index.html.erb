              </div>
              <div class="col-6">
                <%= f.label :is_active, t("admin.status"), class: "form-label fw-semibold small" %>
                <select name="kol[is_active]" class="form-select form-select-sm">
                  <option value="true" <%= "selected" if kol.is_active? %>><%= t('admin.enable') %></option>
                  <option value="false" <%= "selected" unless kol.is_active? %>><%= t('admin.disable') %></option>
                </select>
              </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
              <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal"><%= t('admin.cancel') %></button>
              <button type="submit" class="btn btn-primary rounded-pill">
                <i class="bi bi-check-lg me-1"></i><%= t('admin.ui.m002') %>
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<script>
// Excel Import
document.getElementById('importSubmitBtn').addEventListener('click', function() {
  var fileInput = document.getElementById('importFile');
  if (!fileInput.files.length) {
    alert('<%= t('admin.ui.m824') %>');
    return;
  }
  var formData = new FormData();
  formData.append('file', fileInput.files[0]);
  var token = document.querySelector('meta[name="csrf-token"]');
  if (token) formData.append('authenticity_token', token.getAttribute('content'));

  var btn = this;
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span><%= t('admin.ui.m825') %>';

  fetch('<%= import_admin_kols_path %>', { method: 'POST', body: formData, redirect: 'manual' })
    .then(function(response) {
      window.location.href = response.headers.get('Location') || '<%= admin_kols_path %>';
    })
    .catch(function() {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-upload me-1"></i><%= t('admin.ui.m234') %>';
      alert('<%= t('admin.ui.m826') %>');
    });
});

// Bio character count
document.addEventListener('input', function(e) {
  if (e.target.dataset.bioCount) {
    var counter = e.target.closest('.mb-3, .col-12').querySelector('.bio-count');
    if (counter) counter.textContent = e.target.value.length;
  }
});

function addPlatformField(containerId, presetName) {
  var container = document.getElementById(containerId);
  var idx = container.dataset.nextIdx || 0;
  var row = document.createElement('div');
  row.className = 'd-flex gap-1 mb-1 align-items-center';
  row.innerHTML =
    '<input type="text" name="kol[platforms_attributes][' + idx + '][name]" value="' + (presetName || '') + '" placeholder="<%= t('admin.ui.m827') %>" class="form-control form-control-sm" style="max-width:120px">' +
    '<input type="url" name="kol[platforms_attributes][' + idx + '][url]" placeholder="<%= t('admin.ui.m828') %>" class="form-control form-control-sm">' +
    '<button type="button" class="btn btn-outline-danger btn-sm flex-shrink-0" onclick="this.parentElement.remove()" title="<%= t('admin.remove') %>"><i class="bi bi-x"></i></button>';
  container.appendChild(row);
  container.dataset.nextIdx = parseInt(idx) + 1;
}

// Pre-fill platform data for each edit modal, only once
<% @kols.each do |kol| %>
  var kolPlatforms_<%= kol.id %> = <%= raw kol.platforms_list.to_json %>;
  var kolInited_<%= kol.id %> = false;
  document.getElementById('editModal_<%= kol.id %>').addEventListener('shown.bs.modal', function() {
    if (kolInited_<%= kol.id %>) return;
    kolInited_<%= kol.id %> = true;
    var container = document.getElementById('platformFields_<%= kol.id %>');
    kolPlatforms_<%= kol.id %>.forEach(function(p) {
      addPlatformField('platformFields_<%= kol.id %>', '');
      var fields = container.querySelectorAll(':scope > div:last-child input');
      if (fields.length >= 2) {
        fields[0].value = p.name || '';
        fields[1].value = p.url || '';
      }
    });
  });
<% end %>

// KOL Invitation - Tab
function toggleAllKols(btn) {
  var checkboxes = document.querySelectorAll('.kol-checkbox');
  var allChecked = Array.from(checkboxes).every(function(cb) { return cb.checked; });
  checkboxes.forEach(function(cb) { cb.checked = !allChecked; });
  updateSelectedCount();
}

function updateSelectedCount() {
  var checked = document.querySelectorAll('.kol-checkbox:checked');
  document.getElementById('selectedCount').textContent = checked.length;
}

function setInviteTab(tab) {
  var textarea = document.getElementById('inviteBody');
  var preview = document.getElementById('invitePreview');
  var btnEdit = document.getElementById('btnEdit');
  var btnPreview = document.getElementById('btnPreview');
  if (tab === 'edit') {
    textarea.classList.remove('d-none');
    preview.classList.add('d-none');
    btnEdit.className = 'btn btn-sm btn-primary rounded-pill';
    btnPreview.className = 'btn btn-sm btn-outline-primary rounded-pill';
  } else {
    textarea.classList.add('d-none');
    preview.classList.remove('d-none');
    preview.innerHTML = textarea.value || '<span class="text-muted"><%= t('admin.no_content') %></span>';
    btnEdit.className = 'btn btn-sm btn-outline-primary rounded-pill';
    btnPreview.className = 'btn btn-sm btn-primary rounded-pill';
  }
}

document.getElementById('inviteForm').addEventListener('submit', function(e) {
  var checked = document.querySelectorAll('.kol-checkbox:checked');
  if (checked.length === 0) {
    e.preventDefault();
    alert('<%= t('admin.ui.m829') %>');
    return;
  }
  var ids = Array.from(checked).map(function(cb) { return cb.value; });
  var input = document.createElement('input');
  input.type = 'hidden';
  input.name = 'kol_ids';
  input.value = ids.join(',');
  this.appendChild(input);
});
</script>
