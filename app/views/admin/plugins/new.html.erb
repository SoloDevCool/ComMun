<% content_for :title, t("admin.upload_plugin") %>

<h5 class="mb-3">
  <a href="<%= admin_plugins_path %>" class="text-decoration-none text-muted me-2"><i class="bi bi-arrow-left"></i></a>
  <%= t('admin.ui.m067') %>
</h5>

<div class="card-admin card">
  <div class="card-body">
    <%= form_with(model: @plugin, url: admin_plugins_path, local: true, multipart: true) do |f| %>
      <% if @plugin.errors.any? %>
        <div class="alert alert-danger">
          <h6 class="alert-heading"><%= pluralize(@plugin.errors.count, t("admin.unit_ge")) %> <%= t('admin.ui.m315') %></h6>
          <ul class="mb-0">
            <% @plugin.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <label class="form-label"><%= t('admin.ui.m314') %> <span class="text-danger">*</span></label>
        <%= f.file_field :package_file, accept: ".zip", class: "form-control", required: true %>
        <div class="form-text"><%= t('admin.ui.m299') %></div>
      </div>

      <hr>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label"><%= t('admin.ui.m275') %></label>
          <%= f.text_field :name, class: "form-control", placeholder: t('admin.ui.m359') %>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label"><%= t('admin.ui.m358') %></label>
          <%= f.text_field :version, class: "form-control", placeholder: t('admin.ui.m356') %>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label"><%= t('admin.identifier') %></label>
        <%= f.text_field :identifier, class: "form-control", placeholder: "小写字母、数字、下划线（如 my_plugin）" %>
      </div>

      <div class="mb-3">
        <label class="form-label"><%= t('admin.description') %></label>
        <%= f.text_area :description, class: "form-control", rows: 2, placeholder: t('admin.ui.m351') %>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label"><%= t('admin.author') %></label>
          <%= f.text_field :author, class: "form-control", placeholder: t('admin.ui.m350') %>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label"><%= t('admin.ui.m114') %></label>
          <%= f.url_field :homepage, class: "form-control", placeholder: "https://example.com" %>
        </div>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit t('admin.ui.m348'), class: "btn btn-primary" %>
        <%= link_to t("admin.cancel"), admin_plugins_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
