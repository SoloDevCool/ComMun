<h4 class="mb-1 admin-page-title">SEO <%= t('admin.ui.d043') %></h4>
<div class="admin-page-subtitle mb-4"><i class="bi bi-graph-up-arrow me-1"></i>优化站点在搜索引擎中的收录与展示效果</div>

<% unless @license_valid %>
<div class="alert alert-warning mb-4">
  <i class="bi bi-exclamation-triangle me-1"></i>
  <strong><%= t('admin.ui.d085') %></strong> — 前<%= t('admin.ui.d086') %>正常<%= t('admin.ui.d087') %><%= t('admin.ui.d043') %><%= t('admin.ui.d088') %>
  <%= t('admin.ui.d089') %> <a href="<%= admin_settings_path %>" class="alert-link"><%= t('admin.ui.d090') %></a> <%= t('admin.ui.d041') %>
</div>
<% end %>

<style>
  /* 输入控件现代化 */
  .seo-form .form-control-sm,
  .seo-form .form-select-sm {
    border-radius: 9px;
    font-size: .875rem;
    padding: .45rem .75rem;
    min-height: 36px;
    transition: border-color .15s, box-shadow .15s;
  }
  .seo-form .form-control-sm:focus,
  .seo-form .form-select-sm:focus {
    border-color: #155eef;
    box-shadow: 0 0 0 3px rgba(21,94,239,.1);
  }
  .seo-form .form-label { color: #344054; font-size: .82rem; }
  .seo-hint { font-size: .75rem; color: #98a2b3; margin-bottom: 4px; }
  /* 搜索引擎验证输入组 */
  .engine-field { position: relative; }
  .engine-field .engine-icon {
    position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
    font-size: .95rem; pointer-events: none;
  }
  .engine-field .form-control-sm { padding-left: 34px; }
  /* 字数统计胶囊 */
  .seo-count-pill {
    display: inline-block; font-size: .72rem; font-weight: 600;
    border-radius: 999px; padding: 2px 10px;
    background: #f1f5f9; color: #64748b;
    transition: background .15s, color .15s;
  }
  .seo-count-pill.ok { background: rgba(16,185,129,.1); color: #059669; }
  .seo-count-pill.over { background: rgba(220,53,69,.1); color: #dc3545; }
  /* 状态徽章 */
  .seo-status-pill {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: .75rem; border-radius: 999px; padding: 4px 12px;
    background: rgba(16,185,129,.08); color: #059669;
    border: 1px solid rgba(16,185,129,.25);
  }
  .seo-status-pill code { color: inherit; font-size: .72rem; }
  /* 搜索结果预览 */
  .serp-preview {
    border: 1px solid #e4e7ec; border-radius: 12px;
    padding: 16px; background: #fff;
  }
  .serp-site { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .serp-favicon {
    width: 28px; height: 28px; border-radius: 50%;
    background: #f1f5f9; display: flex; align-items: center; justify-content: center;
    color: #64748b; font-size: .85rem; flex-shrink: 0;
  }
  .serp-site-name { font-size: .8rem; color: #202124; line-height: 1.2; }
  .serp-url { font-size: .72rem; color: #4d5156; }
  .serp-title {
    color: #1a0dab; font-size: 1.05rem; font-weight: 500;
    line-height: 1.3; margin-bottom: 4px;
    word-break: break-word;
  }
  .serp-desc { font-size: .8rem; color: #4d5156; line-height: 1.55; word-break: break-word; }
  /* OG 图预览 */
  .og-preview img { border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,.08); max-height: 120px; object-fit: cover; }
  /* 保存按钮 */
  .seo-form .btn[type="submit"] { transition: transform .12s, box-shadow .12s; }
  .seo-form .btn[type="submit"]:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(21,94,239,.25); }
</style>

<div class="row g-4">
  <div class="col-lg-7">
    <%= form_with url: admin_seo_settings_path, method: :patch, scope: :settings, class: "needs-validation seo-form" do |f| %>

      <!-- SEO 基础<%= t('admin.ui.d043') %> -->
      <div class="card card-admin mb-4">
        <div class="card-header py-3">
          <h6 class="mb-0 fw-bold"><i class="bi bi-search me-2 text-success"></i><%= t('admin.ui.d038') %></h6>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3"><%= t('admin.ui.d002') %></p>
          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :site_name, t('admin.ui.d037'), class: "form-label fw-semibold small" %>
              <p class="seo-hint"><%= t('admin.ui.d013') %></p>
              <%= f.text_field :site_name, value: @settings[:site_name], class: "form-control form-control-sm", placeholder: t('admin.ui.d028'), data: { serp: "site" } %>
            </div>
            <div class="col-md-6">
              <%= f.label :seo_site_name, "SEO 站点名称", class: "form-label fw-semibold small" %>
              <p class="seo-hint"><%= t('admin.ui.d012') %></p>
              <%= f.text_field :seo_site_name, value: @settings[:seo_site_name], class: "form-control form-control-sm", placeholder: t('admin.ui.d028'), data: { serp: "seo_site" } %>
            </div>
            <div class="col-12">
              <%= f.label :seo_title, t('admin.ui.d036'), class: "form-label fw-semibold small" %>
              <p class="seo-hint"><%= t('admin.ui.d017') %></p>
              <%= f.text_field :seo_title, value: @settings[:seo_title], class: "form-control form-control-sm", placeholder: t('admin.ui.d020'), data: { serp: "title" } %>
            </div>
            <div class="col-12">
              <%= f.label :seo_description, t('admin.ui.d035'), class: "form-label fw-semibold small" %>
              <p class="seo-hint"><%= t('admin.ui.d009') %></p>
              <%= f.text_area :seo_description, value: @settings[:seo_description], class: "form-control form-control-sm", rows: 3, placeholder: t('admin.ui.d005'), data: { serp: "desc" } %>
              <div class="text-end mt-1">
                <span class="seo-count-pill" id="seoDescriptionCount">0 / 160</span>
              </div>
            </div>
            <div class="col-12">
              <%= f.label :seo_keywords, t('admin.ui.d040'), class: "form-label fw-semibold small" %>
              <p class="seo-hint"><%= t('admin.ui.d024') %></p>
              <%= f.text_field :seo_keywords, value: @settings[:seo_keywords], class: "form-control form-control-sm", placeholder: t('admin.ui.d010') %>
            </div>
            <div class="col-12">
              <%= f.label :seo_og_image, t('admin.ui.d032'), class: "form-label fw-semibold small" %>
              <p class="seo-hint"><%= t('admin.ui.d015') %>×630 <%= t('admin.ui.d016') %></p>
              <%= f.text_field :seo_og_image, value: @settings[:seo_og_image], class: "form-control form-control-sm", placeholder: t('admin.ui.d003') %>
              <% if @settings[:seo_og_image].present? %>
                <div class="og-preview mt-2">
                  <img src="<%= @settings[:seo_og_image].start_with?("http") ? @settings[:seo_og_image] : "#{request.base_url}#{@settings[:seo_og_image]}" %>" alt="OG Image Preview">
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- <%= t('admin.ui.d030') %> -->
      <div class="card card-admin mb-4">
        <div class="card-header py-3">
          <h6 class="mb-0 fw-bold"><i class="bi bi-shield-check me-2 text-info"></i><%= t('admin.ui.d030') %></h6>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3"><%= t('admin.ui.d011') %></p>
          <div class="row g-3">
            <div class="col-md-4">
              <%= f.label :seo_google_verification, "Google Search Console", class: "form-label fw-semibold small" %>
              <p class="seo-hint">HTML <%= t('admin.ui.d018') %></p>
              <div class="engine-field">
                <i class="bi bi-google engine-icon text-danger"></i>
                <%= f.text_field :seo_google_verification, value: @settings[:seo_google_verification], class: "form-control form-control-sm", placeholder: t('admin.ui.d022') %>
              </div>
            </div>
            <div class="col-md-4">
              <%= f.label :seo_bing_verification, "Bing Webmaster", class: "form-label fw-semibold small" %>
              <p class="seo-hint">HTML <%= t('admin.ui.d018') %></p>
              <div class="engine-field">
                <i class="bi bi-microsoft engine-icon text-primary"></i>
                <%= f.text_field :seo_bing_verification, value: @settings[:seo_bing_verification], class: "form-control form-control-sm", placeholder: t('admin.ui.d022') %>
              </div>
            </div>
            <div class="col-md-4">
              <%= f.label :seo_baidu_verification, t('admin.ui.d034'), class: "form-label fw-semibold small" %>
              <p class="seo-hint">HTML <%= t('admin.ui.d018') %></p>
              <div class="engine-field">
                <i class="bi bi-globe engine-icon" style="color:#2932e1"></i>
                <%= f.text_field :seo_baidu_verification, value: @settings[:seo_baidu_verification], class: "form-control form-control-sm", placeholder: t('admin.ui.d022') %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 页脚<%= t('admin.ui.d043') %> -->
      <div class="card card-admin mb-4">
        <div class="card-header py-3">
          <h6 class="mb-0 fw-bold"><i class="bi bi-code-slash me-2 text-secondary"></i><%= t('admin.ui.d029') %></h6>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3"><%= t('admin.ui.d001') %></p>
          <div class="row g-3">
            <div class="col-12">
              <%= f.text_area :seo_footer_html, value: @settings[:seo_footer_html], class: "form-control form-control-sm font-monospace", rows: 6, placeholder: "例如：&#60;script async src=\"https://www.googletagmanager.com/gtag/js?id=G-XXXXXXX\"&#62;&#60;/script&#62;" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Microsoft Clarity -->
      <div class="card card-admin mb-4">
        <div class="card-header py-3">
          <h6 class="mb-0 fw-bold"><i class="bi bi-eye me-2" style="color:#7b2d8e"></i>Microsoft Clarity</h6>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3">Microsoft Clarity <%= t('admin.ui.d004') %><a href="https://clarity.microsoft.com" target="_blank"><%= t('admin.ui.d027') %></a></p>
          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :clarity_project_id, "Clarity Project ID", class: "form-label fw-semibold small" %>
              <p class="seo-hint"><%= t('admin.ui.d008') %> &lt;head&gt; <%= t('admin.ui.d044') %></p>
              <%= f.text_field :clarity_project_id, value: @settings[:clarity_project_id], class: "form-control form-control-sm", placeholder: t('admin.ui.d023') %>
            </div>
          </div>
          <% if @settings[:clarity_project_id].present? %>
            <div class="mt-3">
              <span class="seo-status-pill">
                <i class="bi bi-check-circle-fill"></i>Clarity <%= t('admin.ui.d021') %><code><%= @settings[:clarity_project_id] %></code>
              </span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- IndexNow -->
      <div class="card card-admin mb-4">
        <div class="card-header py-3">
          <h6 class="mb-0 fw-bold"><i class="bi bi-bell me-2 text-primary"></i>Bing IndexNow</h6>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3"><%= t('admin.ui.d007') %><a href="https://www.bing.com/indexnow" target="_blank"><%= t('admin.ui.d025') %></a></p>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold small"><%= t('admin.ui.d026') %></label>
              <select name="settings[indexnow_enabled]" class="form-select form-select-sm">
                <option value="false" <%= "selected" if @settings[:indexnow_enabled] != "true" %>><%= t('admin.close') %></option>
                <option value="true" <%= "selected" if @settings[:indexnow_enabled] == "true" %>><%= t('admin.enable') %></option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold small">API Key</label>
              <input type="text" name="settings[indexnow_key]" value="<%= @settings[:indexnow_key] %>" class="form-control form-control-sm font-monospace" placeholder="<%= t('admin.ui.d019') %>" maxlength="36">
              <div class="form-text"><%= t('admin.ui.d014') %></div>
            </div>
          </div>
          <% if @settings[:indexnow_key].present? %>
            <div class="mt-3">
              <span class="seo-status-pill">
                <i class="bi bi-check-circle-fill"></i>Key <%= t('admin.ui.d031') %><code>/<%= @settings[:indexnow_key] %>.txt</code>
              </span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary rounded-pill px-4" <%= 'disabled' unless @license_valid %>>
          <i class="bi bi-check-lg me-1"></i><%= t('admin.ui.d033') %>
        </button>
      </div>
    <% end %>
  </div>

  <!-- 搜索结果实时预览 -->
  <div class="col-lg-5">
    <div class="card card-admin sticky-top" style="top:1rem">
      <div class="card-header py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-eye me-2 text-primary"></i>搜索结果预览</h6>
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3"><i class="bi bi-info-circle me-1"></i>输入内容时实时模拟 Google 搜索结果中的展示效果</p>
        <div class="serp-preview">
          <div class="serp-site">
            <div class="serp-favicon"><i class="bi bi-globe2"></i></div>
            <div>
              <div class="serp-site-name" id="serpSiteName"><%= @settings[:seo_site_name].presence || @settings[:site_name].presence || site_name %></div>
              <div class="serp-url"><%= request.base_url %></div>
            </div>
          </div>
          <div class="serp-title" id="serpTitle"><%= @settings[:seo_title].presence || "#{site_name} - #{t('layouts.application.default_title_suffix')}" %></div>
          <div class="serp-desc" id="serpDesc"><%= @settings[:seo_description].presence || t('admin.ui.d005') %></div>
        </div>
        <div class="mt-3">
          <div class="d-flex justify-content-between small text-muted mb-1">
            <span><i class="bi bi-lightbulb me-1"></i>标题建议 30 字以内</span>
            <span id="serpTitleCount">0 / 30</span>
          </div>
          <div class="progress" style="height:5px;border-radius:3px">
            <div class="progress-bar bg-success" id="serpTitleBar" style="width:0%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  // 描述字数统计
  var desc = document.getElementById("settings_seo_description");
  var count = document.getElementById("seoDescriptionCount");
  function updateDescCount() {
    if (!desc || !count) return;
    var len = desc.value.length;
    count.textContent = len + " / 160";
    count.className = "seo-count-pill" + (len > 160 ? " over" : (len >= 80 ? " ok" : ""));
  }
  if (desc) desc.addEventListener("input", updateDescCount);
  updateDescCount();

  // 搜索结果实时预览
  var serpBindings = {
    site: document.querySelector('[data-serp="site"]'),
    seoSite: document.querySelector('[data-serp="seo_site"]'),
    title: document.querySelector('[data-serp="title"]'),
    desc: document.querySelector('[data-serp="desc"]')
  };
  var serpSiteName = document.getElementById("serpSiteName");
  var serpTitle = document.getElementById("serpTitle");
  var serpDesc = document.getElementById("serpDesc");
  var serpTitleCount = document.getElementById("serpTitleCount");
  var serpTitleBar = document.getElementById("serpTitleBar");
  var fallbackSiteName = serpSiteName ? serpSiteName.textContent : "";
  var fallbackTitle = serpTitle ? serpTitle.textContent : "";
  var fallbackDesc = serpDesc ? serpDesc.textContent : "";

  function renderSerp() {
    if (!serpSiteName) return;
    var siteName = (serpBindings.seoSite && serpBindings.seoSite.value.trim()) ||
                   (serpBindings.site && serpBindings.site.value.trim()) || fallbackSiteName;
    var title = (serpBindings.title && serpBindings.title.value.trim()) || fallbackTitle;
    var description = (serpBindings.desc && serpBindings.desc.value.trim()) || fallbackDesc;
    serpSiteName.textContent = siteName;
    serpTitle.textContent = title;
    serpDesc.textContent = description;
    // 标题长度指示（Google 一般展示 30 个汉字 / 60 字符）
    var len = title.length;
    if (serpTitleCount) {
      serpTitleCount.textContent = len + " / 30";
      serpTitleCount.className = len > 30 ? "text-danger" : "text-muted";
    }
    if (serpTitleBar) {
      var pct = Math.min(100, Math.round(len / 30 * 100));
      serpTitleBar.style.width = pct + "%";
      serpTitleBar.className = "progress-bar " + (len > 30 ? "bg-danger" : len >= 20 ? "bg-success" : "bg-warning");
    }
  }
  Object.keys(serpBindings).forEach(function(key) {
    if (serpBindings[key]) serpBindings[key].addEventListener("input", renderSerp);
  });
  renderSerp();
});
</script>
