// === CPS Ads Management ===
var cpsAdsToken = null;

function getCpsAdsToken() {
  if (!cpsAdsToken) {
    var meta = document.querySelector('meta[name="csrf-token"]');
    cpsAdsToken = meta ? meta.content : '';
  }
  return cpsAdsToken;
}

function loadCpsAds() {
  var container = document.getElementById('cpsAdsList');
  fetch('/admin/cps_ads', {
    headers: { 'Accept': 'application/json', 'X-CSRF-Token': getCpsAdsToken() }
  })
  .then(function(r) {
    if (!r.ok) return r.text().then(function(t) { throw new Error(r.status + ': ' + t.substring(0, 200)); });
    return r.json();
  })
  .then(function(ads) {
    if (!ads || ads.length === 0) {
      container.innerHTML = '<div class="text-muted small"><i class="bi bi-info-circle me-1"></i><%= t('admin.settings.s161') %></div>';
      return;
    }
    var html = '<div class="list-group list-group-flush">';
    ads.forEach(function(ad) {
      var statusBadge = ad.is_active
        ? '<span class="badge bg-success-subtle text-success"><%= t('admin.settings.s222') %></span>'
        : '<span class="badge bg-secondary"><%= t('admin.settings.s295') %></span>';
      var imageHtml = ad.image_url
        ? '<img src="' + ad.image_url + '" alt="" style="height:32px;width:48px;object-fit:cover;border-radius:4px;margin-right:8px;">'
        : '<span class="bg-light border rounded d-inline-flex align-items-center justify-content-center me-2" style="height:32px;width:48px;"><i class="bi bi-image text-muted" style="font-size:0.8rem"></i></span>';
      html += '<div class="list-group-item px-0 py-2 d-flex align-items-center">'
        + imageHtml
        + '<div class="flex-grow-1 min-w-0">'
        + '<div class="fw-semibold small text-truncate">' + ad.title + '</div>'
        + '<div class="text-muted" style="font-size:0.72rem;text-overflow:ellipsis;overflow:hidden;white-space:nowrap;max-width:200px;">' + ad.link_url + '</div>'
        + '</div>'
        + '<div class="d-flex align-items-center gap-2 flex-shrink-0 ms-2">'
        + statusBadge
        + '<span class="text-muted" style="font-size:0.72rem"><%= t('admin.settings.s160') %> ' + ad.sort_order + '</span>'
        + '<button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1" onclick="editCpsAd(' + ad.id + ')" title="<%= t('admin.settings.s297') %>"><i class="bi bi-pencil" style="font-size:0.75rem"></i></button>'
        + '<button type="button" class="btn btn-outline-danger btn-sm py-0 px-1" onclick="deleteCpsAd(' + ad.id + ')" title="<%= t('admin.settings.s296') %>"><i class="bi bi-trash" style="font-size:0.75rem"></i></button>'
        + '</div>'
        + '</div>';
    });
    html += '</div>';
    container.innerHTML = html;
  })
  .catch(function(err) {
    container.innerHTML = '<div class="text-danger small"><i class="bi bi-exclamation-triangle me-1"></i><%= t('admin.settings.s159') %> ' + err.message + '</div>';
  });
}

function showCpsAdForm(editId) {
  document.getElementById('cps_ad_edit_id').value = editId || '';
  document.getElementById('cps_ad_form_title').value = '';
  document.getElementById('cps_ad_form_description').value = '';
  document.getElementById('cps_ad_form_image_url').value = '';
  document.getElementById('cps_ad_form_link_url').value = '';
  document.getElementById('cps_ad_form_sort_order').value = '0';
  document.getElementById('cps_ad_form_is_active').value = 'true';
  document.getElementById('cpsAdFormImagePreview').style.display = 'none';
  document.getElementById('cpsAdFormImagePreviewImg').src = '';
  document.getElementById('cpsAdFormImageUrlRow').style.display = 'none';
  document.getElementById('cps_ad_form_image_url_input').value = '';
  document.getElementById('cpsAdFormRemoveImageBtn').style.display = 'none';

  var modalTitle = document.getElementById('cpsAdModalTitle');
  if (editId) {
    modalTitle.textContent = '<%= t('admin.settings.s158') %>';
    fetch('/admin/cps_ads/' + editId, { headers: { 'Accept': 'application/json' } })
    .then(function(r) {
    if (!r.ok) return r.text().then(function(t) { throw new Error(r.status + ': ' + t.substring(0, 200)); });
    return r.json();
  })
    .then(function(ad) {
      document.getElementById('cps_ad_form_title').value = ad.title || '';
      document.getElementById('cps_ad_form_description').value = ad.description || '';
      document.getElementById('cps_ad_form_image_url').value = ad.image_url || '';
      document.getElementById('cps_ad_form_link_url').value = ad.link_url || '';
      document.getElementById('cps_ad_form_sort_order').value = ad.sort_order || 0;
      document.getElementById('cps_ad_form_is_active').value = ad.is_active ? 'true' : 'false';
      if (ad.image_url) {
        document.getElementById('cpsAdFormImagePreviewImg').src = ad.image_url;
        document.getElementById('cpsAdFormImagePreview').style.display = 'block';
        document.getElementById('cpsAdFormRemoveImageBtn').style.display = '';
      }
    });
  } else {
    modalTitle.textContent = '<%= t('admin.settings.s008') %>';
  }
  new bootstrap.Modal(document.getElementById('cpsAdModal')).show();
}

function editCpsAd(id) {
  showCpsAdForm(id);
}

function saveCpsAd() {
  var title = document.getElementById('cps_ad_form_title').value.trim();
  var linkUrl = document.getElementById('cps_ad_form_link_url').value.trim();
  if (!title) { alert('<%= t('admin.settings.s157') %>'); return; }
  if (!linkUrl) { alert('<%= t('admin.settings.s156') %>'); return; }

  var editId = document.getElementById('cps_ad_edit_id').value;
  var data = {
    cps_ad: {
      title: title,
      description: document.getElementById('cps_ad_form_description').value.trim(),
      image_url: document.getElementById('cps_ad_form_image_url').value.trim(),
      link_url: linkUrl,
      sort_order: parseInt(document.getElementById('cps_ad_form_sort_order').value) || 0,
      is_active: document.getElementById('cps_ad_form_is_active').value === 'true'
    }
  };

  var url, method;
  if (editId) {
    url = '/admin/cps_ads/' + editId;
    method = 'PATCH';
  } else {
    url = '/admin/cps_ads';
    method = 'POST';
  }

  fetch(url, {
    method: method,
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCpsAdsToken(), 'Accept': 'application/json' },
    body: JSON.stringify(data)
  })
  .then(function(r) {
    if (r.ok) return r.json();
    return r.json().then(function(e) { throw new Error((e.errors || []).join(', ')); });
  })
  .then(function() {
    bootstrap.Modal.getInstance(document.getElementById('cpsAdModal')).hide();
    loadCpsAds();
  })
  .catch(function(err) { alert('<%= t('admin.settings.s155') %> ' + err.message); });
}

function deleteCpsAd(id) {
  if (!confirm('<%= t('admin.settings.s154') %>')) return;
  fetch('/admin/cps_ads/' + id, {
    method: 'DELETE',
    headers: { 'X-CSRF-Token': getCpsAdsToken(), 'Accept': 'application/json' }
  })
  .then(function(r) {
    if (r.ok) { loadCpsAds(); }
    else { throw new Error('<%= t('admin.settings.s234') %>'); }
  })
  .catch(function(err) { alert(err.message); });
}

function uploadCpsAdFormImage(input) {
  if (!input.files || !input.files[0]) return;
  var file = input.files[0];
  if (file.size > 5 * 1024 * 1024) {
    alert('<%= t('admin.settings.s305') %>');
    input.value = '';
    return;
  }
  var formData = new FormData();
  formData.append('image', file);
  var xhr = new XMLHttpRequest();
  document.getElementById('cpsAdFormImageUploading').style.display = '';
  xhr.open('POST', '/images');
  xhr.setRequestHeader('X-CSRF-Token', getCpsAdsToken());
  xhr.onload = function() {
    document.getElementById('cpsAdFormImageUploading').style.display = 'none';
    if (xhr.status === 200) {
      try {
        var res = JSON.parse(xhr.responseText);
        var url = res.url || (res.image && res.image.url);
        if (url) {
          document.getElementById('cps_ad_form_image_url').value = url;
          document.getElementById('cpsAdFormImagePreviewImg').src = url;
          document.getElementById('cpsAdFormImagePreview').style.display = 'block';
          document.getElementById('cpsAdFormRemoveImageBtn').style.display = '';
          document.getElementById('cps_ad_form_image_url_input').value = '';
          document.getElementById('cpsAdFormImageUrlRow').style.display = 'none';
        }
      } catch(e) { alert('<%= t('admin.settings.s114') %>'); }
    } else { alert('<%= t('admin.settings.s113') %>'); }
    input.value = '';
  };
  xhr.onerror = function() {
    document.getElementById('cpsAdFormImageUploading').style.display = 'none';
    alert('<%= t('admin.settings.s112') %>');
    input.value = '';
  };
  xhr.send(formData);
}

function removeCpsAdFormImage() {
  document.getElementById('cps_ad_form_image_url').value = '';
  document.getElementById('cps_ad_form_image_url_input').value = '';
  document.getElementById('cpsAdFormImagePreview').style.display = 'none';
  document.getElementById('cpsAdFormImagePreviewImg').src = '';
  document.getElementById('cpsAdFormRemoveImageBtn').style.display = 'none';
}

function toggleCpsAdFormUrlInput() {
  var row = document.getElementById('cpsAdFormImageUrlRow');
  row.style.display = row.style.display === 'none' ? 'block' : 'none';
}

function syncCpsAdFormManualUrl(url) {
  document.getElementById('cps_ad_form_image_url').value = url;
  var preview = document.getElementById('cpsAdFormImagePreview');
  var img = document.getElementById('cpsAdFormImagePreviewImg');
  if (url.trim()) {
    img.src = url;
    preview.style.display = 'block';
    document.getElementById('cpsAdFormRemoveImageBtn').style.display = '';
  } else {
    preview.style.display = 'none';
    img.src = '';
    document.getElementById('cpsAdFormRemoveImageBtn').style.display = 'none';
  }
}

