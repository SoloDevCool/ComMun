function verifyLicense() {
  var fileInput = document.querySelector('[name="settings[license_file]"]');
  var licenseFile = fileInput ? fileInput.value.trim() : '';
  var resultDiv = document.getElementById('licenseVerifyResult');
  var btn = document.getElementById('btnVerifyLicense');

  if (!licenseFile) {
    resultDiv.innerHTML = '<div class="alert alert-warning py-2 small mb-0"><i class="bi bi-exclamation-triangle me-1"></i><%= t('admin.settings.s123') %></div>';
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span><%= t('admin.settings.s122') %>';
  resultDiv.innerHTML = '';

  fetch('/admin/settings/verify_license', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
    body: JSON.stringify({ license_file: licenseFile })
  })
  .then(function(res) { return res.json(); })
  .then(function(data) {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-lightning me-1"></i><%= t('admin.settings.s013') %>';
    if (data.success) {
      var d = data.data || {};
      var expiresInfo = d.end_date ? ' | <strong><%= t('admin.settings.s032') %></strong>' + new Date(d.end_date).toLocaleString('zh-CN') : ' | <strong><%= t('admin.settings.s032') %></strong><%= t('admin.settings.s121') %>';
      resultDiv.innerHTML = '<div class="alert alert-success py-2 small mb-0"><i class="bi bi-check-circle me-1"></i>'
        + '<strong><%= t('admin.settings.s120') %></strong> | '
        + '<strong><%= t('admin.settings.s119') %></strong>' + (d.product || '-') + ' | '
        + '<strong><%= t('admin.settings.s118') %></strong>' + (d.status || '-')
        + (d.plan ? ' | <strong><%= t('admin.settings.s334') %></strong>' + d.plan : '')
        + (d.license_key ? ' | <strong><%= t('admin.settings.s116') %></strong>' + d.license_key : '')
        + expiresInfo
        + '</div>';
      setTimeout(function(){ location.reload(); }, 1500);
    } else {
      resultDiv.innerHTML = '<div class="alert alert-danger py-2 small mb-0"><i class="bi bi-x-circle me-1"></i><%= t('admin.settings.s115') %>' + (data.error || '<%= t('admin.settings.s306') %>') + '</div>';
    }
  })
  .catch(function(err) {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-lightning me-1"></i><%= t('admin.settings.s013') %>';
    resultDiv.innerHTML = '<div class="alert alert-danger py-2 small mb-0"><i class="bi bi-x-circle me-1"></i><%= t('admin.settings.s115') %>' + err.message + '</div>';
  });
}
</script>
