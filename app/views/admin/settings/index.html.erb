<h4 class="mb-4 text-dark fw-bold"><%= t('admin.settings.s221') %></h4>

<div class="row g-4">
  <div class="col-lg-2 col-12">
    <div class="nav nav-pills flex-sm-column flex-row flex-wrap gap-1 sticky-top" id="settingsTabs" style="top: 1rem;" role="tablist">
      <button type="button" class="nav-link text-start active" data-settings-tab="license"><i class="bi bi-shield-lock me-1"></i>授权</button>
      <button type="button" class="nav-link text-start" data-settings-tab="basic"><i class="bi bi-gear me-1"></i>基础</button>
      <button type="button" class="nav-link text-start" data-settings-tab="user"><i class="bi bi-people me-1"></i>用户与注册</button>
      <button type="button" class="nav-link text-start" data-settings-tab="oauth"><i class="bi bi-box-arrow-in-right me-1"></i>第三方登录</button>
      <button type="button" class="nav-link text-start" data-settings-tab="thirdparty"><i class="bi bi-plug me-1"></i>第三方服务</button>
      <button type="button" class="nav-link text-start" data-settings-tab="ai"><i class="bi bi-robot me-1"></i>AI 功能</button>
      <button type="button" class="nav-link text-start" data-settings-tab="ops"><i class="bi bi-megaphone me-1"></i>运营推广</button>
      <button type="button" class="nav-link text-start" data-settings-tab="media"><i class="bi bi-cloud-arrow-up me-1"></i>媒体与存储</button>
    </div>
  </div>
  <div class="col-lg-10 col-12">
    <style>
      /* 左侧分类导航 */
      #settingsTabs {
        background: #fff;
        border-radius: 14px;
        padding: .6rem;
        box-shadow: 0 1px 3px rgba(16,24,40,.07), 0 1px 2px rgba(16,24,40,.04);
      }
      #settingsTabs .nav-link {
        width: 100%;
        color: #5c6770;
        border-radius: 9px;
        padding: .6rem .9rem;
        font-size: .9rem;
        font-weight: 500;
        text-align: start;
        border: none;
        background: transparent;
        transition: background .15s, color .15s, box-shadow .15s;
      }
      #settingsTabs .nav-link i { font-size: 1.05rem; width: 1.3rem; text-align: center; }
      #settingsTabs .nav-link:hover { background: #f2f4f7; color: #1d2939; }
      #settingsTabs .nav-link.active {
        background: linear-gradient(135deg, #155eef, #3b82f6);
        color: #fff;
        font-weight: 600;
        box-shadow: 0 3px 10px rgba(21,94,239,.28);
      }
      @media (min-width: 992px) {
        #settingsTabs { position: sticky; top: 1rem; }
        #settingsTabs .nav-link { width: 100%; }
      }

      /* 右侧内容卡片 */
      [data-settings-group] {
        border-radius: 14px;
        box-shadow: 0 1px 3px rgba(16,24,40,.07), 0 1px 2px rgba(16,24,40,.04);
        animation: settingsGroupIn .22s ease;
      }
      @keyframes settingsGroupIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: none; }
      }
      [data-settings-group] > .card-header {
        background: #fff;
        border-bottom: 1px solid #f2f4f7;
        padding: 1rem 1.25rem;
      }
      [data-settings-group] > .card-header h6 { font-size: .95rem; }
      [data-settings-group] > .card-body { padding: 1.25rem; }
      [data-settings-group] .form-label { color: #344054; font-size: .82rem; }
      /* 输入控件统一加大、圆角现代化 */
      [data-settings-group] .form-control-sm,
      [data-settings-group] .form-select-sm {
        border-radius: 9px;
        font-size: .875rem;
        padding: .45rem .75rem;
        min-height: 36px;
        transition: border-color .15s, box-shadow .15s;
      }
      [data-settings-group] .form-control-sm:focus,
      [data-settings-group] .form-select-sm:focus {
        border-color: #155eef;
        box-shadow: 0 0 0 3px rgba(21,94,239,.1);
      }
      /* 空分组占位 */
      .settings-empty {
        border-radius: 14px;
        box-shadow: 0 1px 3px rgba(16,24,40,.07), 0 1px 2px rgba(16,24,40,.04);
        padding: 56px 20px;
        text-align: center;
        background: #fff;
      }
      .settings-empty i { font-size: 2rem; color: #98a2b3; }
      /* 基础页快捷入口卡片 */
      .basic-link-card {
        transition: border-color .15s, background .15s, transform .12s;
        color: inherit;
      }
      .basic-link-card:hover {
        border-color: rgba(21,94,239,.45);
        background: rgba(21,94,239,.03);
        transform: translateY(-1px);
      }
    </style>

    <!-- 分组无内容时的占位（如未授权时的非授权标签页） -->
    <div id="settingsEmptyPlaceholder" class="settings-empty mb-4" style="display:none">
      <i class="bi bi-shield-lock d-block mb-2"></i>
      <div class="fw-semibold" style="color:#344054">该分类暂无可显示的设置项</div>
      <div class="text-muted small mt-1">请先在「授权」标签页完成系统授权激活</div>
    </div>

    <%= form_with url: admin_settings_path, method: :patch, scope: :settings, class: "needs-validation", local: true do |f| %>

      <!-- <%= t('admin.settings.s220') %> -->
      <div class="card card-admin mb-4" data-settings-group="license">
        <div class="card-header py-3">
          <h6 class="mb-0 fw-bold"><i class="bi bi-shield-lock me-2 text-primary"></i><%= t('admin.settings.s220') %></h6>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3"><%= t('admin.settings.license_hint') %></p>
          <div class="row g-3 mb-3">
            <div class="col-md-8">
              <%= f.label :license_key, t('admin.settings.s218'), class: "form-label fw-semibold small" %>
              <%= f.text_field :license_key, value: @settings[:license_key], class: "form-control form-control-sm", placeholder: t('admin.settings.s217') %>
            </div>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-12">
              <%= f.label :license_file, t('admin.settings.s330'), class: "form-label fw-semibold small" %>
              <%= f.text_area :license_file, rows: 4, value: @settings[:license_file], class: "form-control form-control-sm font-monospace", placeholder: t('admin.settings.s331') %>
              <div class="form-text small"><%= t('admin.settings.s332') %></div>
            </div>
            <div class="col-12">
              <button type="button" class="btn btn-outline-primary btn-sm" id="btnVerifyLicense" onclick="verifyLicense()">
                <i class="bi bi-lightning me-1"></i><%= t('admin.settings.s013') %>
              </button>
            </div>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-md-8">
              <label class="form-label fw-semibold small"><%= t('admin.settings.s333') %></label>
              <input type="text" class="form-control form-control-sm font-monospace bg-light" value="<%= @hardware_fingerprint %>" readonly>
            </div>
          </div>
          <div id="licenseVerifyResult"></div>
          <div id="licenseStatus" class="mt-2"></div>
          <% unless @license_verified %>
            <div class="alert alert-warning mt-3 mb-0 small">
              <i class="bi bi-exclamation-triangle me-1"></i>License <%= t('admin.settings.s216') %>
            </div>
          <% end %>
        </div>
      </div>

      <% if @license_verified %>

      <!-- <%= t('admin.settings.s215') %> -->
      <div class="card card-admin mb-4" data-settings-group="basic">
        <div class="card-header py-3">
          <h6 class="mb-0 fw-bold"><i class="bi bi-globe2 me-2 text-primary"></i><%= t('admin.settings.s215') %></h6>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :site_locale, t('admin.settings.s214'), class: "form-label fw-semibold small" %>
              <select name="settings[site_locale]" id="settings_site_locale" class="form-select form-select-sm">
                <option value="zh-CN" <%= "selected" if @settings[:site_locale] == "zh-CN" %>><%= t('admin.settings.s231') %></option>
                <option value="en" <%= "selected" if @settings[:site_locale] == "en" %>>English</option>
                <option value="ja" <%= "selected" if @settings[:site_locale] == "ja" %>><%= t('admin.settings.s230') %></option>
                <option value="ko" <%= "selected" if @settings[:site_locale] == "ko" %>>한국어</option>
              </select>
              <div class="form-text small"><%= t('admin.settings.s213') %></div>
            </div>
          </div>
          <hr class="my-3">
          <div class="fw-semibold small mb-2"><i class="bi bi-link-45deg me-1 text-muted"></i>相关设置入口</div>
          <div class="row g-2">
            <div class="col-md-4">
              <%= link_to admin_appearance_settings_path, class: "text-decoration-none" do %>
                <div class="border rounded-3 p-3 h-100 basic-link-card">
                  <div class="fw-semibold small"><i class="bi bi-palette me-2 text-primary"></i>外观设置</div>
                  <div class="text-muted" style="font-size:0.75rem">站点名称、Logo、导航模块</div>
                </div>
              <% end %>
            </div>
            <div class="col-md-4">
              <%= link_to admin_seo_settings_path, class: "text-decoration-none" do %>
                <div class="border rounded-3 p-3 h-100 basic-link-card">
                  <div class="fw-semibold small"><i class="bi bi-search me-2 text-success"></i>SEO 设置</div>
                  <div class="text-muted" style="font-size:0.75rem">站点描述、关键词、验证码</div>
                </div>
              <% end %>
            </div>
            <div class="col-md-4">
              <%= link_to admin_plugins_path, class: "text-decoration-none" do %>
                <div class="border rounded-3 p-3 h-100 basic-link-card">
                  <div class="fw-semibold small"><i class="bi bi-box-seam me-2 text-warning"></i>插件管理</div>
                  <div class="text-muted" style="font-size:0.75rem">启用或停用功能插件</div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- GitHub OAuth（由 oauth_github 插件提供） -->
      <% if Plugin.enabled?("oauth_github") %>
      <div class="card card-admin mb-4" data-settings-group="oauth">
        <div class="card-header py-3">
          <h6 class="mb-0 fw-bold"><i class="bi bi-github me-2 text-dark"></i>GitHub OAuth <%= t('admin.settings.s010') %></h6>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3"><%= t('admin.settings.github_hint_html', docs: link_to('GitHub Developer Settings', 'https://github.com/settings/developers', target: '_blank', rel: 'noopener'), callback: tag.code("#{request.base_url}/users/auth/github/callback", class: 'bg-light px-2 py-1 rounded')).html_safe %></p>
          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :github_client_id, "Client ID", class: "form-label fw-semibold small" %>
              <%= f.text_field :github_client_id, value: @settings[:github_client_id], class: "form-control form-control-sm", placeholder: t('admin.settings.s004') %>
            </div>
            <div class="col-md-6">
              <%= f.label :github_client_secret, "Client Secret", class: "form-label fw-semibold small" %>
              <%= f.text_field :github_client_secret, value: @settings[:github_client_secret], class: "form-control form-control-sm", placeholder: t('admin.settings.s005') %>
            </div>
          </div>
        </div>
      </div>

      <% end %>

      <!-- Google OAuth（由 oauth_google 插件提供） -->
      <% if Plugin.enabled?("oauth_google") %>
      <div class="card card-admin mb-4" data-settings-group="oauth">
        <div class="card-header py-3">
          <h6 class="mb-0 fw-bold"><i class="bi bi-google me-2 text-danger"></i>Google OAuth <%= t('admin.settings.s010') %></h6>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3"><%= t('admin.settings.google_hint_html', docs: link_to('Google Cloud Console', 'https://console.cloud.google.com/apis/credentials', target: '_blank', rel: 'noopener'), callback: tag.code("#{request.base_url}/users/auth/google_oauth2/callback", class: 'bg-light px-2 py-1 rounded')).html_safe %></p>
          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :google_client_id, "Client ID", class: "form-label fw-semibold small" %>
              <%= f.text_field :google_client_id, value: @settings[:google_client_id], class: "form-control form-control-sm", placeholder: t('admin.settings.s004') %>
            </div>
            <div class="col-md-6">
              <%= f.label :google_client_secret, "Client Secret", class: "form-label fw-semibold small" %>
              <%= f.text_field :google_client_secret, value: @settings[:google_client_secret], class: "form-control form-control-sm", placeholder: t('admin.settings.s005') %>
            </div>
          </div>
        </div>
      </div>

      <% end %>

      <!-- Gitee OAuth（由 oauth_gitee 插件提供） -->
      <% if Plugin.enabled?("oauth_gitee") %>
      <div class="card card-admin mb-4" data-settings-group="oauth">
        <div class="card-header py-3">
          <h6 class="mb-0 fw-bold"><i class="bi bi-git me-2 text-danger"></i>Gitee OAuth <%= t('admin.settings.s010') %></h6>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3"><%= t('admin.settings.gitee_hint_html', docs: link_to(t('admin.settings.gitee_apps'), 'https://gitee.com/oauth/applications', target: '_blank', rel: 'noopener'), callback: tag.code("#{request.base_url}/users/auth/gitee/callback", class: 'bg-light px-2 py-1 rounded')).html_safe %></p>
          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :gitee_client_id, "Client ID", class: "form-label fw-semibold small" %>
              <%= f.text_field :gitee_client_id, value: @settings[:gitee_client_id], class: "form-control form-control-sm", placeholder: t('admin.settings.s004') %>
            </div>
            <div class="col-md-6">
              <%= f.label :gitee_client_secret, "Client Secret", class: "form-label fw-semibold small" %>
              <%= f.text_field :gitee_client_secret, value: @settings[:gitee_client_secret], class: "form-control form-control-sm", placeholder: t('admin.settings.s005') %>
            </div>
          </div>
        </div>
      </div>
      <% end %>

      <!-- 百度翻译 -->
      <div class="card card-admin mb-4" data-settings-group="thirdparty">
        <div class="card-header py-3">
          <h6 class="mb-0 fw-bold"><i class="bi bi-translate me-2 text-primary"></i><%= t('admin.settings.s238') %></h6>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3"><%= t('admin.settings.baidu_hint_html', docs: link_to(t('admin.settings.baidu_platform'), 'https://fanyi-api.baidu.com/', target: '_blank', rel: 'noopener')).html_safe %></p>
          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :baidu_translate_appid, "APP ID", class: "form-label fw-semibold small" %>
              <%= f.text_field :baidu_translate_appid, value: @settings[:baidu_translate_appid], class: "form-control form-control-sm", placeholder: t('admin.settings.s239') %>
            </div>
            <div class="col-md-6">
              <%= f.label :baidu_translate_key, t('admin.settings.s007'), class: "form-label fw-semibold small" %>
              <%= f.text_field :baidu_translate_key, value: @settings[:baidu_translate_key], class: "form-control form-control-sm", placeholder: t('admin.settings.s240') %>
            </div>
          </div>
        </div>
      </div>

      <!-- 邮件验证码 -->
      <div class="card card-admin mb-4" data-settings-group="user">
        <div class="card-header py-3">
          <h6 class="mb-0 fw-bold"><i class="bi bi-envelope-check me-2 text-success"></i><%= t('admin.settings.s237') %></h6>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3"><%= t('admin.settings.email_verify_hint') %></p>
          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label fw-semibold small"><%= t('admin.settings.s222') %><%= t('admin.settings.s237') %></label>
              <select name="settings[email_verification_enabled]" class="form-select form-select-sm">
                <option value="false" <%= "selected" if @settings[:email_verification_enabled] != "true" %>><%= t('admin.settings.s223') %></option>
                <option value="true" <%= "selected" if @settings[:email_verification_enabled] == "true" %>><%= t('admin.settings.s222') %></option>
              </select>
            </div>
            <div class="col-md-8">
              <label class="form-label fw-semibold small"><%= t('admin.settings.s241') %></label>
              <select name="settings[email_provider]" class="form-select form-select-sm" id="emailProviderSelect" onchange="toggleEmailProvider()">
                <option value="sendflare" <%= "selected" if @settings[:email_provider] != "tencent_ses" %>>Sendflare</option>
                <option value="tencent_ses" <%= "selected" if @settings[:email_provider] == "tencent_ses" %>><%= t('admin.settings.s242') %></option>
              </select>
            </div>
          </div>

          <!-- Sendflare 配置 -->
          <div id="sendflareConfig">
            <p class="text-muted small mb-3"><%= t('admin.settings.sendflare_hint_html', docs: link_to('Sendflare', 'https://sendflare.com', target: '_blank', rel: 'noopener')).html_safe %></p>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <%= f.label :sendflare_from_email, t('admin.settings.s262'), class: "form-label fw-semibold small" %>
                <%= f.email_field :sendflare_from_email, value: @settings[:sendflare_from_email], class: "form-control form-control-sm", placeholder: "noreply@example.com" %>
              </div>
            </div>
            <div class="row g-3">
              <div class="col-md-12">
                <%= f.label :sendflare_api_token, "API Token", class: "form-label fw-semibold small" %>
                <%= f.text_field :sendflare_api_token, value: @settings[:sendflare_api_token], class: "form-control form-control-sm", placeholder: t('admin.settings.s263') %>
                <div class="form-text"><%= t('admin.settings.sendflare_token_hint_html', console: link_to(t('admin.settings.console'), 'https://sendflare.com', target: '_blank', rel: 'noopener')).html_safe %></div>
              </div>
            </div>
          </div>

          <!-- <%= t('admin.settings.s322') %> SES 配置 -->
          <div id="tencentSesConfig" style="display:none">
            <p class="text-muted small mb-3"><%= t('admin.settings.ses_hint_html', keys: link_to(t('admin.settings.api_key_management'), 'https://console.cloud.tencent.com/cam/capi', target: '_blank', rel: 'noopener'), ses: link_to(t('admin.settings.ses_console'), 'https://console.cloud.tencent.com/ses', target: '_blank', rel: 'noopener')).html_safe %></p>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold small">SecretId</label>
                <input type="text" name="settings[tencent_ses_secret_id]" class="form-control form-control-sm" value="<%= @settings[:tencent_ses_secret_id] %>" placeholder="<%= t('admin.settings.s002') %>">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold small">SecretKey</label>
                <input type="password" name="settings[tencent_ses_secret_key]" class="form-control form-control-sm" value="<%= @settings[:tencent_ses_secret_key] %>" placeholder="<%= t('admin.settings.s003') %>">
              </div>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold small"><%= t('admin.settings.s183') %></label>
                <input type="email" name="settings[tencent_ses_from_email]" class="form-control form-control-sm" value="<%= @settings[:tencent_ses_from_email] %>" placeholder="noreply@example.com">
                <div class="form-text"><%= t('admin.settings.s182') %></div>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold small"><%= t('admin.settings.s014') %></label>
                <select name="settings[tencent_ses_region]" class="form-select form-select-sm">
                  <option value="ap-guangzhou" <%= "selected" if @settings[:tencent_ses_region] == "ap-guangzhou" %>><%= t('admin.settings.s224') %></option>
                  <option value="ap-shanghai" <%= "selected" if @settings[:tencent_ses_region] == "ap-shanghai" %>><%= t('admin.settings.s229') %></option>
                  <option value="ap-beijing" <%= "selected" if @settings[:tencent_ses_region] == "ap-beijing" %>><%= t('admin.settings.s228') %></option>
                  <option value="ap-chengdu" <%= "selected" if @settings[:tencent_ses_region] == "ap-chengdu" %>><%= t('admin.settings.s227') %></option>
                  <option value="ap-hongkong" <%= "selected" if @settings[:tencent_ses_region] == "ap-hongkong" %>><%= t('admin.settings.s226') %></option>
                  <option value="ap-singapore" <%= "selected" if @settings[:tencent_ses_region] == "ap-singapore" %>><%= t('admin.settings.s225') %></option>
                  <option value="ap-bangkok" <%= "selected" if @settings[:tencent_ses_region] == "ap-bangkok" %>><%= t('admin.settings.s181') %></option>
                  <option value="ap-tokyo" <%= "selected" if @settings[:tencent_ses_region] == "ap-tokyo" %>><%= t('admin.settings.s180') %></option>
                  <option value="na-ashburn" <%= "selected" if @settings[:tencent_ses_region] == "na-ashburn" %>><%= t('admin.settings.s179') %></option>
                  <option value="eu-frankfurt" <%= "selected" if @settings[:tencent_ses_region] == "eu-frankfurt" %>><%= t('admin.settings.s178') %></option>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- <%= t('admin.settings.s177') %> -->
      <div class="card card-admin mb-4" data-settings-group="user">
        <div class="card-header py-3">
          <h6 class="mb-0 fw-bold"><i class="bi bi-person-plus me-2 text-success"></i><%= t('admin.settings.s177') %></h6>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3"><%= t('admin.settings.registration_hint') %></p>
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label fw-semibold small"><i class="bi bi-person me-1 text-primary"></i><%= t('admin.settings.s175') %></label>
              <select name="settings[username_registration_enabled]" class="form-select form-select-sm">
                <option value="false" <%= "selected" if @settings[:username_registration_enabled] != "true" %>><%= t('admin.settings.s223') %></option>
                <option value="true" <%= "selected" if @settings[:username_registration_enabled] == "true" %>><%= t('admin.settings.s222') %></option>
              </select>
              <div class="form-text"><%= t('admin.settings.s174') %> + <%= t('admin.settings.s015') %></div>
            </div>
            <div class="col-md-4">
