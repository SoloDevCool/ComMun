<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h5 class="fw-bold mb-1"><i class="bi bi-brush me-2"></i><%= t('admin.ui.m1021') %> - <%= @theme.builtin_default? ? t('admin.ui.m542') : @theme.name %></h5>
    <p class="text-muted mb-0" style="font-size:0.85rem"><%= t('admin.ui.m476') %></p>
  </div>
  <%= link_to admin_themes_path, class: "btn btn-sm btn-outline-secondary" do %>
    <i class="bi bi-arrow-left me-1"></i><%= t('admin.ui.m1026') %>
  <% end %>
</div>

<!-- 主题信息 -->
<div class="card card-admin mb-4">
  <div class="card-body d-flex align-items-center gap-3">
    <% if @theme.screenshot_path %>
      <img src="<%= screenshot_admin_theme_path(@theme) %>" alt="<%= @theme.name %>" style="width:80px;height:80px;object-fit:cover;border-radius:0.5rem">
    <% else %>
      <div class="d-flex align-items-center justify-content-center" style="width:80px;height:80px;border-radius:0.5rem;background:linear-gradient(135deg, <%= @theme.preview_color || '#6366f1' %> 0%, #1e1e2e 100%)">
        <i class="bi bi-brush text-white" style="font-size:1.5rem;opacity:0.6"></i>
      </div>
    <% end %>
    <div>
      <h6 class="fw-semibold mb-1">
        <%= @theme.builtin_default? ? t('admin.ui.m542') : @theme.name %>
        <% if @theme.builtin_default? %><span class="badge bg-secondary ms-1" style="font-size:0.65rem"><%= @theme.name %></span><% end %>
        <% if @theme.active? %><span class="badge bg-success ms-1" style="font-size:0.65rem"><%= t('admin.in_use') %></span><% end %>
      </h6>
      <div class="text-muted" style="font-size:0.78rem">
        v<%= @theme.version %>
        <% if @theme.author.present? %> · <%= @theme.author %><% end %>
        <% if @theme.description.present? %> · <%= @theme.description %><% end %>
      </div>
    </div>
  </div>
</div>

<!-- 主题设置 -->
<%= form_with url: admin_theme_path(@theme), method: :patch, local: true do |f| %>
  <div class="card card-admin mb-4">
    <div class="card-header py-3">
      <h6 class="mb-0 fw-bold"><i class="bi bi-sliders me-2 text-primary"></i><%= t('admin.ui.m200') %></h6>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label fw-semibold small"><%= t('admin.ui.m1022') %></label>
          <select name="settings[topic_list_style]" class="form-select form-select-sm">
            <option value="article" <%= "selected" if @theme.topic_list_style != "image_text" %>><%= t('admin.ui.m1023') %></option>
            <option value="image_text" <%= "selected" if @theme.topic_list_style == "image_text" %>><%= t('admin.ui.m1024') %></option>
          </select>
          <div class="form-text small"><%= t('admin.ui.m1025') %></div>
        </div>
      </div>
    </div>
    <div class="card-footer py-2 text-end">
      <button type="submit" class="btn btn-sm btn-primary">
        <i class="bi bi-check-lg me-1"></i><%= t('admin.ui.m002') %>
      </button>
    </div>
  </div>
<% end %>
