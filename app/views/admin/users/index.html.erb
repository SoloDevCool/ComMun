<style>
  .user-stat-chip {
    display: inline-flex; align-items: center; gap: 8px;
    background: #fff; border: 1px solid #e4e7ec; border-radius: 999px;
    padding: 6px 16px; font-size: .8rem; color: #475569;
    box-shadow: 0 1px 2px rgba(16,24,40,.05);
  }
  .user-stat-chip i { font-size: .95rem; }
  .user-stat-chip strong { color: #1f2937; font-variant-numeric: tabular-nums; }
  /* 分段筛选 */
  .user-filter-tabs {
    display: inline-flex; background: #f1f5f9; border-radius: 999px; padding: 3px; gap: 2px;
  }
  .user-filter-tabs a {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 16px; border-radius: 999px;
    font-size: .82rem; font-weight: 500; color: #64748b;
    text-decoration: none; transition: all .15s;
  }
  .user-filter-tabs a:hover { color: #1f2937; }
  .user-filter-tabs a.active {
    background: #fff; color: #155eef; font-weight: 600;
    box-shadow: 0 1px 3px rgba(0,0,0,.1);
  }
  .user-filter-tabs .count-pill {
    font-size: .68rem; padding: 0 8px; background: #e2e8f0; color: #64748b;
  }
  .user-filter-tabs a.active .count-pill { background: rgba(21,94,239,.1); color: #155eef; }
  /* 搜索框 */
  .user-search .input-group {
    border: 1px solid #e4e7ec; border-radius: 999px; overflow: hidden;
    background: #fff; transition: border-color .15s, box-shadow .15s;
    width: 260px;
  }
  .user-search .input-group:focus-within {
    border-color: #155eef; box-shadow: 0 0 0 3px rgba(21,94,239,.1);
  }
  .user-search .form-control {
    border: none; box-shadow: none; font-size: .85rem; padding-left: 14px;
  }
  .user-search .form-control:focus { border: none; box-shadow: none; }
  .user-search .btn { border: none; color: #64748b; }
  .user-search .btn:hover { color: #155eef; background: transparent; }
  /* 表格 */
  .user-avatar-dot {
    width: 34px; height: 34px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 600; font-size: .8rem; flex-shrink: 0;
  }
  .users-table { --bs-table-hover-bg: rgba(99,102,241,.04); }
  .users-table .user-cell-name { font-weight: 500; color: #1f2937; font-size: .875rem; }
  .users-table .user-cell-sub { font-size: .72rem; color: #94a3b8; }
  .users-table td { font-size: .875rem; }
  .role-select {
    border-radius: 8px; font-size: .8rem; min-height: 30px; padding-top: 3px; padding-bottom: 3px;
    transition: border-color .15s, box-shadow .15s;
  }
  .role-select:focus { border-color: #155eef; box-shadow: 0 0 0 3px rgba(21,94,239,.1); }
  .users-empty { padding: 56px 20px; text-align: center; }
  .users-empty i { font-size: 2rem; color: #cbd5e1; }
  tr.row-banned { background: rgba(220,53,69,.04); }
  tr.row-banned:hover { background: rgba(220,53,69,.07) !important; }
  /* 封禁弹窗 */
  #banModal .modal-content { border: none; border-radius: 14px; box-shadow: 0 20px 50px rgba(0,0,0,.2); }
  #banModal .modal-header { border-bottom: 1px solid #f2f4f7; }
  #banModal .modal-body, #banModal .modal-footer { padding: 1.25rem; }
  #banModal .form-select, #banModal .form-control { border-radius: 9px; transition: border-color .15s, box-shadow .15s; }
  #banModal .form-select:focus, #banModal .form-control:focus {
    border-color: #dc3545; box-shadow: 0 0 0 3px rgba(220,53,69,.1);
  }
</style>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <div>
    <h4 class="mb-0 admin-page-title"><%= t('admin.ui.m459') %></h4>
    <div class="admin-page-subtitle"><i class="bi bi-people me-1"></i>管理用户角色、状态与权限</div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <span class="user-stat-chip"><i class="bi bi-people text-primary"></i>总用户 <strong><%= User.real_users.count %></strong></span>
    <span class="user-stat-chip"><i class="bi bi-shield-lock text-danger"></i>封禁中 <strong><%= User.real_users.banned.count %></strong></span>
  </div>
</div>

<div class="card card-admin mb-4">
  <div class="card-body py-2">
    <div class="d-flex gap-3 flex-wrap align-items-center justify-content-between">
      <div class="user-filter-tabs">
        <%= link_to admin_users_path(status: "all", q: @q), class: @status == "all" ? "active" : "" do %>
          <i class="bi bi-people"></i><%= t('admin.ui.m460') %>
        <% end %>
        <%= link_to admin_users_path(status: "banned", q: @q), class: @status == "banned" ? "active" : "" do %>
          <i class="bi bi-shield-lock"></i><%= t('admin.ui.m461') %>
          <span class="count-pill"><%= User.real_users.banned.count %></span>
        <% end %>
      </div>
      <form class="user-search" method="get" action="<%= admin_users_path %>">
        <input type="hidden" name="status" value="<%= @status %>">
        <div class="input-group">
          <input type="text" name="q" value="<%= @q %>" class="form-control" placeholder="<%= t('admin.ui.m411') %>">
          <% if @q.present? %>
            <%= link_to admin_users_path(status: @status), class: "btn", title: t("admin.clear_search") do %>
              <i class="bi bi-x-lg"></i>
            <% end %>
          <% end %>
          <button type="submit" class="btn"><i class="bi bi-search"></i></button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="card card-admin">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle users-table mb-0">
        <thead>
          <tr>
            <th class="ps-3"><%= t('admin.username') %></th>
            <th class="d-none d-md-table-cell"><%= t('admin.ui.m412') %></th>
            <th class="d-none d-lg-table-cell"><%= t('admin.status') %></th>
            <th class="d-none d-lg-table-cell"><%= t('admin.registered_at') %></th>
            <th class="pe-3 text-end"><%= t('admin.actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr id="user-<%= user.id %>" class="<%= 'row-banned' if user.banned? %>">
              <td class="ps-3">
                <div class="d-flex align-items-center gap-2">
                  <span class="user-avatar-dot" style="background: <%= ['#6366f1','#0ea5e9','#10b981','#f59e0b','#ef4444'][user.id % 5] %>">
                    <%= user.display_name[0].upcase %>
                  </span>
                  <div class="min-w-0">
                    <div class="user-cell-name">
                      <%= user.display_name %>
                      <% if user == current_user %>
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill ms-1" style="font-size:.62rem"><%= t('admin.ui.m413') %></span>
                      <% end %>
                    </div>
                    <div class="user-cell-sub d-md-none"><%= user.email %></div>
                  </div>
                </div>
              </td>
              <td class="d-none d-md-table-cell">
                <span class="badge <%= user.role_badge_class %> rounded-pill"><%= user.role_label %></span>
                <div class="user-cell-sub mt-1"><%= user.email %></div>
              </td>
              <td class="d-none d-lg-table-cell">
                <% if user.banned? %>
                  <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill"
                        title="<%= user.ban_reason.presence || t('admin.ui.m414') %><% if user.banned_by %> · <%= t('admin.ui.m415') %> <%= user.banned_by.display_name %><% end %>">
                    <i class="bi bi-shield-lock-fill me-1"></i><%= t('admin.ui.m416') %><%= user.ban_remaining_time %>)
                  </span>
                <% else %>
                  <span class="badge bg-success bg-opacity-10 text-success rounded-pill">
                    <i class="bi bi-check-circle me-1"></i><%= t('admin.ui.m417') %>
                  </span>
                <% end %>
              </td>
              <td class="d-none d-lg-table-cell text-muted"><small><%= user.created_at.strftime("%Y-%m-%d") %></small></td>
              <td class="pe-3 text-end">
                <% unless user == current_user %>
                  <div class="d-flex gap-1 justify-content-end align-items-center flex-wrap">
                    <form method="post" action="<%= admin_user_path(user) %>" style="display:inline" onsubmit="return confirm('<%= t('admin.ui.m248') %> <%= user.email %> <%= t('admin.ui.m418') %>' + this.elements['role'].selectedOptions[0].text + '吗？')">
                      <input type="hidden" name="_method" value="patch">
                      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                      <select name="role" class="form-select form-select-sm role-select" style="width:auto;display:inline-block" onchange="this.closest('form').submit()">
                        <% Role.order(:level, :id).each do |r| %>
                          <option value="<%= r.key %>" <%= "selected" if user.role == r.key %>><%= r.name %></option>
                        <% end %>
                      </select>
                    </form>
                    <% if user.student? %>
                      <%= link_to admin_user_node_memberships_path(user),
                        class: "btn btn-sm btn-outline-success rounded-pill",
                        title: t('admin.ui.m421') do %>
                        <i class="bi bi-grid-3x3 me-1"></i><%= t('admin.ui.m422') %>
                      <% end %>
                    <% end %>
                    <% if Plugin.enabled?("courses") %>
                      <%= link_to admin_user_course_permissions_path(user),
                        class: "btn btn-sm btn-outline-info rounded-pill",
                        title: t('admin.ui.m423') do %>
                        <i class="bi bi-play-circle me-1"></i><%= t('admin.ui.m424') %>
                      <% end %>
                    <% end %>
                    <% if user.banned? %>
                      <%= button_to unban_admin_user_path(user, status: @status), method: :post,
                        class: "btn btn-sm btn-outline-success rounded-pill",
                        title: t('admin.ui.m425'),
                        data: { confirm: "确定要解封用户 #{user.email} 吗？" } do %>
                        <i class="bi bi-unlock me-1"></i><%= t('admin.ui.m427') %>
                      <% end %>
                    <% else %>
                      <button type="button" class="btn btn-sm btn-outline-danger rounded-pill" data-bs-toggle="modal" data-bs-target="#banModal" onclick="openBanModal('<%= user.email %>', '<%= ban_admin_user_path(user, status: @status) %>', '<%= form_authenticity_token %>')">
                        <i class="bi bi-lock me-1"></i><%= t('admin.ui.m428') %>
                      </button>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-muted small">-</span>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @users.empty? %>
            <tr>
              <td colspan="5">
                <div class="users-empty">
                  <i class="bi bi-people d-block mb-2"></i>
                  <div class="fw-semibold" style="color:#475569"><%= @q.present? ? "未找到匹配的用户" : "暂无用户" %></div>
                  <% if @q.present? %>
                    <div class="text-muted small mt-1">试试其他关键词，或
                      <%= link_to "清除搜索", admin_users_path(status: @status), class: "text-decoration-none" %>
                    </div>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if @pagy.last > 1 %>
<div class="mt-3 d-flex justify-content-center">
  <%== @pagy.series_nav(:bootstrap) %>
</div>
<% end %>

<!-- <%= t('admin.ui.m428') %>弹窗 -->
<div class="modal fade" id="banModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fs-6 fw-bold"><i class="bi bi-shield-lock me-2 text-danger"></i><%= t('admin.ui.m429') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="banForm" method="post">
        <div class="modal-body">
          <p class="text-muted mb-3 small"><%= t('admin.ui.m430') %><strong id="banUserEmail" class="text-dark"></strong></p>
          <div class="mb-3">
            <label for="banDuration" class="form-label fw-semibold small"><%= t('admin.ui.m431') %></label>
            <select id="banDuration" name="duration" class="form-select" required>
              <option value="1d">1 <%= t('admin.ui.m003') %></option>
              <option value="3d">3 <%= t('admin.ui.m003') %></option>
              <option value="7d" selected>7 <%= t('admin.ui.m003') %></option>
              <option value="15d">15 <%= t('admin.ui.m003') %></option>
              <option value="30d">30 <%= t('admin.ui.m003') %></option>
              <option value="90d">90 <%= t('admin.ui.m003') %></option>
              <option value="permanent" class="text-danger"><%= t('admin.ui.m432') %></option>
            </select>
          </div>
          <div class="mb-0">
            <label for="banReason" class="form-label fw-semibold small"><%= t('admin.ui.m433') %></label>
            <textarea id="banReason" name="reason" class="form-control" rows="3" placeholder="<%= t('admin.ui.m434') %>"></textarea>
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal"><%= t('admin.cancel') %></button>
          <button type="submit" class="btn btn-danger rounded-pill px-3" onclick="return confirm('<%= t('admin.ui.m435') %>')">
            <i class="bi bi-lock me-1"></i><%= t('admin.ui.m436') %>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function openBanModal(email, actionUrl, token) {
  document.getElementById('banUserEmail').textContent = email;
  var form = document.getElementById('banForm');
  form.action = actionUrl;
  // 确保 token input 存在
  var tokenInput = form.querySelector('input[name="authenticity_token"]');
  if (!tokenInput) {
    tokenInput = document.createElement('input');
    tokenInput.type = 'hidden';
    tokenInput.name = 'authenticity_token';
    form.appendChild(tokenInput);
  }
  tokenInput.value = token;
  // 重置表单
  document.getElementById('banDuration').value = '7d';
  document.getElementById('banReason').value = '';
}
</script>
