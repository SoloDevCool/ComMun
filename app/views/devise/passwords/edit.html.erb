<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h2 class="text-center mb-4"><%= t('.title') %></h2>
          <p class="text-center text-muted mb-4" style="font-size:0.9rem"><%= t('.description') %></p>

          <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "needs-validation" }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>
            <%= f.hidden_field :reset_password_token %>

            <div class="mb-3">
              <%= f.label :password, t('.new_password'), class: "form-label" %>
              <% if @minimum_password_length %>
                <small class="text-muted"><%= t('devise.registrations.min_characters', count: @minimum_password_length) %></small>
              <% end %>
              <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control", placeholder: t('.new_password_placeholder') %>
            </div>

            <div class="mb-3">
              <%= f.label :password_confirmation, t('.confirm_new_password'), class: "form-label" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: t('.confirm_new_password_placeholder') %>
            </div>

            <div class="d-grid">
              <%= f.submit t('.submit'), class: "btn btn-primary" %>
            </div>
          <% end %>

          <hr>
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
