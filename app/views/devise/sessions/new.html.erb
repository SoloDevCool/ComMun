<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h2 class="text-center mb-4"><%= t('.title') %></h2>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="mb-3">
              <%= f.label :email, t('.email_or_username'), class: "form-label" %>
              <%= f.text_field :email, autofocus: true, autocomplete: "username", class: "form-control", placeholder: t('.email_or_username_placeholder') %>
            </div>

            <div class="mb-3">
              <%= f.label :password, t('.password'), class: "form-label" %>
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: t('.password_placeholder') %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="mb-3 form-check">
                <%= f.check_box :remember_me, class: "form-check-input" %>
                <%= f.label :remember_me, t('.remember_me'), class: "form-check-label" %>
              </div>
            <% end %>

            <div class="d-grid">
              <%= f.submit t('.submit'), class: "btn btn-primary" %>
            </div>
          <% end %>

          <% oauth_buttons = render_plugin_injections("login_oauth_buttons") %>
          <% if oauth_buttons.present? %>
            <div class="d-grid mt-3">
              <div class="text-center text-muted small mb-2"><%= t('.or') %></div>
              <%= oauth_buttons %>
            </div>
          <% end %>

          <hr class="mt-3">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
