<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t('layouts.admin.title', site_name: site_name) %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= site_name %> Admin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <% if site_favicon_url %>
      <link rel="icon" href="<%= site_favicon_url %>" type="image/png">
    <% else %>
      <link rel="icon" href="/icon.png" type="image/png">
    <% end %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script src="/echarts.min.js"></script>
    <style>
      body { background-color: #f4f6f9; }
      /* ===== Sidebar（黑白主题） ===== */
      .sidebar {
        height: 100vh; width: 260px; position: fixed; top: 0; left: 0; z-index: 1000;
        display: flex; flex-direction: column; overflow: hidden;
        background: linear-gradient(180deg, #0a0a0a 0%, #141414 60%, #1c1c1c 100%);
        transition: transform 0.3s ease;
      }
      .sidebar-brand { padding: 1.1rem 1rem; border-bottom: 1px solid rgba(255,255,255,.08); }
      .sidebar-brand .brand-icon {
        width: 34px; height: 34px; border-radius: 10px; flex-shrink: 0;
        background: #fff;
        display: inline-flex; align-items: center; justify-content: center;
        color: #000; font-size: 1.05rem;
        box-shadow: 0 3px 10px rgba(255,255,255,.12);
      }
      .sidebar .nav-link {
        color: rgba(255,255,255,.66);
        border-radius: 10px;
        margin-bottom: 2px;
        font-size: .875rem;
        padding: .5rem .75rem;
        display: flex; align-items: center;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        transition: background .15s, color .15s, transform .15s;
      }
      .sidebar .nav-link i { width: 22px; text-align: center; font-size: 1.02rem; transition: transform .15s, color .15s; }
      .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,.08); transform: translateX(2px); }
      .sidebar .nav-link:hover i { transform: scale(1.12); }
      .sidebar .nav-link.active {
        color: #000;
        font-weight: 600;
        background: #fff;
        box-shadow: 0 4px 14px rgba(255,255,255,.15);
      }
      .sidebar .nav-link.active i { transform: scale(1.08); color: #000; }
      .sidebar .nav-badge {
        font-size: .65rem; font-weight: 600;
        margin-left: auto;
        padding: 2px 8px; border-radius: 999px;
        background: #fff; color: #000;
      }
      .sidebar .nav-link.active .nav-badge { background: #000; color: #fff; }
      .sidebar .nav-group-title { color: rgba(255,255,255,.35); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; padding: 0.5rem 0.5rem; margin-top: 0.5rem; font-weight: 600; user-select: none; cursor: pointer; border-radius: 0.375rem; display: flex; align-items: center; justify-content: space-between; transition: color 0.15s; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .sidebar .nav-group-title:hover { color: rgba(255,255,255,.6); }
      .sidebar .nav-group-title::after { content: '\F282'; font-family: 'bootstrap-icons'; font-size: 0.65rem; transition: transform 0.2s; }
      .sidebar .nav-group-title.open::after { transform: rotate(180deg); }
      .sidebar .nav-group-title:first-child { margin-top: 0; }
      .sidebar .nav-group-items { overflow: hidden; max-height: 0; transition: max-height 0.3s ease; }
      .sidebar .nav-group-items.open { max-height: 2000px; }
      .sidebar .sidebar-nav-scroll { flex: 1 1 0%; min-height: 0; overflow-y: auto; flex-wrap: nowrap; padding: .75rem; }
      .sidebar .sidebar-nav-scroll::-webkit-scrollbar { width: 4px; }
      .sidebar .sidebar-nav-scroll::-webkit-scrollbar-track { background: transparent; }
      .sidebar .sidebar-nav-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,.18); border-radius: 4px; }
      .sidebar .sidebar-nav-scroll::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,.32); }
      .sidebar-footer { border-top: 1px solid rgba(255,255,255,.07); }
      .sidebar-footer .nav-link { color: rgba(255,255,255,.5); }
      .sidebar-footer .nav-link:hover { color: #fff; background: rgba(255,255,255,.06); transform: none; }
      .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 999; }
      .sidebar-overlay.show { display: block; }
      .main-content { margin-left: 260px; min-height: 100vh; }
      .stat-card { border: none; border-radius: 14px; transition: transform 0.18s, box-shadow 0.18s; }
      .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,.08); }
      .stat-card .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; transition: transform 0.18s; }
      .stat-card:hover .stat-icon { transform: scale(1.08); }
      .stat-value { font-size: 1.5rem; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; color: #1f2937; }
      .stat-label { font-size: 0.78rem; margin-bottom: 2px; }
      .card-admin { border: none; border-radius: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.08); transition: box-shadow 0.18s; }
      .card-admin:hover { box-shadow: 0 4px 14px rgba(0,0,0,.1); }
      .card-admin .card-header { background: #fff; border-bottom: 1px solid #eee; border-radius: 12px 12px 0 0 !important; }
      .card-admin .table { --bs-table-hover-bg: rgba(99,102,241,.04); }
      .table th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: .5px; color: #6c757d; font-weight: 600; border-bottom-width: 1px; }
      .table td { vertical-align: middle; font-size: 0.9rem; }
      .btn-action { width: 34px; height: 34px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; transition: background 0.12s; }
      .btn-action:hover { transform: scale(1.05); }
      /* Page header */
      .admin-page-title { font-weight: 700; color: #1f2937; letter-spacing: -0.01em; }
      .admin-page-subtitle { font-size: 0.82rem; color: #9ca3af; margin-top: 2px; }
      /* Avatar dot (recent users) */
      .user-avatar-dot { width: 32px; height: 32px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: #fff; font-weight: 600; font-size: 0.8rem; flex-shrink: 0; }
      /* Count pill */
      .count-pill { display: inline-block; min-width: 34px; text-align: center; font-size: 0.75rem; font-weight: 600; color: #475569; background: #f1f5f9; border-radius: 999px; padding: 2px 10px; }
      /* Segmented map toggle */
      .seg-control { display: inline-flex; background: #f1f5f9; border-radius: 999px; padding: 3px; gap: 2px; }
      .seg-control .btn { border: none; border-radius: 999px; padding: 3px 16px; font-size: 0.8rem; color: #64748b; background: transparent; transition: all 0.15s; }
      .seg-control .btn:hover { color: #1f2937; }
      .seg-control .btn.active { background: #fff; color: #0d6efd; font-weight: 600; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
      @media (max-width: 991.98px) {
        .sidebar { transform: translateX(-100%); }
        .sidebar.show { transform: translateX(0); }
        .main-content { margin-left: 0; }
      }
    </style>
  </head>

  <body>
    <!-- Sidebar -->
    <div class="sidebar" id="adminSidebar">
      <div class="sidebar-brand flex-shrink-0">
        <a href="/" class="text-white text-decoration-none d-flex align-items-center gap-2" title="<%= t('layouts.admin.back_to_site') %>">
          <span class="brand-icon"><i class="bi bi-terminal"></i></span>
          <% if site_logo_url %>
            <img src="<%= site_logo_url %>" alt="Logo" style="max-height: 26px; max-width: 150px; object-fit: contain;">
          <% else %>
            <span class="fs-6 fw-bold"><%= site_name %></span>
          <% end %>
        </a>
        <div class="text-white-50 mt-2" style="font-size:0.72rem"><%= t('layouts.admin.subtitle') %></div>
      </div>
      <nav class="nav flex-column p-3 mt-1 sidebar-nav-scroll">
        <% if current_user.admin? %>
        <div class="nav-group-title <%= 'open' if ['dashboard','login_logs','cps_ad_click_logs'].include?(controller_name) %>"><%= t('layouts.admin.group_overview') %></div>
        <div class="nav-group-items <%= 'open' if ['dashboard','login_logs','cps_ad_click_logs'].include?(controller_name) %>">
        <%= link_to admin_root_path, class: "nav-link #{controller_name == 'dashboard' ? 'active' : ''}" do %>
          <i class="bi bi-grid-1x2 me-2"></i><%= t('layouts.admin.nav_dashboard') %>
        <% end %>
        <%= link_to admin_login_logs_path, class: "nav-link #{controller_name == 'login_logs' ? 'active' : ''}" do %>
          <i class="bi bi-clock-history me-2"></i><%= t('layouts.admin.nav_login_logs') %>
        <% end %>
        <%= link_to admin_cps_ad_click_logs_path, class: "nav-link #{controller_name == 'cps_ad_click_logs' ? 'active' : ''}" do %>
          <i class="bi bi-megaphone me-2"></i><%= t('layouts.admin.nav_cps_ad_click_logs') %>
        <% end %>
        </div>

        <div class="nav-group-title <%= 'open' if ['users','roles','operational_accounts','user_emails'].include?(controller_name) %>"><%= t('layouts.admin.group_users') %></div>
        <div class="nav-group-items <%= 'open' if ['users','roles','operational_accounts','user_emails'].include?(controller_name) %>">
        <%= link_to admin_users_path, class: "nav-link #{controller_name == 'users' ? 'active' : ''}" do %>
          <i class="bi bi-people me-2"></i><%= t('layouts.admin.nav_users') %>
        <% end %>
        <%= link_to admin_roles_path, class: "nav-link #{controller_name == 'roles' ? 'active' : ''}" do %>
          <i class="bi bi-person-gear me-2"></i><%= t('admin.roles.title') %>
        <% end %>
        <%= link_to admin_operational_accounts_path, class: "nav-link #{controller_name == 'operational_accounts' ? 'active' : ''}" do %>
          <i class="bi bi-person-badge me-2"></i><%= t('layouts.admin.nav_operational_accounts') %>
        <% end %>
        <%= link_to admin_user_emails_path, class: "nav-link #{controller_name == 'user_emails' ? 'active' : ''}" do %>
          <i class="bi bi-envelope me-2"></i><%= t('layouts.admin.nav_user_emails') %>
        <% end %>
        </div>
        <% end %>

        <div class="nav-group-title <%= 'open' if ['topic_operations','auto_topics','comment_operations','auto_comments','nodes','moderations'].include?(controller_name) %>"><%= t('layouts.admin.group_content') %></div>
        <div class="nav-group-items <%= 'open' if ['topic_operations','auto_topics','comment_operations','auto_comments','nodes','moderations'].include?(controller_name) %>">
        <% pending_count = Topic.moderation_pending.count + Comment.moderation_pending.count %>
        <%= link_to admin_moderations_path, class: "nav-link #{controller_name == 'moderations' ? 'active' : ''}" do %>
          <i class="bi bi-shield-check me-2"></i><%= t('layouts.admin.nav_moderations') %><% if pending_count > 0 %><span class="nav-badge"><%= pending_count %></span><% end %>
        <% end %>
        <%= link_to admin_nodes_path, class: "nav-link #{controller_name == 'nodes' ? 'active' : ''}" do %>
          <i class="bi bi-diagram-3 me-2"></i><%= t('layouts.admin.nav_nodes') %>
        <% end %>
        <%= link_to admin_topic_operations_path, class: "nav-link #{controller_name == 'topic_operations' ? 'active' : ''}" do %>
          <i class="bi bi-megaphone me-2"></i><%= t('layouts.admin.nav_topic_operations') %>
        <% end %>
        <%= link_to admin_comment_operations_path, class: "nav-link #{controller_name == 'comment_operations' ? 'active' : ''}" do %>
          <i class="bi bi-chat-dots me-2"></i><%= t('layouts.admin.nav_comment_operations') %>
        <% end %>
        <%= link_to admin_auto_topics_path, class: "nav-link #{controller_name == 'auto_topics' ? 'active' : ''}" do %>
          <i class="bi bi-cpu me-2"></i><%= t('layouts.admin.nav_auto_topics') %>
        <% end %>
        <%= link_to admin_auto_comments_path, class: "nav-link #{controller_name == 'auto_comments' ? 'active' : ''}" do %>
          <i class="bi bi-chat-square-text me-2"></i><%= t('layouts.admin.nav_auto_comments') %>
        <% end %>
        </div>

        <%# 课程管理导航已迁移至 courses 插件（通过插件注册的后台导航项渲染） %>

        <div class="nav-group-title <%= 'open' if ['friend_links','invitation_codes'].include?(controller_name) %>"><%= t('layouts.admin.group_community') %></div>
        <div class="nav-group-items <%= 'open' if ['friend_links','invitation_codes'].include?(controller_name) %>">
        <%= link_to admin_friend_links_path, class: "nav-link #{controller_name == 'friend_links' ? 'active' : ''}" do %>
          <i class="bi bi-link-45deg me-2"></i><%= t('layouts.admin.nav_friend_links') %>
        <% end %>
        <%# 邀请码管理入口由 invitation_codes 插件提供 %>
        <% if Plugin.enabled?("invitation_codes") %>
        <%= link_to admin_invitation_codes_path, class: "nav-link #{controller_name == 'invitation_codes' ? 'active' : ''}" do %>
          <i class="bi bi-key me-2"></i><%= t('layouts.admin.nav_invitation_codes') %>
        <% end %>
        <% end %>
        </div>

        <%# 题库管理导航已迁移至 question_banks 插件（通过插件注册的后台导航项渲染） %>

        <% if current_user.admin? %>
        <div class="nav-group-title <%= 'open' if ['settings','seo_settings','appearance_settings'].include?(controller_name) %>"><%= t('layouts.admin.group_settings') %></div>
        <div class="nav-group-items <%= 'open' if ['settings','seo_settings','appearance_settings'].include?(controller_name) %>">
        <%= link_to admin_settings_path, class: "nav-link #{controller_name == 'settings' ? 'active' : ''}" do %>
          <i class="bi bi-gear me-2"></i><%= t('layouts.admin.nav_settings') %>
        <% end %>
        <%= link_to admin_seo_settings_path, class: "nav-link #{controller_name == 'seo_settings' ? 'active' : ''}" do %>
          <i class="bi bi-search me-2"></i><%= t('layouts.admin.nav_seo_settings') %>
        <% end %>
        <%= link_to admin_appearance_settings_path, class: "nav-link #{controller_name == 'appearance_settings' ? 'active' : ''}" do %>
          <i class="bi bi-palette me-2"></i><%= t('layouts.admin.nav_appearance_settings') %>
        <% end %>
        </div>

        <div class="nav-group-title <%= 'open' if %w[plugins plugin_center themes].include?(controller_name) %>"><%= t('layouts.admin.group_extensions') %></div>
        <div class="nav-group-items <%= 'open' if %w[plugins plugin_center themes].include?(controller_name) %>">
        <%= link_to admin_plugins_path, class: "nav-link #{controller_name == 'plugins' ? 'active' : ''}" do %>
          <i class="bi bi-box-seam me-2"></i><%= t('layouts.admin.nav_plugins') %>
        <% end %>
        <%= link_to admin_themes_path, class: "nav-link #{controller_name == 'themes' ? 'active' : ''}" do %>
          <i class="bi bi-brush me-2"></i><%= t('layouts.admin.nav_themes') %>
        <% end %>
        <%= link_to admin_plugin_center_path, class: "nav-link #{controller_name == 'plugin_center' ? 'active' : ''}" do %>
          <i class="bi bi-shop me-2"></i><%= t('layouts.admin.nav_plugin_center') %>
        <% end %>
        </div>
        <% end %>

        <%# 插件注册的后台导航项 %>
        <% admin_plugin_navs = plugin_admin_nav_items %>
        <% if admin_plugin_navs.any? %>
        <%
          grouped = admin_plugin_navs.group_by { |item| item[:group] || t('layouts.admin.group_plugins') }
          grouped.each do |group_name, items| %>
        <div class="nav-group-title <%= 'open' if controller_name == 'honors' %>"><%= group_name %></div>
        <div class="nav-group-items <%= 'open' if controller_name == 'honors' %>">
        <% items.each do |nav_item| %>
          <%= link_to nav_item[:path], class: "nav-link" do %>
            <% if nav_item[:icon] %><i class="bi <%= nav_item[:icon] %> me-2"></i><% end %><%= nav_item[:label] %>
          <% end %>
        <% end %>
        </div>
        <% end %>
        <% end %>
      </nav>
      <div class="p-3 sidebar-footer flex-shrink-0">
        <a href="/" class="nav-link"><i class="bi bi-arrow-left me-2"></i><%= t('layouts.admin.back_to_site') %></a>
      </div>
    </div>

    <!-- Mobile Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Main Content -->
    <div class="main-content">
      <!-- Top Bar -->
      <nav class="navbar navbar-light bg-white shadow-sm px-3 px-lg-4 flex-nowrap">
        <button class="btn btn-link text-dark d-lg-none p-0 me-2 flex-shrink-0" id="sidebarToggle">
          <i class="bi bi-list fs-4"></i>
        </button>
        <span class="navbar-text text-muted text-truncate" style="font-size:0.85rem">
          <i class="bi bi-shield-check me-1"></i><%= t('layouts.admin.administrator') %>：<%= current_user.email %>
        </span>
      </nav>

      <div class="p-3 p-lg-4">
        <% if notice %>
          <div class="alert alert-success alert-dismissible fade show py-2" role="alert"><%= notice %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% end %>
        <% if alert %>
          <div class="alert alert-danger alert-dismissible fade show py-2" role="alert"><%= alert %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% end %>

        <%= yield %>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked@9.1.6/marked.min.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const sidebar = document.getElementById('adminSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const toggle = document.getElementById('sidebarToggle');
        if (toggle) {
          toggle.addEventListener('click', () => { sidebar.classList.add('show'); overlay.classList.add('show'); });
          overlay.addEventListener('click', () => { sidebar.classList.remove('show'); overlay.classList.remove('show'); });
        }
        document.querySelectorAll('.nav-group-title').forEach(title => {
          title.addEventListener('click', () => {
            const isOpen = title.classList.contains('open');
            document.querySelectorAll('.nav-group-title.open').forEach(t => {
              t.classList.remove('open');
              t.nextElementSibling.classList.remove('open');
            });
            if (!isOpen) {
              title.classList.add('open');
              title.nextElementSibling.classList.add('open');
            }
          });
        });
      });
    </script>
  </body>
</html>
