<!DOCTYPE html>
<html data-bs-theme="light">
  <head>
    <title><%= content_for(:title) || SiteSetting.get("seo_title", default: "#{site_name} - #{t('layouts.application.default_title_suffix')}") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= site_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% if content_for?(:head) %>
      <%= yield :head %>
      <%= render_plugin_injections("head") %>
    <% else %>
      <%= seo_meta_tags %>
      <%= render_plugin_injections("head") %>
    <% end %>
    <%= json_ld_website %>

    <% if SiteSetting.get("seo_google_verification").present? %>
      <meta name="google-site-verification" content="<%= SiteSetting.get("seo_google_verification") %>">
    <% end %>
    <% if SiteSetting.get("seo_bing_verification").present? %>
      <meta name="msvalidate.01" content="<%= SiteSetting.get("seo_bing_verification") %>">
    <% end %>
    <% if SiteSetting.get("seo_baidu_verification").present? %>
      <meta name="baidu-site-verification" content="<%= SiteSetting.get("seo_baidu_verification") %>">
    <% end %>

    <% clarity_id = SiteSetting.get("clarity_project_id") %>
    <% if clarity_id.present? %>
      <script>
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "<%= j(clarity_id) %>");
      </script>
    <% end %>

    <% if site_favicon_url %>
      <link rel="icon" href="<%= site_favicon_url %>" type="image/png">
      <link rel="apple-touch-icon" href="<%= site_favicon_url %>">
    <% else %>
      <link rel="icon" href="/icon.png" type="image/png">
      <link rel="icon" href="/icon.svg" type="image/svg+xml">
      <link rel="apple-touch-icon" href="/icon.png">
    <% end %>

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- html2canvas for poster generation -->
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <%
      active_theme = Theme.active_theme
      if active_theme
        theme_css = Rails.cache.fetch("active_theme_css", expires_in: 1.hour) do
          [active_theme.read_styles_css, active_theme.read_custom_css].compact.join("\n")
        end
        theme_dark_css = Rails.cache.fetch("active_theme_dark_css", expires_in: 1.hour) do
          active_theme.read_dark_css || ""
        end
    %>
    <% if theme_css.present? %>
    <style id="active-theme-styles">
      <%= safe_join([theme_css], "\n") %>
    </style>
    <% end %>
    <% if theme_dark_css.present? %>
    <style id="active-theme-dark-styles" media="screen and (prefers-color-scheme: dark)">
      <%= safe_join([theme_dark_css], "\n") %>
    </style>
    <% end %>
    <% end %>

    <script>
      // Apply theme immediately to prevent flash
      (function() {
        var theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-bs-theme', theme);
      })();
    </script>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg sticky-top shadow-sm">
      <div class="container-lg">
        <a class="navbar-brand d-flex align-items-center" href="/">
          <% case site_logo_display_mode %>
          <% when "logo" %>
            <% if site_logo_url %>
              <img src="<%= site_logo_url %>" alt="Logo" style="max-height: 32px; max-width: 160px; object-fit: contain;">
            <% else %>
              <%= site_name %>
            <% end %>
          <% when "icon_logo" %>
            <% if site_logo_url %>
              <img src="<%= site_logo_url %>" alt="Logo" style="max-height: 32px; max-width: 160px; object-fit: contain;" class="me-1">
            <% end %>
            <%= site_name %>
          <% else %>
            <i class="bi bi-terminal me-1"></i><%= site_name %>
          <% end %>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <%
              frontend_nav_modules = Admin::AppearanceSettingsController.nav_modules_for_frontend.select { |m| m[:key] == "community" }
              plugin_navs = plugin_nav_items
              # 仅当除「社区」外还有其他主菜单项时才显示「社区」入口，
              # 否则顶部导航只留品牌 Logo（点击 Logo 即进入社区首页）
              show_community_nav = plugin_navs.any? || frontend_nav_modules.size > 1
            %>
            <% if show_community_nav %>
              <% frontend_nav_modules.each do |mod| %>
                <li class="nav-item"><a class="nav-link fw-medium" href="<%= topics_path %>"><i class="bi <%= mod[:icon] %> me-1"></i><%= mod[:name] %></a></li>
              <% end %>
            <% end %>
            <%# 插件注册的前台导航项 %>
            <% plugin_navs.each do |nav_item| %>
              <li class="nav-item"><a class="nav-link fw-medium" href="<%= nav_item[:path] %>"><i class="bi <%= nav_item[:icon] %> me-1"></i><%= nav_item[:label] %></a></li>
            <% end %>
          </ul>

          <form class="d-flex me-3 search-form-desktop" role="search" action="<%= search_path %>" method="get" style="max-width:240px">
            <div class="input-group">
              <span class="input-group-text border-end-0"><i class="bi bi-search" style="font-size:0.85rem"></i></span>
              <input class="form-control form-control-sm border-start-0" type="search" name="q" placeholder="<%= t('layouts.application.search_placeholder') %>" aria-label="Search">
            </div>
          </form>

          <ul class="navbar-nav align-items-center">
            <!-- Desktop: search icon -->
            <li class="nav-item me-2 search-form-mobile-btn">
              <a href="<%= search_path %>" class="nav-link p-0" title="<%= t('layouts.application.search') %>"><i class="bi bi-search" style="font-size:1.15rem"></i></a>
            </li>
            <!-- Desktop: theme toggle -->
            <li class="nav-item me-2">
              <button class="theme-toggle d-none d-lg-block" id="themeToggle" title="<%= t('layouts.application.toggle_theme') %>">
                <i class="bi bi-sun-fill"></i>
              </button>
            </li>
            <% if user_signed_in? %>
              <!-- Desktop: notification dropdown -->
              <li class="nav-item me-2 d-none d-lg-block">
                <div class="dropdown">
                  <button class="btn btn-link nav-link p-0 position-relative" type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" id="notificationDropdownBtn">
                    <i class="bi bi-bell" style="font-size:1.1rem"></i>
                    <span id="notification-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.6rem;display:none">0</span>
                  </button>
                  <div class="dropdown-menu dropdown-menu-end p-0" style="width:340px;max-height:400px;overflow-y:auto" id="notificationDropdown" aria-labelledby="notificationDropdownBtn">
                    <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                      <span class="fw-bold" style="font-size:0.85rem"><i class="bi bi-bell me-1"></i><%= t('layouts.application.notifications') %></span>
                      <a href="<%= notifications_path %>" class="link-primary" style="font-size:0.75rem"><%= t('layouts.application.view_all') %></a>
                    </div>
                    <div id="notification-list" class="notification-dropdown-list">
                      <div class="text-center text-muted py-4" style="font-size:0.8rem" id="notification-loading">
                        <div class="spinner-border spinner-border-sm me-1"></div><%= t('layouts.application.loading') %>...
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            <% end %>
            <!-- Desktop: user dropdown -->
            <% if user_signed_in? %>
              <li class="nav-item dropdown d-none d-lg-block">
                <a class="user-dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" data-bs-offset="0,8">
                  <% if current_user.has_avatar? %>
                    <img src="<%= current_user.avatar_data_url %>" class="user-dropdown-avatar" alt="">
                  <% else %>
                    <span class="user-dropdown-avatar user-dropdown-avatar-empty"><i class="bi bi-person-fill"></i></span>
                  <% end %>
                  <span class="d-none d-sm-inline user-dropdown-name"><%= current_user.display_name %></span>
                  <span class="badge <%= current_user.role_badge_class %> user-dropdown-role" style="font-size:0.62rem">
                    <%= current_user.role_label %>
                  </span>
                  <i class="bi bi-chevron-down user-dropdown-chevron"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-end user-dropdown-menu" style="min-width:240px">
                  <div class="user-dropdown-body">
                    <div class="user-dropdown-item-wrap"><%= link_to profile_path, class: "user-dropdown-item" do %><i class="bi bi-person me-2"></i><%= t('layouts.application.profile') %><% end %></div>
                    <% if current_user.admin? %>
                      <div class="user-dropdown-item-wrap"><%= link_to admin_root_path, class: "user-dropdown-item" do %><i class="bi bi-speedometer2 me-2"></i><%= t('layouts.application.admin_panel') %><% end %></div>
                    <% end %>
                    <hr class="dropdown-divider">
                    <div class="user-dropdown-item-wrap">
                      <%= button_to destroy_user_session_path, method: :delete, class: "user-dropdown-item user-dropdown-item-danger" do %>
                        <i class="bi bi-box-arrow-right me-2"></i><%= t('layouts.application.log_out') %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </li>
            <% else %>
              <li class="nav-item d-none d-lg-block"><%= link_to new_user_session_path, class: "nav-link" do %><i class="bi bi-box-arrow-in-right me-1"></i><%= t('layouts.application.log_in') %><% end %></li>
              <li class="nav-item d-none d-lg-block"><%= link_to new_user_registration_path, class: "nav-link" do %><i class="bi bi-person-plus me-1"></i><%= t('layouts.application.sign_up') %><% end %></li>
            <% end %>
          </ul>

          <!-- Mobile-only section: shown below the main nav in collapsed state -->
          <div class="mobile-nav-footer d-lg-none">
            <% if user_signed_in? %>
            <div class="mobile-nav-user-info">
              <% if current_user.has_avatar? %>
                <img src="<%= current_user.avatar_data_url %>" class="rounded-3" style="width:32px;height:32px;object-fit:cover" alt="">
              <% else %>
                <i class="bi bi-person-circle" style="font-size:2rem"></i>
              <% end %>
              <div class="mobile-nav-user-detail">
                <div class="fw-semibold" style="font-size:0.88rem"><%= current_user.display_name %></div>
                <span class="badge <%= current_user.role_badge_class %>" style="font-size:0.6rem"><%= current_user.role_label %></span>
              </div>
            </div>
            <% end %>
            <a href="<%= search_path %>" class="mobile-nav-footer-item"><i class="bi bi-search"></i><%= t('layouts.application.search') %></a>
            <a href="<%= notifications_path %>" class="mobile-nav-footer-item"><i class="bi bi-bell"></i><%= t('layouts.application.notifications') %></a>
            <button class="mobile-nav-footer-item" id="themeToggleMobile"><i class="bi bi-moon-stars-fill"></i><%= t('layouts.application.toggle_theme') %></button>
            <% if user_signed_in? && (current_user.admin? || current_user.operator?) %>
            <a href="<%= admin_root_path %>" class="mobile-nav-footer-item"><i class="bi bi-gear"></i><%= t('layouts.application.admin_panel') %></a>
            <% end %>
            <% if user_signed_in? %>
              <a href="<%= profile_path %>" class="mobile-nav-footer-item"><i class="bi bi-person"></i><%= t('layouts.application.profile') %></a>
              <%= button_to destroy_user_session_path, method: :delete, class: "mobile-nav-footer-item text-danger" do %><i class="bi bi-box-arrow-right"></i><%= t('layouts.application.log_out') %><% end %>
            <% else %>
              <a href="<%= new_user_session_path %>" class="mobile-nav-footer-item"><i class="bi bi-box-arrow-in-right"></i><%= t('layouts.application.log_in') %></a>
              <a href="<%= new_user_registration_path %>" class="mobile-nav-footer-item"><i class="bi bi-person-plus"></i><%= t('layouts.application.sign_up') %></a>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="container-lg mt-3"><div class="alert alert-success alert-dismissible fade show py-2" role="alert"><%= notice %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div></div>
    <% end %>
    <% if alert %>
      <div class="container-lg mt-3"><div class="alert alert-danger alert-dismissible fade show py-2" role="alert"><%= alert %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div></div>
      <% end %>

    <%= yield %>

    <div class="mt-auto">
    <footer class="text-center text-muted py-4" style="font-size:0.85rem">
      <div class="container-lg">
        <% if SiteSetting.get("footer_text").present? %>
          <%= raw SiteSetting.get("footer_text") %>
        <% else %>
          <%= site_name %> <%= t('layouts.application.default_title_suffix') %> &copy; 2026 &middot; Built with Ruby on Rails
        <% end %>
      </div>
    </footer>

    <% if controller_name == 'topics' && action_name == 'index' %>
    <% active_friend_links = FriendLink.active.ordered %>
    <% if SiteSetting.get("friend_links_enabled", default: "false") == "true" && active_friend_links.any? %>
    <div class="py-3 border-top" style="font-size:0.85rem">
      <div class="container-lg">
        <div class="d-flex flex-wrap align-items-center justify-content-center gap-3">
          <span class="text-muted fw-semibold" style="white-space:nowrap"><%= t('layouts.application.friend_links') %>：</span>
          <% active_friend_links.each do |link| %>
            <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-muted" title="<%= link.description || link.name %>">
              <% if link.logo.present? %>
                <img src="<%= link.logo %>" alt="<%= link.name %>" style="width:20px;height:20px;border-radius:3px;object-fit:cover;vertical-align:middle;margin-right:3px;">
              <% end %>
              <%= link.name %>
            </a>
          <% end %>
        </div>
      </div>
    </div>
    <% end %>
    <% end %>
    </div>

    <% if SiteSetting.get("seo_footer_html").present? %>
      <%= raw SiteSetting.get("seo_footer_html") %>
    <% end %>

    <!-- Mobile Bottom Navigation -->
    <nav class="mobile-bottom-nav" id="mobileBottomNav">
      <a href="/" class="<%= controller_name == 'pages' && action_name == 'home' ? 'active' : '' %>">
        <i class="bi bi-house"></i>
        <span><%= t('layouts.application.home') %></span>
      </a>
      <a href="<%= topics_path %>" class="<%= controller_name == 'topics' ? 'active' : '' %>">
        <i class="bi bi-chat-square-text"></i>
        <span><%= t('layouts.application.community') %></span>
      </a>
      <% if user_signed_in? %>
        <a href="<%= new_topic_path %>" class="mobile-fab-create" style="margin-top:-18px">
          <div style="width:44px;height:44px;border-radius:50%;background:var(--bg-btn-primary);display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,0.2)">
            <i class="bi bi-plus-lg" style="font-size:1.3rem;color:var(--text-btn-primary)"></i>
          </div>
          <span><%= t('layouts.application.publish') %></span>
        </a>
        <a href="<%= notifications_path %>" class="<%= controller_name == 'notifications' ? 'active' : '' %>">
          <i class="bi bi-bell"></i>
          <span><%= t('layouts.application.messages') %></span>
        </a>
        <a href="<%= profile_path %>" class="<%= controller_name == 'profiles' ? 'active' : '' %>">
          <i class="bi bi-person"></i>
          <span><%= t('layouts.application.my') %></span>
        </a>
      <% else %>
        <a href="<%= topics_path(scope: 'trending') %>" class="<%= params[:scope] == 'trending' ? 'active' : '' %>">
          <i class="bi bi-fire"></i>
          <span><%= t('layouts.application.trending') %></span>
        </a>
        <a href="<%= new_user_session_path %>" class="">
          <i class="bi bi-box-arrow-in-right"></i>
          <span><%= t('layouts.application.log_in') %></span>
        </a>
      <% end %>
    </nav>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Marked.js for Markdown -->
    <script src="https://cdn.jsdelivr.net/npm/marked@9.1.6/marked.min.js"></script>

    <!-- Theme toggle script -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const toggleDesktop = document.getElementById('themeToggle');
        const toggleMobile = document.getElementById('themeToggleMobile');
        const html = document.documentElement;

        function getTheme() { return html.getAttribute('data-bs-theme'); }

        function updateIcons(theme) {
          if (toggleDesktop) {
            const icon = toggleDesktop.querySelector('i');
            icon.className = theme === 'dark' ? 'bi bi-moon-fill' : 'bi bi-sun-fill';
          }
          if (toggleMobile) {
            const icon = toggleMobile.querySelector('i');
            icon.className = theme === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
          }
        }

        updateIcons(getTheme());

        function doToggle() {
          const next = getTheme() === 'dark' ? 'light' : 'dark';
          html.setAttribute('data-bs-theme', next);
          localStorage.setItem('theme', next);
          updateIcons(next);
        }

        if (toggleDesktop) toggleDesktop.addEventListener('click', doToggle);
        if (toggleMobile) toggleMobile.addEventListener('click', doToggle);
      });
    </script>

    <% if user_signed_in? %>
    <style>
      .notification-dropdown-item{display:flex;align-items:flex-start;gap:8px;padding:8px 12px;border-bottom:1px solid var(--bs-border-color);transition:background .15s;text-decoration:none!important;color:var(--text-primary)!important}
      .notification-dropdown-item:hover{background-color:rgba(0,0,0,.03)}
      .notification-dropdown-item.unread{background-color:rgba(14,165,233,.05);border-left:3px solid #0ea5e9}
      .notification-dropdown-item.unread:hover{background-color:rgba(14,165,233,.1)}
      .notification-dropdown-item .ndi-icon{flex-shrink:0;padding-top:2px}
      .notification-dropdown-item .ndi-body{flex-grow:1;min-width:0}
      .notification-dropdown-item .ndi-text{font-size:0.8rem;line-height:1.4;color:var(--text-primary)}
      .notification-dropdown-item .ndi-time{font-size:0.7rem;color:#6b7280}
      [data-bs-theme="dark"] .notification-dropdown-item:hover{background-color:rgba(255,255,255,.04)}
      [data-bs-theme="dark"] .notification-dropdown-item.unread{background-color:#0c2d48;border-left-color:#38bdf8}
      [data-bs-theme="dark"] .notification-dropdown-item.unread:hover{background-color:#164e63}
    </style>
    <script>
    (function() {
      var badge = document.getElementById('notification-badge');
      var list = document.getElementById('notification-list');
      var loadingEl = document.getElementById('notification-loading');
      var dropdownBtn = document.getElementById('notificationDropdownBtn');
      var loaded = false;

      function updateBadge(count) {
        if (count > 0) {
          badge.textContent = count > 99 ? '99+' : count;
          badge.style.display = '';
        } else {
          badge.style.display = 'none';
        }
      }

      function fetchUnreadCount() {
        fetch('/notifications/unread_count', { credentials: 'same-origin' })
          .then(function(r) { return r.json(); })
          .then(function(d) { updateBadge(d.count); });
      }

      function fetchNotifications() {
        if (loaded) return;
        loaded = true;
        fetch('/notifications?per_page=10', { credentials: 'same-origin' })
          .then(function(r) { return r.text(); })
          .then(function(html) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(html, 'text/html');
            var items = doc.querySelectorAll('.notification-item');
            if (items.length === 0) {
              list.innerHTML = '<div class="text-center text-muted py-4" style="font-size:0.8rem"><i class="bi bi-bell-slash d-block mb-1" style="font-size:1.2rem"></i><%= j t('layouts.application.no_notifications') %></div>';
              return;
            }
            var fragment = '';
            items.forEach(function(item) {
              var icon = item.querySelector('i.bi');
              var link = item.querySelector('a[href]');
              var textEl = item.querySelector('.notification-item .flex-grow-1 > div:first-child');
              var timeEl = item.querySelector('.notification-item .text-muted');
              var isUnread = item.classList.contains('unread');
              var iconHtml = icon ? icon.outerHTML : '';
              var text = textEl ? textEl.textContent : '';
              var time = timeEl ? timeEl.textContent : '';
              var href = link ? link.getAttribute('href') : '#';
              var ndClass = isUnread ? 'notification-dropdown-item unread' : 'notification-dropdown-item';
              fragment += '<a href="' + href + '" class="' + ndClass + '">' +
                '<div class="ndi-icon">' + iconHtml + '</div>' +
                '<div class="ndi-body"><div class="ndi-text">' + text + '</div><div class="ndi-time">' + time + '</div></div>' +
                '</a>';
            });
            list.innerHTML = fragment;
          });
      }

      // Poll unread count every 30s
      fetchUnreadCount();
      setInterval(fetchUnreadCount, 30000);

      // Load notifications on dropdown open
      if (dropdownBtn) {
        var dropdownEl = dropdownBtn.closest('.dropdown');
        dropdownEl.addEventListener('shown.bs.dropdown', fetchNotifications);
      }
    })();
    </script>
    <% end %>
  </body>
</html>
