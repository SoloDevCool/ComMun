<% content_for :title, "#{current_user.display_name} - 个人中心 - #{site_name}" %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<div class="container-lg py-4">
  <div class="row g-4">
    <!-- 左栏 - 用户信息和统计数据 -->
    <div class="col-lg-4">
      <!-- 头像卡片 -->
      <div class="card border-0 shadow-sm rounded-3 mb-4 profile-card overflow-hidden">
        <div class="profile-card-banner"></div>
        <div class="card-body px-4 pb-4 pt-0">
          <div class="text-center mb-4">
            <div class="position-relative d-inline-block profile-avatar-wrap">
              <% if current_user.has_avatar? %>
                <img src="<%= current_user.avatar_data_url %>" class="profile-avatar" alt="头像">
              <% else %>
                <div class="profile-avatar bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center mx-auto" style="font-size:2.5rem">
                  <i class="bi bi-person-fill"></i>
                </div>
              <% end %>
              <label for="avatar_input" class="profile-avatar-edit" title="更换头像">
                <i class="bi bi-camera-fill"></i>
              </label>
              <%= form_with url: profile_path, method: :patch, local: true, multipart: true, class: "d-none" do |f| %>
                <input type="hidden" name="section" value="avatar">
                <%= f.file_field :avatar, name: "user[avatar]", id: "avatar_input", accept: "image/*",
                    onchange: "this.closest('form').requestSubmit()", style: "display:none" %>
              <% end %>
            </div>
            <h4 class="mt-3 mb-1 fw-bold profile-name"><%= current_user.display_name %></h4>
            <div class="text-muted small mb-2"><%= current_user.email %></div>
            <span class="badge <%= current_user.role_badge_class %> rounded-pill">
              <%= current_user.role_label %>
            </span>
            <%= official_badge(current_user) %>
          </div>

          <div class="row g-2 text-center mb-3 profile-stats">
            <div class="col-4">
              <a href="<%= profile_path(tab: 'topics') %>" class="profile-stat <%= 'active' if @tab == 'topics' %>">
                <div class="profile-stat-value"><%= current_user.topics.count %></div>
                <div class="profile-stat-label">主题</div>
              </a>
            </div>
            <div class="col-4">
              <a href="<%= profile_path(tab: 'following') %>" class="profile-stat <%= 'active' if @tab == 'following' %>">
                <div class="profile-stat-value"><%= current_user.following.count %></div>
                <div class="profile-stat-label">已关注</div>
              </a>
            </div>
            <div class="col-4">
              <a href="<%= profile_path(tab: 'followers') %>" class="profile-stat <%= 'active' if @tab == 'followers' %>">
                <div class="profile-stat-value"><%= current_user.followers.count %></div>
                <div class="profile-stat-label">粉丝</div>
              </a>
            </div>
            <div class="col-4">
              <a href="<%= profile_path(tab: 'blocked') %>" class="profile-stat profile-stat-danger <%= 'active' if @tab == 'blocked' %>">
                <div class="profile-stat-value"><%= current_user.blocked_users.count %></div>
                <div class="profile-stat-label">已屏蔽</div>
              </a>
            </div>
            <% if Plugin.enabled?("question_banks") %>
            <div class="col-4">
              <a href="<%= profile_path(tab: 'contributions') %>" class="profile-stat <%= 'active' if @tab == 'contributions' %>">
                <div class="profile-stat-value"><%= current_user.qb_questions.count %></div>
                <div class="profile-stat-label">贡献题目</div>
              </a>
            </div>
            <% end %>
            <div class="col-4">
              <a href="<%= profile_path(tab: 'favorites') %>" class="profile-stat <%= 'active' if @tab == 'favorites' %>">
                <div class="profile-stat-value"><%= current_user.favorites.count %></div>
                <div class="profile-stat-label">收藏</div>
              </a>
            </div>
          </div>

          <div class="profile-points-card mb-3">
            <div class="profile-points-value"><%= current_user.points %></div>
            <div class="profile-points-label"><i class="bi bi-lightning-charge-fill me-1"></i>酷能量</div>
          </div>

          <div class="text-center">
            <% if current_user.check_ins.exists?(checked_on: Date.current) %>
              <span class="profile-checked-in">
                <i class="bi bi-check-circle-fill me-1"></i>今日已签到
              </span>
            <% else %>
              <%= button_to check_in_path, method: :post, form: { data: { turbo: false } }, class: "btn btn-primary rounded-pill px-4" do %>
                <i class="bi bi-calendar-check me-1"></i>每日签到
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <!-- 隐私设置 -->
      <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header profile-card-header py-3 px-4">
          <h6 class="mb-0 fw-bold"><i class="bi bi-eye-slash me-2 text-secondary"></i>隐私设置</h6>
        </div>
        <div class="card-body p-4">
          <%= form_with url: profile_path, method: :patch, local: true do |f| %>
            <input type="hidden" name="section" value="privacy">
            <input type="hidden" name="user[profile_public]" value="0">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="profilePublicSwitch"
                name="user[profile_public]" value="1" <%= current_user.profile_public? ? "checked" : "" %>
                onchange="this.closest('form').requestSubmit()">
              <label class="form-check-label fw-semibold" for="profilePublicSwitch" style="font-size:0.9rem">
                公开我的主页
              </label>
              <div class="text-muted mt-1" style="font-size:0.8rem">
                关闭后，其他用户将无法查看你的个人主页，主题详情页中你的用户名也不可点击
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- 右栏 - 功能设置和内容 -->
    <div class="col-lg-8">

      <% if @tab == "favorites" %>
        <!-- 我的收藏 -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
          <div class="card-header profile-card-header py-3 px-4">
            <h6 class="mb-0 fw-bold">
              <i class="bi bi-star me-2 text-warning"></i>我的收藏
              <span class="text-muted fw-normal ms-1" style="font-size:0.8rem">共 <%= current_user.favorites.count %> 个主题</span>
            </h6>
          </div>
          <div class="card-body p-0">
            <% if @favorite_topics.present? %>
              <% @favorite_topics.each do |topic| %>
                <div class="profile-list-item d-flex align-items-center p-3 border-bottom">
                  <div class="flex-grow-1 min-w-0">
                    <%= link_to topic, class: "profile-topic-link text-decoration-none fw-semibold d-block" do %>
                      <%= topic.title %>
                    <% end %>
                    <div class="profile-item-meta">
                      <span class="badge bg-opacity-10 text-secondary rounded-pill" style="font-size:0.72rem">
                        <%= node_icon(topic.node, size: "0.85em") %> <%= topic.node.name %>
                      </span>
                      <span><%= time_ago_in_words(topic.created_at) %>前</span>
                      <span class="profile-item-dot"></span>
                      <span><i class="bi bi-eye me-1"></i><%= topic.views_count %></span>
                      <span class="profile-item-dot"></span>
                      <span><i class="bi bi-heart me-1"></i><%= topic.cools_count %></span>
                    </div>
                  </div>
                  <div class="flex-shrink-0 ms-2">
                    <%= button_to topic_favorite_path(topic), method: :delete, form: { data: { turbo: false } }, class: "btn btn-sm btn-outline-danger rounded-pill px-3", title: "取消收藏" do %>
                      <i class="bi bi-star-fill text-warning me-1"></i>取消收藏
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="profile-empty">
                <div class="profile-empty-icon"><i class="bi bi-star"></i></div>
                <div class="profile-empty-text">还没有收藏过主题</div>
                <div class="profile-empty-sub">浏览社区时点击收藏，喜欢的主题会出现在这里</div>
                <a href="<%= topics_path %>" class="btn btn-sm btn-primary rounded-pill px-3 mt-2">
                  <i class="bi bi-chat-square-text me-1"></i>去浏览
                </a>
              </div>
            <% end %>
          </div>
          <% if defined?(@pagy) && @pagy.last > 1 %>
            <div class="d-flex justify-content-center py-3 border-top">
              <%== @pagy.series_nav(:bootstrap) %>
            </div>
          <% end %>
        </div>

      <% elsif @tab == "contributions" %>
        <!-- 我的贡献 -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
          <div class="card-header profile-card-header py-3 px-4">
            <h6 class="mb-0 fw-bold">
              <i class="bi bi-journal-plus me-2 text-primary"></i>我的贡献
              <span class="text-muted fw-normal ms-1" style="font-size:0.8rem">共 <%= @contributions.size %> 道题目</span>
            </h6>
          </div>
          <div class="card-body p-0">
            <% @contributions.each do |q| %>
              <div class="profile-list-item d-flex align-items-center p-3 border-bottom">
                <div class="flex-grow-1 min-w-0">
                  <div class="fw-semibold text-dark d-block" style="font-size:0.9rem"><%= truncate(q.content, length: 60) %></div>
                  <div class="text-muted" style="font-size:0.78rem">
                    <span class="badge bg-opacity-10 rounded-pill" style="font-size:0.72rem;color:<%= q.qb_exam.color %>;background:<%= q.qb_exam.color %>15">
                      <%= q.qb_exam.name %>
                    </span>
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill ms-1" style="font-size:0.72rem"><%= q.question_type_label %></span>
                    <span class="ms-1"><%= time_ago_in_words(q.created_at) %>前</span>
                  </div>
                  <% if q.rejected? && q.rejection_reason.present? %>
                    <div class="text-danger mt-1" style="font-size:0.75rem">
                      <i class="bi bi-x-circle me-1"></i>拒绝原因：<%= q.rejection_reason %>
                    </div>
                  <% end %>
                </div>
                <div class="flex-shrink-0 ms-2">
                  <span class="badge rounded-pill <%= q.approved? ? 'bg-success bg-opacity-10 text-success' : q.rejected? ? 'bg-danger bg-opacity-10 text-danger' : 'bg-warning bg-opacity-10 text-dark' %>" style="font-size:0.75rem">
                    <%= q.status_label %>
                  </span>
                </div>
              </div>
            <% end %>
            <% if @contributions.empty? && Plugin.enabled?("question_banks") %>
              <div class="profile-empty">
                <div class="profile-empty-icon"><i class="bi bi-journal-plus"></i></div>
                <div class="profile-empty-text">还没有贡献过题目</div>
                <div class="profile-empty-sub">向题库贡献优质题目，帮助其他开发者学习成长</div>
                <a href="<%= question_banks_path %>" class="btn btn-sm btn-primary rounded-pill px-3 mt-2">
                  <i class="bi bi-plus-lg me-1"></i>去贡献
                </a>
              </div>
            <% end %>
          </div>
        </div>

      <% elsif @tab == "following" || @tab == "followers" || @tab == "blocked" %>
        <!-- 关注/粉丝列表 -->
        <div class="card border-0 shadow-sm rounded-3">
          <div class="card-header profile-card-header py-3 px-4">
            <h6 class="mb-0 fw-bold">
              <i class="bi <%= @tab == 'following' ? 'bi-people' : @tab == 'blocked' ? 'bi-slash-circle' : 'bi-person-heart' %> me-2 <%= @tab == 'blocked' ? 'text-danger' : 'text-primary' %>"></i>
              <%= @tab == 'following' ? '已关注' : @tab == 'blocked' ? '已屏蔽' : '我的粉丝' %>
              <span class="text-muted fw-normal ms-1" style="font-size:0.8rem">共 <%= @tab == 'following' ? current_user.following.count : @tab == 'blocked' ? current_user.blocked_users.count : current_user.followers.count %> 人</span>
            </h6>
          </div>
          <div class="card-body p-0">
            <% @users.each do |user| %>
              <div class="profile-list-item d-flex align-items-center p-3 border-bottom">
                <% if user.has_avatar? %>
                  <img src="<%= user.avatar_data_url %>" class="profile-user-avatar me-3 flex-shrink-0" alt="">
                <% else %>
                  <div class="profile-user-avatar profile-user-avatar-empty bg-avatar-<%= user.id % 5 + 1 %> me-3 flex-shrink-0">
                    <%= user_initial(user) %>
                  </div>
                <% end %>
                <div class="flex-grow-1 min-w-0">
                  <div class="fw-semibold text-dark"><%= user.display_name %></div>
                  <div class="text-muted" style="font-size:0.78rem">
                    <span class="badge <%= user.role_badge_class %> rounded-pill" style="font-size:0.65rem"><%= user.role_label %></span>
                    <span class="ms-1"><%= user.topics.count %> 主题</span>
                  </div>
                </div>
                <div class="flex-shrink-0 ms-2">
                  <% if @tab == "blocked" %>
                    <%= button_to unblock_user_path(user), method: :delete, form: { data: { turbo: false } }, class: "btn btn-sm btn-outline-danger rounded-pill px-3" do %>
                      <i class="bi bi-unlock me-1"></i>取消屏蔽
                    <% end %>
                  <% else %>
                    <% if current_user.following.include?(user) %>
                      <%= button_to unfollow_user_path(user), method: :delete, form: { data: { turbo: false } }, class: "btn btn-sm btn-outline-secondary rounded-pill px-3" do %>
                        <i class="bi bi-check-lg me-1"></i>已关注
                      <% end %>
                    <% else %>
                      <%= button_to follow_user_path(user), method: :post, form: { data: { turbo: false } }, class: "btn btn-sm btn-outline-primary rounded-pill px-3" do %>
                        <i class="bi bi-plus me-1"></i>关注
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
            <% if @users.empty? %>
              <div class="profile-empty">
                <div class="profile-empty-icon"><i class="bi <%= @tab == 'following' ? 'bi-people' : @tab == 'blocked' ? 'bi-slash-circle' : 'bi-person-heart' %>"></i></div>
                <div class="profile-empty-text"><%= @tab == 'following' ? '还没有关注任何人' : @tab == 'blocked' ? '没有屏蔽任何用户' : '还没有粉丝' %></div>
                <div class="profile-empty-sub"><%= @tab == 'followers' ? '积极发布主题和参与互动，吸引更多关注' : @tab == 'following' ? '去社区发现感兴趣的开发者并关注他们' : '屏蔽的用户将无法与你互动' %></div>
              </div>
            <% end %>
          </div>
          <!-- 分页 -->
          <% if @pagy.last > 1 %>
            <div class="d-flex justify-content-center py-3 border-top">
              <%== @pagy.series_nav(:bootstrap) %>
            </div>
          <% end %>
        </div>

      <% else %>

      <% if demo_mode? && current_user.admin? %>
      <div class="alert alert-warning rounded-3 mb-4 py-3 d-flex align-items-center">
        <i class="bi bi-info-circle-fill me-2 fs-5 flex-shrink-0"></i>
        <div>
          <div class="fw-bold mb-1">当前为演示站模式</div>
          <div class="text-muted" style="font-size:0.85rem">管理员账号不支持修改用户名和密码，感谢体验！</div>
        </div>
      </div>
      <% end %>

      <!-- 修改用户名 -->
      <% unless demo_mode? && current_user.admin? %>
      <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header profile-card-header py-3 px-4">
          <h6 class="mb-0 fw-bold"><i class="bi bi-person me-2 text-primary"></i>修改用户名</h6>
        </div>
        <div class="card-body p-4">
          <%= form_with url: profile_path, method: :patch, local: true, class: "needs-validation profile-form" do |f| %>
            <input type="hidden" name="section" value="username">

            <% if @username_error && current_user.errors.any? %>
              <div class="alert alert-danger rounded-3 py-2 mb-3">
                <i class="bi bi-exclamation-circle me-1"></i>
                <ul class="mb-0 ms-3">
                  <% current_user.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted">当前用户名</label>
              <div class="input-group">
                <span class="input-group-text">@</span>
                <input type="text" class="form-control rounded-3" value="<%= current_user.username %>" disabled>
              </div>
            </div>

            <div class="mb-3">
              <label for="usernameInput" class="form-label fw-semibold small text-muted">新用户名</label>
              <div class="input-group">
                <span class="input-group-text">@</span>
                <input type="text" name="user[username]" id="usernameInput" class="form-control rounded-3 <%= @username_error && current_user.errors[:username].any? ? 'is-invalid' : '' %>"
                  placeholder="2-20个字符，支持字母、数字、下划线和中文"
                  value="<%= @username_error && params[:user]&.dig(:username) ? params[:user][:username] : '' %>"
                  pattern="[a-zA-Z0-9_\u4e00-\u9fa5]{2,20}" required>
              </div>
              <div class="form-text">用户名可以包含字母、数字、下划线和中文，长度为 2-20 个字符</div>
              <div class="form-text text-info"><i class="bi bi-info-circle me-1"></i>用户名修改后，之前的@提及链接将失效</div>
            </div>

            <div class="text-end">
              <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-check-lg me-1"></i>更新用户名
              </button>
            </div>
          <% end %>
        </div>
      </div>
      <% end %>

      <!-- 修改密码 -->
      <% unless demo_mode? && current_user.admin? %>
      <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header profile-card-header py-3 px-4">
          <h6 class="mb-0 fw-bold"><i class="bi bi-shield-lock me-2 text-warning"></i>修改密码</h6>
        </div>
        <div class="card-body p-4">
          <%= form_with url: profile_path, method: :patch, local: true, class: "needs-validation profile-form" do |f| %>
            <input type="hidden" name="section" value="password">

            <% if @password_error && current_user.errors.any? %>
              <div class="alert alert-danger rounded-3 py-2 mb-3">
                <i class="bi bi-exclamation-circle me-1"></i>
                <ul class="mb-0 ms-3">
                  <% current_user.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label fw-semibold small text-muted">当前密码</label>
                <input type="password" name="user[current_password]" class="form-control rounded-3 <%= @password_error && current_user.errors[:current_password].any? ? 'is-invalid' : '' %>" placeholder="输入当前密码" required>
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold small text-muted">新密码</label>
                <input type="password" name="user[password]" class="form-control rounded-3 <%= @password_error && current_user.errors[:password].any? ? 'is-invalid' : '' %>" placeholder="至少6位" required>
                <div class="form-text">至少 6 个字符</div>
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold small text-muted">确认新密码</label>
                <input type="password" name="user[password_confirmation]" class="form-control rounded-3" placeholder="再次输入新密码" required>
              </div>
            </div>
            <div class="mt-3 text-end">
              <button type="submit" class="btn btn-warning rounded-pill px-4">
                <i class="bi bi-check-lg me-1"></i>更新密码
              </button>
            </div>
          <% end %>
        </div>
      </div>
      <% end %>

      <!-- 我的主题 -->
      <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header profile-card-header py-3 px-4">
          <h6 class="mb-0 fw-bold"><i class="bi bi-chat-square-text me-2 text-primary"></i>我的主题</h6>
        </div>
        <div class="card-body p-0">
          <% @topics.each do |topic| %>
            <div class="profile-list-item d-flex align-items-center p-3 border-bottom">
              <div class="flex-grow-1 min-w-0">
                <%= link_to topic, class: "text-dark text-decoration-none fw-semibold d-block" do %>
                  <%= topic.title %>
                <% end %>
                <div class="profile-item-meta">
                  <span class="badge bg-opacity-10 text-secondary rounded-pill" style="font-size:0.72rem">
                    <%= node_icon(topic.node, size: "0.85em") %> <%= topic.node.name %>
                  </span>
                  <span><%= time_ago_in_words(topic.created_at) %>前</span>
                  <span class="profile-item-dot"></span>
                  <span><i class="bi bi-eye me-1"></i><%= topic.views_count %></span>
                </div>
              </div>
              <div class="flex-shrink-0 ms-2 d-flex gap-1">
              <% if can_manage_topic?(topic) %>
                <%= link_to edit_topic_path(topic), class: "btn btn-sm btn-outline-secondary rounded-pill px-2" do %>
                  <i class="bi bi-pencil"></i>
                <% end %>
                <%= button_to topic, method: :delete, class: "btn btn-sm btn-outline-danger rounded-pill px-2",
                    data: { confirm: "确定删除？" } do %>
                  <i class="bi bi-trash"></i>
                <% end %>
              <% end %>
              </div>
            </div>
          <% end %>
          <% if @topics.empty? %>
            <div class="profile-empty">
              <div class="profile-empty-icon"><i class="bi bi-chat-square-text"></i></div>
              <div class="profile-empty-text">还没有发布过主题</div>
              <div class="profile-empty-sub">分享你的第一个想法，开启社区之旅</div>
              <a href="<%= new_topic_path %>" class="btn btn-sm btn-primary rounded-pill px-3 mt-2">
                <i class="bi bi-plus-lg me-1"></i>发布主题
              </a>
            </div>
          <% end %>
        </div>
      </div>

      <% end %>

    </div>
  </div>
</div>