<% if SiteSetting.get("cps_ad_enabled") == "true" %>
  <% ad = CpsAd.rotate(session) %>
  <% if ad&.title.present? && ad&.link_url.present? %>
    <div class="sidebar-card cps-ad-card mb-3">
      <a href="<%= ad_click_path(ad.id) %>" target="_blank" rel="noopener nofollow sponsored" class="text-decoration-none">
        <% if ad.image_url.present? %>
          <div class="cps-ad-image">
            <img src="<%= ad.image_url %>" alt="<%= ad.title %>" class="w-100" style="border-radius: var(--bs-card-inner-border-radius) var(--bs-card-inner-border-radius) 0 0; object-fit: cover; max-height: 180px;">
          </div>
        <% end %>
        <div class="card-body p-3">
          <div class="d-flex align-items-start">
            <div class="flex-grow-1">
              <div class="fw-semibold text-dark small mb-1"><%= ad.title %></div>
              <% if ad.description.present? %>
                <div class="text-muted" style="font-size: 0.78rem; line-height: 1.4;"><%= ad.description %></div>
              <% end %>
            </div>
            <span class="badge bg-light text-muted rounded-pill flex-shrink-0 ms-2" style="font-size:0.6rem">广告</span>
          </div>
        </div>
      </a>
    </div>
  <% end %>
<% end %>
