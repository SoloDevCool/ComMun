<% content_for :title, "能量商城 - #{site_name}" %>
<% content_for :head do %>
  <%= seo_meta_tags(title: "能量商城 - #{site_name}", description: "#{site_name}能量商城提供各类社区道具与特权服务，使用能量兑换精美装扮和专属功能，彰显你的独特个性。") %>
<% end %>

<div class="container-lg py-4">
  <div class="row g-4">
    <div class="col-lg-8">
      <h4 class="mb-4 fw-bold"><i class="bi bi-shop me-2 text-primary"></i>能量商城</h4>

      <% if @shop_items.empty? %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-shop-window" style="font-size:3rem"></i>
          <p class="mt-3">商城暂无商品</p>
        </div>
      <% else %>
        <div class="row g-3">
          <% @shop_items.each do |item| %>
            <div class="col-md-6">
              <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-4">
                  <div class="d-flex align-items-start mb-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3" style="width:48px;height:48px;font-size:1.3rem;flex-shrink:0">
                      <i class="bi <%= item.icon.presence || 'bi-gift' %>"></i>
                    </div>
                    <div>
                      <h6 class="mb-1 fw-bold"><%= item.name %></h6>
                      <span class="badge bg-light text-secondary"><%= item.item_type_label %></span>
                    </div>
                  </div>
                  <% if item.description.present? %>
                    <p class="text-muted small mb-3"><%= item.description %></p>
                  <% end %>
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <span class="fw-bold text-primary" style="font-size:1.1rem"><%= item.price %></span>
                      <span class="text-muted small"> 酷能量</span>
                    </div>
                    <% if item.stock == -1 %>
                      <span class="text-muted small"><i class="bi bi-infinity me-1"></i>不限量</span>
                    <% elsif item.stock > 0 %>
                      <span class="text-muted small">剩余 <%= item.stock %></span>
                    <% else %>
                      <span class="text-danger small">已售罄</span>
                    <% end %>
                  </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0 px-4 pb-4">
                  <% if current_user.points >= item.price %>
                    <% if item.item_type == "license" %>
                      <%= form_with url: "/shop/purchase", method: :post, local: true, class: "purchase-form" do |f| %>
                        <input type="hidden" name="id" value="<%= item.id %>">
                        <div class="input-group input-group-sm mb-2">
                          <span class="input-group-text"><i class="bi bi-globe"></i></span>
                          <input type="text" name="domain" class="form-control" placeholder="请输入您的域名（如 example.com）" required>
                        </div>
                        <button type="submit" class="btn btn-primary rounded-pill w-100 btn-sm"
                          onclick="return confirm('确认使用 <%= item.price %> 酷能量兑换「<%= item.name %>」？')">
                          <i class="bi bi-lightning me-1"></i>立即兑换
                        </button>
                      <% end %>
                    <% else %>
                      <%= button_to "/shop/purchase", method: :post, params: { id: item.id }, form: { data: { turbo: false } },
                          class: "btn btn-primary rounded-pill w-100 btn-sm",
                          onclick: "return confirm('确认使用 #{item.price} 酷能量兑换「#{item.name}」？')" do %>
                        <i class="bi bi-lightning me-1"></i>立即兑换
                      <% end %>
                    <% end %>
                  <% else %>
                    <button class="btn btn-outline-secondary rounded-pill w-100 btn-sm" disabled>
                      酷能量不足（需要 <%= item.price %>，余额 <%= current_user.points %>）
                    </button>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- 购买记录 -->
      <% if @purchases.any? %>
        <h5 class="mt-5 mb-3 fw-bold"><i class="bi bi-clock-history me-2"></i>兑换记录</h5>
        <div class="card border-0 shadow-sm rounded-3">
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
              <thead class="bg-light">
                <tr>
                  <th>商品</th>
                  <th>消耗</th>
                  <th>状态</th>
                  <th>详情</th>
                  <th>时间</th>
                </tr>
              </thead>
              <tbody>
                <% @purchases.each do |p| %>
                  <tr>
                    <td><%= p.shop_item.name %></td>
                    <td><span class="text-primary fw-bold"><%= p.points_cost %></span> 酷能量</td>
                    <td><span class="badge <%= p.completed? ? 'bg-success' : 'bg-danger' %>"><%= p.status_label %></span></td>
                    <td class="small">
                      <% if p.completed? && p.delivered_data&.dig("license_key").present? %>
                        <span class="text-muted">域名: </span><span class="fw-bold"><%= p.delivered_data["domain"] %></span><br>
                        <span class="text-muted">Key: </span><code class="user-select-all"><%= p.delivered_data["license_key"] %></code>
                      <% elsif p.completed? && p.delivered_data&.dig("note").present? %>
                        <span class="text-muted small"><%= p.delivered_data["note"] %></span>
                      <% elsif p.delivered_data&.dig("error").present? %>
                        <span class="text-danger"><%= p.delivered_data["error"] %></span>
                      <% end %>
                    </td>
                    <td class="text-muted small"><%= p.created_at.strftime('%Y-%m-%d %H:%M') %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>

    <!-- 右栏 - 余额信息 -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
          <div class="text-center py-2 px-3 bg-light rounded-3 mb-3">
            <div class="fs-4 fw-bold text-dark"><%= current_user.points %></div>
            <div class="text-muted small">酷能量余额</div>
          </div>
          <div class="text-muted small text-center">
            每日签到可获得 <strong>10</strong> 酷能量<br>
            发布优质内容被点赞也可获得酷能量
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
