<h4 class="text-dark fw-bold mb-4"><%= t('admin.ui.m709') %></h4>

<div class="d-flex gap-2 mb-3">
  <%= link_to admin_course_course_reviews_path(@course), class: "btn btn-outline-info rounded-pill px-3" do %>
    <i class="bi bi-chat-square-text me-1"></i><%= t('admin.ui.m710') %>
  <% end %>
</div>

<div class="row g-4">
  <!-- 左侧：课程信息 -->
  <div class="col-lg-4">
    <div class="card card-admin position-lg-sticky" style="top:1rem">
      <div class="card-body p-4">
        <%= form_with model: [:admin, @course], local: true do |f| %>
          <% if @course.errors.any? %>
        <div class="alert alert-danger rounded-3 py-2">
          <i class="bi bi-exclamation-circle me-1"></i>
          <ul class="mb-0 ms-3">
            <% @course.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :title, t('admin.ui.m233'), class: "form-label fw-semibold small text-muted" %>
        <%= f.text_field :title, class: "form-control form-control-lg rounded-3", placeholder: t('admin.ui.m235') %>
      </div>

      <div class="mb-3">
        <%= f.label :description, t('admin.ui.m236'), class: "form-label fw-semibold small text-muted" %>
        <%= f.text_area :description, class: "form-control rounded-3", rows: 3, placeholder: t('admin.ui.m237') %>
        <div class="form-text"><%= t('admin.ui.m238') %></div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <%= f.label :direction, t("admin.direction"), class: "form-label fw-semibold small text-muted" %>
          <%= f.select :direction, CourseDirection.active.ordered.map { |d| [d.name, d.name] }, { prompt: t('admin.ui.m241') }, class: "form-select form-select-lg rounded-3" %>
        </div>
        <div class="col-md-6">
          <%= f.label :difficulty, t("admin.difficulty"), class: "form-label fw-semibold small text-muted" %>
          <%= f.select :difficulty, Course::DIFFICULTIES.map { |k, v| [v, k] }, {}, class: "form-select form-select-lg rounded-3" %>
        </div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-4">
          <%= f.label :lessons_count, t('admin.ui.m242'), class: "form-label fw-semibold small text-muted" %>
          <%= f.number_field :lessons_count, class: "form-control form-control-lg rounded-3", min: 0 %>
        </div>
        <div class="col-md-4">
          <%= f.label :duration, t('admin.ui.m243'), class: "form-label fw-semibold small text-muted" %>
          <%= f.text_field :duration, class: "form-control form-control-lg rounded-3" %>
        </div>
        <div class="col-md-4">
          <%= f.label :students_count, t('admin.ui.m244'), class: "form-label fw-semibold small text-muted" %>
          <%= f.number_field :students_count, class: "form-control form-control-lg rounded-3", min: 0 %>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :instructor_id, t("admin.instructor"), class: "form-label fw-semibold small text-muted" %>
        <%= f.collection_select :instructor_id, Instructor.ordered, :id, :name, { prompt: t('admin.ui.m245') }, class: "form-select form-select-lg rounded-3" %>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <%= f.label :color, t("admin.theme_color"), class: "form-label fw-semibold small text-muted" %>
          <div class="d-flex gap-2 align-items-center">
            <%= f.text_field :color, class: "form-control form-control-lg rounded-3", style: "max-width:160px" %>
            <div id="colorPreview" class="rounded-2 border flex-shrink-0" style="width:44px;height:44px;background-color:<%= @course.color || '#6366f1' %>"></div>
          </div>
        </div>
        <div class="col-md-6">
          <%= f.label :icon, t("admin.icon"), class: "form-label fw-semibold small text-muted" %>
          <div class="input-group">
            <span class="input-group-text"><i id="iconPreview" class="bi <%= @course.icon || 'bi-book' %>"></i></span>
            <%= f.text_field :icon, class: "form-control form-control-lg rounded-3" %>
          </div>
          <div class="form-text">Bootstrap Icons <%= t('admin.ui.m711') %></div>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :cover, t('admin.ui.m247'), class: "form-label fw-semibold small text-muted" %>
        <% if @course.cover.attached? %>
          <div class="d-flex align-items-center gap-3 mb-2">
            <div class="rounded-2 overflow-hidden" style="width:100px;height:50px">
              <img src="<%= url_for(@course.cover.variant(resize_to_fill: [400, 200])) %>" class="w-100 h-100" style="object-fit:cover" alt="">
            </div>
            <label class="form-check">
              <input type="checkbox" name="course[remove_cover]" value="1" class="form-check-input">
              <span class="form-check-label" style="font-size:0.85rem"><%= t('admin.ui.m712') %></span>
            </label>
          </div>
        <% end %>
        <%= f.file_field :cover, class: "form-control form-control-lg rounded-3", accept: "image/*" %>
        <div class="form-text"><%= t('admin.ui.m252') %></div>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <%= f.label :sort_order, t("admin.sort_order"), class: "form-label fw-semibold small text-muted" %>
          <%= f.number_field :sort_order, class: "form-control form-control-lg rounded-3", min: 0 %>
          <div class="form-text"><%= t('admin.lower_is_first') %></div>
        </div>
        <div class="col-md-6">
          <%= f.label :is_active, t("admin.status"), class: "form-label fw-semibold small text-muted" %>
          <div class="form-check form-switch mt-2">
            <%= f.check_box :is_active, class: "form-check-input", style: "width:2.5em;height:1.5em" %>
            <label class="form-check-label" for="course_is_active"><%= t('admin.show_on_frontend') %></label>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit t("admin.save_changes"), class: "btn btn-primary rounded-pill px-4" %>
        <%= link_to t("admin.cancel"), admin_courses_path, class: "btn btn-outline-secondary rounded-pill px-4" %>
      </div>
    <% end %>
      </div>
    </div>
  </div>

  <!-- 右侧：<%= t('admin.ui.m713') %> -->
  <div class="col-lg-8">
  <div class="card card-admin">
  <div class="card-header d-flex align-items-center justify-content-between" style="background:var(--bs-tertiary-bg)">
    <h5 class="mb-0 fw-bold" style="font-size:0.95rem">
      <i class="bi bi-list-ul me-1"></i><%= t('admin.ui.m713') %>
      <span class="badge bg-secondary bg-opacity-25 text-dark ms-2" style="font-size:0.72rem">
        <%= @course.course_chapters.count %> <%= t('admin.ui.m714') %> <%= @course.course_lessons.count %> <%= t('admin.ui.m254') %>
      </span>
    </h5>
    <button class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="collapse" data-bs-target="#addChapterForm">
      <i class="bi bi-plus-lg me-1"></i><%= t('admin.ui.m051') %>
    </button>
  </div>
  <div class="card-body">
    <!-- <%= t('admin.ui.m051') %>表单 -->
    <div class="collapse mb-3" id="addChapterForm">
      <div class="border rounded-3 p-3" style="background:var(--bs-tertiary-bg)">
        <%= form_with model: [:admin, @course, CourseChapter.new], local: true, class: "row g-2 align-items-end" do |f| %>
          <div class="col">
            <%= f.label :title, t('admin.ui.m715'), class: "form-label small text-muted mb-1" %>
            <%= f.text_field :title, class: "form-control form-control-sm", placeholder: t('admin.ui.m716') %>
          </div>
          <div class="col-auto" style="width:80px">
            <%= f.label :sort_order, t("admin.sort_order"), class: "form-label small text-muted mb-1" %>
            <%= f.number_field :sort_order, class: "form-control form-control-sm", min: 0 %>
          </div>
          <div class="col-auto">
            <%= f.submit t("admin.add"), class: "btn btn-primary btn-sm rounded-pill px-3" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- 章<%= t('admin.ui.m254') %><%= t('admin.ui.m732') %> -->
    <% if @course.course_chapters.ordered.any? %>
      <% @course.course_chapters.ordered.each do |chapter| %>
        <div class="border rounded-3 mb-3 overflow-hidden">
          <!-- 章<%= t('admin.ui.m254') %>头 -->
          <div class="d-flex align-items-center justify-content-between px-3 py-2" style="background:var(--bs-tertiary-bg)">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-bookmark-fill" style="color:#6366f1;font-size:0.8rem"></i>
              <span class="fw-semibold" style="font-size:0.88rem"><%= chapter.title %></span>
              <span class="badge bg-light text-dark" style="font-size:0.68rem"><%= chapter.course_lessons.count %> <%= t('admin.ui.m254') %></span>
            </div>
            <div class="d-flex align-items-center gap-1">
              <button class="btn btn-sm btn-outline-secondary py-0 px-1" data-bs-toggle="collapse" data-bs-target="#addLesson-<%= chapter.id %>">
                <i class="bi bi-plus-lg"></i>
              </button>
              <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" title="<%= t('admin.ui.m717') %>"
                      onclick="confirmDeleteChapter(this, '<%= j chapter.title %>', <%= chapter.course_lessons.where(lesson_type: 'video').where.not(video_url: [nil, '']).count %>)">
                <i class="bi bi-trash"></i>
              </button>
              <%= form_with url: [:admin, @course, chapter], method: :delete, local: true, class: "d-none", id: "deleteChapterForm-#{chapter.id}" do %><% end %>
            </div>
          </div>

          <!-- <%= t('admin.ui.m025') %><%= t('admin.ui.m607') %>表单 -->
          <div class="collapse px-3 py-2 border-bottom" id="addLesson-<%= chapter.id %>" style="background:var(--bs-tertiary-bg)">
            <%= form_with model: [:admin, @course, chapter, CourseLesson.new], local: true, id: "newLessonForm-#{chapter.id}" do |f| %>
              <div class="row g-2 align-items-end mb-2">
                <div class="col">
                  <%= f.text_field :title, class: "form-control form-control-sm", placeholder: t('admin.ui.m718'), required: true %>
                </div>
                <div class="col-auto" style="width:100px">
                  <%= f.select :lesson_type, CourseLesson::LESSON_TYPES.invert, {}, class: "form-select form-select-sm", onchange: "toggleNewLessonType('#{chapter.id}', this.value)" %>
                </div>
                <div class="col-auto" style="width:80px">
                  <%= f.text_field :duration, class: "form-control form-control-sm", placeholder: t('admin.ui.m719') %>
                </div>
                <div class="col-auto">
                  <div class="form-check form-switch mt-1">
                    <%= f.check_box :is_free, class: "form-check-input" %>
                    <label class="form-check-label" style="font-size:0.78rem;white-space:nowrap"><%= t('admin.ui.m055') %></label>
                  </div>
                </div>
                <div class="col-auto" style="width:60px">
                  <%= f.number_field :sort_order, class: "form-control form-control-sm", min: 0, value: chapter.course_lessons.count %>
                </div>
                <div class="col-auto">
                  <%= f.submit t("admin.add"), class: "btn btn-primary btn-sm rounded-pill px-3" %>
                </div>
              </div>
              <div id="newLessonContent-<%= chapter.id %>" style="display:none">
                <div class="d-flex align-items-center gap-1 p-1 mb-1">
                  <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.bold') %>" onclick="lessonInsertMd(this.form,'**','**')"><i class="bi bi-type-bold"></i></button>
                  <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.italic') %>" onclick="lessonInsertMd(this.form,'*','*')"><i class="bi bi-type-italic"></i></button>
                  <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.ui.m056') %>" onclick="lessonInsertMd(this.form,'`','`')"><i class="bi bi-code-slash"></i></button>
                  <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.code_block') %>" onclick="lessonInsertMd(this.form,'\n```\n','\n```\n')"><i class="bi bi-file-code"></i></button>
                  <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.url') %>" onclick="lessonInsertMd(this.form,'[','](url)')"><i class="bi bi-link-45deg"></i></button>
                  <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.quote') %>" onclick="lessonInsertMd(this.form,'> ','')"><i class="bi bi-quote"></i></button>
                  <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.unordered_list') %>" onclick="lessonInsertMd(this.form,'\n- ','')"><i class="bi bi-list-ul"></i></button>
                  <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.ordered_list') %>" onclick="lessonInsertMd(this.form,'\n1. ','')"><i class="bi bi-list-ol"></i></button>
                  <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.image') %>" onclick="this.form.querySelector('input[type=file]').click()"><i class="bi bi-image"></i></button>
                  <input type="file" accept="image/*" class="d-none" onchange="lessonUploadImage(this)">
                  <span class="ms-auto text-muted small" style="font-size:0.7rem"><i class="bi bi-markdown me-1"></i>Markdown</span>
                </div>
                <%= f.text_area :content, class: "form-control form-control-sm", rows: 10, placeholder: t('admin.ui.m057'), style: "font-family:'JetBrains Mono','Fira Code','Consolas',monospace;font-size:0.82rem;line-height:1.7;resize:vertical" %>
              </div>
            <% end %>
          </div>

          <!-- <%= t('admin.ui.m607') %><%= t('admin.ui.m732') %> -->
          <% if chapter.course_lessons.ordered.any? %>
            <% chapter.course_lessons.ordered.each do |lesson| %>
              <div class="px-3 py-2 border-bottom" style="font-size:0.82rem">
                <div class="d-flex align-items-center gap-2">
                  <% icon_cls = lesson.lesson_type == 'video' ? 'bi-play-circle' : lesson.lesson_type == 'text' ? 'bi-file-text' : 'bi-patch-question' %>
                  <i class="bi <%= icon_cls %>" style="color:var(--text-muted);font-size:0.85rem"></i>
                  <span class="flex-grow-1"><%= lesson.title %></span>
                  <span class="badge bg-light text-dark" style="font-size:0.62rem"><%= lesson.lesson_type_label %></span>
                  <% if lesson.lesson_type == 'video' %>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-1" data-bs-toggle="collapse" data-bs-target="#editVideo-<%= lesson.id %>" title="<%= t('admin.ui.m720') %>">
                      <i class="bi bi-film"></i>
                    </button>
                  <% elsif lesson.lesson_type == 'text' %>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-1" data-bs-toggle="collapse" data-bs-target="#editContent-<%= lesson.id %>" title="<%= t('admin.ui.m721') %>">
                      <i class="bi bi-pencil-square"></i>
                    </button>
                  <% end %>
                  <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" title="<%= t('admin.ui.m722') %>"
                          onclick="confirmDeleteLesson(this, '<%= j lesson.title %>', <%= lesson.video_url.present? ? 'true' : 'false' %>)">
                    <i class="bi bi-x-lg" style="font-size:0.7rem"></i>
                  </button>
                  <%= form_with url: [:admin, @course, chapter, lesson], method: :delete, local: true, class: "d-none", id: "deleteLessonForm-#{lesson.id}" do %><% end %>
                </div>
                <% if lesson.video_url.present? %>
                  <div class="mt-1" style="padding-left:1.5rem">
                    <span class="text-muted" style="font-size:0.72rem">
                      <i class="bi bi-film me-1"></i>FileID: <%= lesson.video_url %>
                    </span>
                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1 ms-2" style="font-size:0.65rem" onclick="deleteVodMedia(<%= lesson.id %>, '<%= lesson.video_url %>', this)" title="<%= t('admin.ui.m723') %>">
                      <i class="bi bi-trash me-1"></i><%= t('admin.ui.m060') %>
                    </button>
                  </div>
                <% end %>
                <% if lesson.content.present? && lesson.lesson_type == 'text' %>
                  <div class="mt-1" style="padding-left:1.5rem">
                    <span class="text-muted" style="font-size:0.72rem">
                      <i class="bi bi-file-text me-1"></i><%= truncate(lesson.content, length: 50) %>
                    </span>
                  </div>
                <% end %>
                <% if lesson.is_free? %>
                  <span class="badge bg-success bg-opacity-10 text-success" style="font-size:0.65rem"><%= t('admin.ui.m055') %></span>
                <% end %>
                <% if lesson.duration.present? %>
                  <span style="color:var(--text-faint);font-size:0.78rem"><%= lesson.duration %></span>
                <% end %>
              </div>
              <!-- 视频<%= t('admin.ui.m008') %>面板 -->
              <% if lesson.lesson_type == 'video' %>
              <div class="collapse px-3 py-2 border-bottom" id="editVideo-<%= lesson.id %>" style="background:var(--bs-tertiary-bg)">
                  <%= form_with model: [:admin, @course, chapter, lesson], local: true, class: "row g-2 align-items-end" do |f| %>
                    <%= f.hidden_field :lesson_type %>
                    
                    <!-- <%= t('admin.ui.m724') %>选择 -->
                    <div class="col-12 mb-2">
                      <label class="form-label small text-muted mb-1"><%= t('admin.ui.m724') %></label>
                      <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="course_lesson[video_storage]" id="video_storage_vod_<%= lesson.id %>" value="vod" <%= lesson.video_storage == 'vod' ? 'checked' : '' %> onchange="toggleVideoStorage(<%= lesson.id %>, 'vod')">
                        <label class="btn btn-outline-primary btn-sm" for="video_storage_vod_<%= lesson.id %>">
                          <i class="bi bi-cloud me-1"></i><%= t('admin.ui.m725') %>
                        </label>
                        
                        <input type="radio" class="btn-check" name="course_lesson[video_storage]" id="video_storage_local_<%= lesson.id %>" value="local" <%= lesson.video_storage == 'local' ? 'checked' : '' %> onchange="toggleVideoStorage(<%= lesson.id %>, 'local')">
                        <label class="btn btn-outline-success btn-sm" for="video_storage_local_<%= lesson.id %>">
                          <i class="bi bi-hdd me-1"></i><%= t('admin.ui.m674') %>
                        </label>
                      </div>
                    </div>

                    <!-- <%= t('admin.ui.m725') %>配置 -->
                    <div id="vod_config_<%= lesson.id %>" style="<%= lesson.video_storage == 'vod' ? '' : 'display:none' %>">
                      <div class="col-12">
                        <%= f.text_field :video_url, class: "form-control form-control-sm", placeholder: t('admin.ui.m675'), readonly: true, id: "video_url_#{lesson.id}" %>
                        <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
                          <button type="button" class="btn btn-outline-primary btn-sm py-0" onclick="selectVodFile(<%= lesson.id %>)">
                            <i class="bi bi-cloud-upload me-1"></i><%= t('admin.ui.m676') %>
                          </button>
                          <span id="vodStatus-<%= lesson.id %>" class="text-muted small" style="font-size:0.72rem;display:none">
                            <i class="bi bi-arrow-repeat spin me-1"></i><span></span>
                          </span>
                          <span id="vodResult-<%= lesson.id %>" class="text-muted small" style="font-size:0.72rem"></span>
                        </div>
                        <input type="file" id="vodFileInput-<%= lesson.id %>" accept="video/*" style="display:none" onchange="uploadVodVideo(<%= lesson.id %>, this)">
                      </div>
                    </div>

                    <!-- 本地视频配置 -->
                    <div id="local_config_<%= lesson.id %>" style="<%= lesson.video_storage == 'local' ? '' : 'display:none' %>">
                      <div class="col-12">
                        <% if lesson.video.attached? %>
                          <div class="alert alert-info py-2 px-3 mb-2" style="font-size:0.82rem">
                            <i class="bi bi-check-circle me-1"></i>
                            <%= t('admin.ui.m677') %> <%= lesson.video.filename %> (<%= number_to_human_size(lesson.video.byte_size) %>)
                            <label class="form-check-label ms-3" style="font-size:0.78rem">
                              <input type="checkbox" name="course_lesson[remove_video]" value="1" class="form-check-input"> <%= t('admin.ui.m060') %>
                            </label>
                          </div>
                        <% end %>
                        <%= f.file_field :video, class: "form-control form-control-sm", accept: "video/*", id: "localVideoInput-#{lesson.id}" %>
                        <div class="form-text" style="font-size:0.72rem">
                          <%= t('admin.ui.m678') %>
                        </div>
                      </div>
                    </div>

                    <div class="col-auto mt-2">
                      <%= f.submit t("admin.save"), class: "btn btn-primary btn-sm rounded-pill px-3" %>
                    </div>
                  <% end %>
                </div>
              <% end %>
              <!-- 图文<%= t('admin.ui.m008') %>面板 -->
              <% if lesson.lesson_type == 'text' %>
              <div class="collapse px-3 py-2 border-bottom" id="editContent-<%= lesson.id %>" style="background:var(--bs-tertiary-bg)">
                  <%= form_with model: [:admin, @course, chapter, lesson], local: true, id: "editLessonForm-#{lesson.id}" do |f| %>
                    <%= f.hidden_field :lesson_type %>
                    <div class="d-flex align-items-center gap-1 p-1 mb-2">
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.bold') %>" onclick="lessonInsertMd(this.form,'**','**')"><i class="bi bi-type-bold"></i></button>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.italic') %>" onclick="lessonInsertMd(this.form,'*','*')"><i class="bi bi-type-italic"></i></button>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.strikethrough') %>" onclick="lessonInsertMd(this.form,'~~','~~')"><i class="bi bi-type-strikethrough"></i></button>
                      <div class="vr mx-1"></div>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.inline_code') %>" onclick="lessonInsertMd(this.form,'`','`')"><i class="bi bi-code-slash"></i></button>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.code_block') %>" onclick="lessonInsertMd(this.form,'\n```\n','\n```\n')"><i class="bi bi-file-code"></i></button>
                      <div class="vr mx-1"></div>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.url') %>" onclick="lessonInsertMd(this.form,'[','](url)')"><i class="bi bi-link-45deg"></i></button>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.image') %>" onclick="this.form.querySelector('input[type=file]').click()"><i class="bi bi-image"></i></button>
                      <input type="file" accept="image/*" class="d-none" onchange="lessonUploadImage(this)">
                      <div class="vr mx-1"></div>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.quote') %>" onclick="lessonInsertMd(this.form,'> ','')"><i class="bi bi-quote"></i></button>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.unordered_list') %>" onclick="lessonInsertMd(this.form,'\n- ','')"><i class="bi bi-list-ul"></i></button>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.ordered_list') %>" onclick="lessonInsertMd(this.form,'\n1. ','')"><i class="bi bi-list-ol"></i></button>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.divider') %>" onclick="lessonInsertMd(this.form,'\n\n---\n\n','')"><i class="bi bi-dash-lg"></i></button>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="<%= t('admin.table') %>" onclick="lessonInsertMd(this.form,'\n| <%= t('admin.ui.m026') %>\n| --- | --- | --- |\n| ',' |  |  |\n')"><i class="bi bi-table"></i></button>
                      <div class="vr mx-1"></div>
                      <button type="button" class="btn btn-sm btn-outline-primary py-0 px-1" onclick="lessonTogglePreview(this)"><i class="bi bi-eye me-1"></i><%= t('admin.preview') %></button>
                      <span class="ms-auto text-muted small" style="font-size:0.7rem"><i class="bi bi-markdown me-1"></i>Markdown</span>
                    </div>
                    <div class="js-lesson-editor-panel border rounded-top">
                      <%= f.text_area :content, class: "form-control border-0 rounded-0 js-lesson-textarea", rows: 15, placeholder: t('admin.ui.m057'), style: "font-family:'JetBrains Mono','Fira Code','Consolas',monospace;font-size:0.82rem;line-height:1.7;resize:vertical" %>
                    </div>
                    <div class="js-lesson-preview-panel markdown-body border border-top-0 rounded-bottom p-3 overflow-auto" style="display:none;min-height:300px;max-height:500px"></div>
                    <div class="mt-2">
                      <%= f.submit t("admin.save"), class: "btn btn-primary btn-sm rounded-pill px-3" %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <div class="text-center py-3" style="color:var(--text-faint);font-size:0.82rem">
              <%= t('admin.ui.m679') %> <i class="bi bi-plus-lg"></i> <%= t('admin.ui.m025') %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-4" style="color:var(--text-faint)">
        <i class="bi bi-journal-text d-block mb-1" style="font-size:1.5rem"></i>
        <span style="font-size:0.85rem"><%= t('admin.ui.m680') %>"<%= t('admin.ui.m051') %>"<%= t('admin.ui.m681') %></span>
