    <% end %>
    </div>
  </div>
  </div>
</div>

<script src="https://cdn-go.cn/cdn/vod-js-sdk-v6/latest/vod-js-sdk-v6.js" charset="utf-8"></script>

<!-- 删除确认 Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-danger">
      <div class="modal-header border-danger bg-danger bg-opacity-10">
        <h6 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle text-danger me-2"></i><span id="deleteModalTitle"><%= t('admin.confirm_delete') %></span></h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="deleteModalBody" class="mb-3" style="font-size:0.9rem"></div>
        <div class="mb-0">
          <label class="form-label text-muted small mb-1"><%= t('admin.ui.m682') %> <strong class="text-danger"><%= t('admin.confirm_delete') %></strong> <%= t('admin.ui.m683') %></label>
          <input type="text" id="deleteConfirmInput" class="form-control form-control-sm" autocomplete="off" placeholder="<%= t('admin.confirm_delete') %>">
        </div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" data-bs-dismiss="modal"><%= t('admin.cancel') %></button>
        <button type="button" id="deleteConfirmBtn" class="btn btn-danger btn-sm rounded-pill" disabled><%= t('admin.confirm_delete') %></button>
      </div>
    </div>
    </div>
  </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var colorInput = document.querySelector('#course_color');
  var colorPreview = document.getElementById('colorPreview');
  var iconInput = document.querySelector('#course_icon');
  var iconPreview = document.getElementById('iconPreview');

  if (colorInput) {
    colorInput.addEventListener('input', function() {
      colorPreview.style.backgroundColor = this.value || '#6366f1';
    });
  }
  if (iconInput) {
    iconInput.addEventListener('input', function() {
      var val = this.value.trim();
      iconPreview.className = val ? 'bi ' + val : 'bi bi-book';
    });
  }

  var confirmInput = document.getElementById('deleteConfirmInput');
  var confirmBtn = document.getElementById('deleteConfirmBtn');
  if (confirmInput) {
    confirmInput.addEventListener('input', function() {
      confirmBtn.disabled = (this.value.trim() !== "<%= t('admin.confirm_delete') %>");
    });
  }
});

// 切换<%= t('admin.ui.m724') %>
function toggleVideoStorage(lessonId, storageType) {
  var vodConfig = document.getElementById('vod_config_' + lessonId);
  var localConfig = document.getElementById('local_config_' + lessonId);
  
  if (storageType === 'vod') {
    vodConfig.style.display = '';
    localConfig.style.display = 'none';
  } else {
    vodConfig.style.display = 'none';
    localConfig.style.display = '';
  }
}

var _pendingDeleteFormId = null;

function confirmDeleteLesson(btn, title, hasVideo) {
  var body = '<%= t('admin.ui.m684') %>' + title + '」<%= t('admin.ui.m685') %>';
  if (hasVideo) {
    body += '<div class="alert alert-danger py-2 px-3 mt-2 mb-0 rounded-2"><i class="bi bi-film me-1"></i><%= t('admin.ui.m686') %><strong><%= t('admin.ui.m687') %></strong>，<%= t('admin.ui.m069') %></div>';
  }
  _pendingDeleteFormId = btn.parentElement.querySelector('form[id^="deleteLessonForm"]').id;
  showDeleteModal('<%= t('admin.ui.m688') %>', body);
}

function confirmDeleteChapter(btn, title, videoCount) {
  var body = '<%= t('admin.ui.m689') %>' + title + '」<%= t('admin.ui.m690') %>';
  if (videoCount > 0) {
    body += '<div class="alert alert-danger py-2 px-3 mt-2 mb-0 rounded-2"><i class="bi bi-film me-1"></i><%= t('admin.ui.m691') %> <strong>' + videoCount + '</strong> <%= t('admin.ui.m692') %><strong><%= t('admin.ui.m693') %></strong>，<%= t('admin.ui.m069') %></div>';
  }
  _pendingDeleteFormId = btn.parentElement.querySelector('form[id^="deleteChapterForm"]').id;
  showDeleteModal('<%= t('admin.ui.m694') %>', body);
}

function showDeleteModal(title, bodyHtml) {
  document.getElementById('deleteModalTitle').textContent = title;
  document.getElementById('deleteModalBody').innerHTML = bodyHtml;
  document.getElementById('deleteConfirmInput').value = '';
  document.getElementById('deleteConfirmBtn').disabled = true;
  var modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
  modal.show();
  document.getElementById('deleteConfirmBtn').onclick = function() {
    modal.hide();
    if (_pendingDeleteFormId) {
      document.getElementById(_pendingDeleteFormId).submit();
      _pendingDeleteFormId = null;
    }
  };
}

function selectVodFile(lessonId) {
  document.getElementById('vodFileInput-' + lessonId).click();
}

function uploadVodVideo(lessonId, input) {
  if (!input.files || !input.files[0]) return;
  var file = input.files[0];
  if (file.size > 10 * 1024 * 1024 * 1024) {
    alert('<%= t('admin.ui.m695') %>');
    input.value = '';
    return;
  }

  var statusEl = document.getElementById('vodStatus-' + lessonId);
  var resultEl = document.getElementById('vodResult-' + lessonId);
  var urlInput = document.getElementById('video_url_' + lessonId);

  statusEl.style.display = 'inline';
  statusEl.querySelector('span').textContent = '<%= t('admin.ui.m696') %>';
  resultEl.textContent = '';

  // 先请求签名，确认点播已配置
  fetch('/api/vod/upload_signature')
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (!data.signature) {
        statusEl.style.display = 'none';
        alert('<%= t('admin.ui.m697') %> > <%= t('admin.ui.m698') %>');
        return;
      }

      // 配置<%= t('admin.ui.m417') %>，<%= t('admin.ui.m681') %>上传
      statusEl.querySelector('span').textContent = '<%= t('admin.ui.m699') %>';

      try {
        var tcVod = new TcVod.default({
          getSignature: function() {
            return fetch('/api/vod/upload_signature')
              .then(function(res) { return res.json(); })
              .then(function(d) {
                if (d.signature) return d.signature;
                throw new Error(d.error || '<%= t('admin.ui.m566') %>');
              });
          }
        });

        var uploader = tcVod.upload({ mediaFile: file });

        uploader.on('media_progress', function(info) {
          statusEl.querySelector('span').textContent = '<%= t('admin.ui.m593') %> ' + Math.round(info.percent * 100) + '%...';
        });

        uploader.done().then(function(doneResult) {
          statusEl.style.display = 'none';
          urlInput.value = doneResult.fileId;
          resultEl.innerHTML = '<i class="bi bi-check-circle text-success me-1"></i><%= t('admin.ui.m594') %>';
          urlInput.closest('form').querySelector('input[type="submit"]').click();
        }).catch(function(err) {
          statusEl.style.display = 'none';
          resultEl.innerHTML = '<i class="bi bi-exclamation-triangle text-danger me-1"></i><%= t('admin.ui.m075') %> ' + (err.message || "<%= t('admin.unknown_error') %>");
        });
      } catch (e) {
        statusEl.style.display = 'none';
        alert('<%= t('admin.ui.m595') %> ' + e.message + '。<%= t('admin.ui.m596') %>');
      }
    })
    .catch(function() {
      statusEl.style.display = 'none';
      alert('<%= t('admin.ui.m597') %>');
    });

  input.value = '';
}

function deleteVodMedia(lessonId, fileId, btn) {
  if (!confirm('<%= t('admin.ui.m598') %>\n\nFileID: ' + fileId + '\n\n<%= t('admin.ui.m599') %>')) return;

  var originalHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-arrow-repeat spin me-1"></i><%= t('admin.ui.m600') %>';

  fetch('/api/vod/delete_media', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content },
    body: JSON.stringify({ file_id: fileId })
  })
  .then(function(res) { return res.json(); })
  .then(function(data) {
    if (data.success) {
      // 清空 video_url 并提交表单
      var urlInput = document.getElementById('video_url_' + lessonId);
      if (urlInput) {
        urlInput.value = '';
        urlInput.closest('form').querySelector('input[type="submit"]').click();
      } else {
        btn.closest('.d-flex').querySelector('.flex-grow-1').insertAdjacentHTML('afterend',
          '<span class="text-success ms-1" style="font-size:0.72rem"><i class="bi bi-check-circle me-1"></i><%= t('admin.ui.m601') %></span>');
        btn.remove();
      }
    } else {
      alert('<%= t('admin.ui.m602') %> ' + (data.error || "<%= t('admin.unknown_error') %>"));
      btn.disabled = false;
      btn.innerHTML = originalHtml;
    }
  })
  .catch(function(err) {
    alert('<%= t('admin.ui.m603') %> ' + err.message);
    btn.disabled = false;
    btn.innerHTML = originalHtml;
  });
}

// === <%= t('admin.ui.m607') %>图文<%= t('admin.ui.m008') %>器 ===

function toggleNewLessonType(chapterId, type) {
  var el = document.getElementById('newLessonContent-' + chapterId);
  if (el) el.style.display = (type === 'text') ? 'block' : 'none';
}

function lessonGetTextarea(form) {
  return form ? form.querySelector('textarea') : null;
}

function lessonInsertMd(form, before, after) {
  var ta = lessonGetTextarea(form);
  if (!ta) return;
  var s = ta.selectionStart, e = ta.selectionEnd;
  var sel = ta.value.substring(s, e) || '';
  var placeholder = before.match(/\n/) ? '' : "<%= t('admin.text') %>";
  var replacement = before + (sel || placeholder) + after;
  ta.setRangeText(replacement, s, e, 'end');
  if (!sel) ta.selectionEnd = s + before.length + placeholder.length;
  ta.dispatchEvent(new Event('input'));
  ta.focus();
}

function lessonUploadImage(input) {
  var file = input.files && input.files[0];
  if (!file || !file.type.startsWith('image/')) return;
  if (file.size > 5 * 1024 * 1024) { alert("<%= t('admin.image_max_5mb') %>"); input.value = ''; return; }

  var ta = lessonGetTextarea(input.form);
  if (!ta) return;
  var s = ta.selectionStart;
  var placeholder = '![](<%= t('admin.ui.m027') %>';
  ta.setRangeText(placeholder, s, s, 'end');
  ta.dispatchEvent(new Event('input'));

  var formData = new FormData();
  formData.append('file', file);
  var token = document.querySelector('meta[name="csrf-token"]');

  fetch('/upload_image', {
    method: 'POST',
    headers: { 'X-CSRF-Token': token ? token.content : '', 'Accept': 'application/json' },
    body: formData
  })
  .then(function(r) {
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return r.json();
  })
  .then(function(data) {
    if (data.url) {
      ta.value = ta.value.replace(placeholder, '![](' + data.url + ')');
    } else {
      ta.value = ta.value.replace(placeholder, '');
      alert("<%= t('admin.upload_failed_cn') %>" + (data.error || "<%= t('admin.unknown_error') %>"));
    }
    ta.dispatchEvent(new Event('input'));
  })
  .catch(function(err) {
    ta.value = ta.value.replace(placeholder, '');
    ta.dispatchEvent(new Event('input'));
    alert('<%= t('admin.ui.m075') %> ' + err.message);
  });

  input.value = '';
}

function lessonTogglePreview(btn) {
  var form = btn.form;
  var editor = form.querySelector('.js-lesson-editor-panel');
  var preview = form.querySelector('.js-lesson-preview-panel');
  if (!editor || !preview) return;

  if (preview.style.display === 'none') {
    if (typeof marked === 'undefined') { alert('Markdown <%= t('admin.ui.m604') %>'); return; }
    var ta = form.querySelector('.js-lesson-textarea');
    var val = ta ? ta.value : '';
    preview.innerHTML = marked.parse(val);
    editor.style.display = 'none';
    preview.style.display = 'block';
    btn.innerHTML = '<i class="bi bi-pencil me-1"></i><%= t('admin.ui.m008') %>';
    btn.classList.remove('btn-outline-primary');
    btn.classList.add('btn-success');
  } else {
    editor.style.display = 'block';
    preview.style.display = 'none';
    btn.innerHTML = '<i class="bi bi-eye me-1"></i><%= t('admin.ui.m007') %>';
    btn.classList.remove('btn-success');
    btn.classList.add('btn-outline-primary');
    var ta = form.querySelector('.js-lesson-textarea');
    if (ta) ta.focus();
  }
}
</script>
