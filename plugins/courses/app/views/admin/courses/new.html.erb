<h4 class="text-dark fw-bold mb-4"><%= t('admin.new_course') %></h4>

<div class="card card-admin" style="max-width:720px">
  <div class="card-body p-4">
    <%= form_with model: [:admin, @course], local: true do |f| %>
      <% if @course.errors.any? %>
        <div class="alert alert-danger rounded-3 py-2">
          <i class="bi bi-exclamation-circle me-1"></i>
          <ul class="mb-0 ms-3">
            <% @course.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :title, t('admin.ui.m233'), class: "form-label fw-semibold small text-muted" %>
        <%= f.text_field :title, class: "form-control form-control-lg rounded-3", placeholder: t('admin.ui.m235') %>
      </div>

      <div class="mb-3">
        <%= f.label :description, t('admin.ui.m236'), class: "form-label fw-semibold small text-muted" %>
        <%= f.text_area :description, class: "form-control rounded-3", rows: 3, placeholder: t('admin.ui.m237') %>
        <div class="form-text"><%= t('admin.ui.m238') %></div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <%= f.label :direction, t("admin.direction"), class: "form-label fw-semibold small text-muted" %>
          <%= f.select :direction, CourseDirection.active.ordered.map { |d| [d.name, d.name] }, { prompt: t('admin.ui.m241') }, class: "form-select form-select-lg rounded-3" %>
        </div>
        <div class="col-md-6">
          <%= f.label :difficulty, t("admin.difficulty"), class: "form-label fw-semibold small text-muted" %>
          <%= f.select :difficulty, Course::DIFFICULTIES.map { |k, v| [v, k] }, {}, class: "form-select form-select-lg rounded-3" %>
        </div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-4">
          <%= f.label :lessons_count, t('admin.ui.m242'), class: "form-label fw-semibold small text-muted" %>
          <%= f.number_field :lessons_count, class: "form-control form-control-lg rounded-3", placeholder: t('admin.ui.m611'), min: 0 %>
        </div>
        <div class="col-md-4">
          <%= f.label :duration, t('admin.ui.m243'), class: "form-label fw-semibold small text-muted" %>
          <%= f.text_field :duration, class: "form-control form-control-lg rounded-3", placeholder: t('admin.ui.m612') %>
        </div>
        <div class="col-md-4">
          <%= f.label :students_count, t('admin.ui.m244'), class: "form-label fw-semibold small text-muted" %>
          <%= f.number_field :students_count, class: "form-control form-control-lg rounded-3", placeholder: "0", min: 0 %>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :instructor_id, t("admin.instructor"), class: "form-label fw-semibold small text-muted" %>
        <%= f.collection_select :instructor_id, Instructor.ordered, :id, :name, { prompt: t('admin.ui.m245') }, class: "form-select form-select-lg rounded-3" %>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <%= f.label :color, t("admin.theme_color"), class: "form-label fw-semibold small text-muted" %>
          <div class="d-flex gap-2 align-items-center">
            <%= f.text_field :color, class: "form-control form-control-lg rounded-3", placeholder: "#6366f1", style: "max-width:160px" %>
            <div id="colorPreview" class="rounded-2 border flex-shrink-0" style="width:44px;height:44px;background-color:#6366f1"></div>
          </div>
        </div>
        <div class="col-md-6">
          <%= f.label :icon, t("admin.icon"), class: "form-label fw-semibold small text-muted" %>
          <div class="input-group">
            <span class="input-group-text"><i id="iconPreview" class="bi bi-book"></i></span>
            <%= f.text_field :icon, class: "form-control form-control-lg rounded-3", placeholder: "bi-book" %>
          </div>
          <div class="form-text">Bootstrap Icons <%= t('admin.ui.m613') %></div>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :cover, t('admin.ui.m247'), class: "form-label fw-semibold small text-muted" %>
        <%= f.file_field :cover, class: "form-control form-control-lg rounded-3", accept: "image/*" %>
        <div class="form-text"><%= t('admin.ui.m252') %></div>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <%= f.label :sort_order, t("admin.sort_order"), class: "form-label fw-semibold small text-muted" %>
          <%= f.number_field :sort_order, class: "form-control form-control-lg rounded-3", min: 0 %>
          <div class="form-text"><%= t('admin.lower_is_first') %></div>
        </div>
        <div class="col-md-6">
          <%= f.label :is_active, t("admin.status"), class: "form-label fw-semibold small text-muted" %>
          <div class="form-check form-switch mt-2">
            <%= f.check_box :is_active, class: "form-check-input", style: "width:2.5em;height:1.5em" %>
            <label class="form-check-label" for="course_is_active"><%= t('admin.show_on_frontend') %></label>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit t('admin.ui.m614'), class: "btn btn-primary rounded-pill px-4" %>
        <%= link_to t("admin.cancel"), admin_courses_path, class: "btn btn-outline-secondary rounded-pill px-4" %>
      </div>
    <% end %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var colorInput = document.querySelector('#course_color');
  var colorPreview = document.getElementById('colorPreview');
  var iconInput = document.querySelector('#course_icon');
  var iconPreview = document.getElementById('iconPreview');

  if (colorInput) {
    colorInput.addEventListener('input', function() {
      colorPreview.style.backgroundColor = this.value || '#6366f1';
    });
  }
  if (iconInput) {
    iconInput.addEventListener('input', function() {
      var val = this.value.trim();
      iconPreview.className = val ? 'bi ' + val : 'bi bi-book';
    });
  }
});
</script>
